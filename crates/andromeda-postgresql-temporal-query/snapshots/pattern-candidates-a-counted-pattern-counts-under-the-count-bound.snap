---
source: crates/andromeda-postgresql-temporal-query/src/stage1/pattern_candidates.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "entities"."entity_key"
  FROM
    "entities"
  WHERE
    ((("entities"."id") COLLATE "default") ~ $1)
    AND "entities"."evolution_created_at" IS NOT NULL
  LIMIT
    10001
)
SELECT
  COUNT("e"."id")
FROM
  (
    SELECT
      "e".*
    FROM
      (
        SELECT
          "e"."entity_key"
        FROM
          (
            SELECT
              *
            FROM
              (
                SELECT
                  *
                FROM
                  "entities"
                WHERE
                  "entities"."evolution_created_at" IS NOT NULL
              ) AS "e"
            WHERE
              "e"."entity_key" IN (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            ORDER BY
              "id" ASC OFFSET 0
          ) AS "e"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "candidates"
          ) <= $2
        UNION ALL
        (
          SELECT
            "e"."entity_key"
          FROM
            (
              SELECT
                *
              FROM
                "entities"
              WHERE
                "entities"."evolution_created_at" IS NOT NULL
            ) AS "e"
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $3
        )
      ) AS "k"
      JOIN LATERAL (
        SELECT
          *
        FROM
          (
            SELECT
              *
            FROM
              "entities"
            WHERE
              "entities"."evolution_created_at" IS NOT NULL
          ) AS "e"
        WHERE
          "e"."entity_key" = "k"."entity_key" OFFSET 0
      ) AS "e" ON TRUE
  ) AS "e"
WHERE
  ((("e"."id") COLLATE "default") ~ $4)
  AND EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
      ) AS "ah"
    WHERE
      "ah"."observed_at" < $5
      AND "ah"."entity_key" = "e"."entity_key"
  )
1: String '.*:0123.*'
2: BigUnsigned 10000
3: BigUnsigned 10000
4: String '.*:0123.*'
5: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
