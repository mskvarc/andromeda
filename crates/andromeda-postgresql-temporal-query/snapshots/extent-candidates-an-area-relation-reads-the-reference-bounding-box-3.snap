---
source: crates/andromeda-postgresql-temporal-query/src/stage1/extent_candidates.rs
---
WITH
"short_walk" AS MATERIALIZED (
  SELECT
    "e"."id" AS "entity_id"
  FROM
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
        ) AS "e"
      ORDER BY
        "e"."id" ASC
      LIMIT
        50 OFFSET 0
    ) AS "e"
  WHERE
    EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "rs"."entity_key" AS "entity_key",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          WHERE
            "rs"."entity_key" = "e"."entity_key"
        ) AS "qh"
      WHERE
        "qh"."attribute_name_key" = $1
        AND (
          (
            COALESCE(
              "qh"."value_geometry_reach",
              "qh"."value_geometry_valid",
              "qh"."value_geometry"
            )::box2d && ST_MakeValid(ST_GeomFromEWKB($2))::box2d
          )
          AND _ST_Contains(
            COALESCE(
              "qh"."value_geometry_valid",
              "qh"."value_geometry"
            ),
            ST_MakeValid(ST_GeomFromEWKB($3))
          )
        )
        AND "qh"."value_kind" <> (0)
        AND "qh"."observed_at" IS NOT NULL
        AND "qh"."observed_at" < $4
    )
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "re"."id" AS "entity_id",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
            JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        ) AS "ah"
      WHERE
        "ah"."observed_at" < $5
        AND "ah"."entity_id" = "e"."id"
    )
  ORDER BY
    "e"."id" ASC
  LIMIT
    20
),
"candidates" AS MATERIALIZED (
  SELECT
    "rs"."entity_key"
  FROM
    "temporal_attribute_streams" AS "rs"
  WHERE
    "rs"."attribute_name_key" = $6
    AND (
      "rs"."value_extent" && ST_MakeValid(ST_GeomFromEWKB($7))
    )
  LIMIT
    10001
)
SELECT
  *
FROM
  (
    SELECT
      *
    FROM
      "short_walk"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "short_walk"
      ) >= $8
    ORDER BY
      "entity_id" ASC
    LIMIT
      20 OFFSET 0
  ) AS "answered"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
            AND "entity_key" IN (
              SELECT
                "entity_key"
              FROM
                "candidates"
            )
          ORDER BY
            "id" ASC OFFSET 0
        ) AS "e"
      WHERE
        EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "rs"."entity_key" AS "entity_key",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
              WHERE
                "rs"."entity_key" = "e"."entity_key"
            ) AS "qh"
          WHERE
            "qh"."attribute_name_key" = $9
            AND (
              (
                COALESCE(
                  "qh"."value_geometry_reach",
                  "qh"."value_geometry_valid",
                  "qh"."value_geometry"
                )::box2d && ST_MakeValid(ST_GeomFromEWKB($10))::box2d
              )
              AND _ST_Contains(
                COALESCE(
                  "qh"."value_geometry_valid",
                  "qh"."value_geometry"
                ),
                ST_MakeValid(ST_GeomFromEWKB($11))
              )
            )
            AND "qh"."value_kind" <> (0)
            AND "qh"."observed_at" IS NOT NULL
            AND "qh"."observed_at" < $12
        )
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $13
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $14
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."observed_at" < $15
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "indexed"
)
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
        ) AS "e"
      WHERE
        EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "rs"."entity_key" AS "entity_key",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
              WHERE
                "rs"."entity_key" = "e"."entity_key"
            ) AS "qh"
          WHERE
            "qh"."attribute_name_key" = $16
            AND (
              (
                COALESCE(
                  "qh"."value_geometry_reach",
                  "qh"."value_geometry_valid",
                  "qh"."value_geometry"
                )::box2d && ST_MakeValid(ST_GeomFromEWKB($17))::box2d
              )
              AND _ST_Contains(
                COALESCE(
                  "qh"."value_geometry_valid",
                  "qh"."value_geometry"
                ),
                ST_MakeValid(ST_GeomFromEWKB($18))
              )
            )
            AND "qh"."value_kind" <> (0)
            AND "qh"."observed_at" IS NOT NULL
            AND "qh"."observed_at" < $19
        )
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $20
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $21
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."observed_at" < $22
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "walk"
)
