---
source: crates/andromeda-postgresql-temporal-query/src/listed_period_page.rs
---
SELECT
  "page_period"."bucket_start" AS "bucket_start",
  "page_period"."bucket_end" AS "bucket_end",
  "period_aggregate".*,
  ROW_NUMBER() OVER (
    ORDER BY
      "period_aggregate"."group_order_0" ASC,
      "page_period"."bucket_start" ASC
  ) AS "period_order"
FROM
  (
    SELECT
      COUNT(*) AS "agg_total_count",
      width_bucket(
        "ah"."observed_at",
        "stream_edge"."period_starts"
      ) AS "period_position",
      "ah"."unit_code_id" AS "group_order_0"
    FROM
      "rows" AS "ah"
    WHERE
      "ah"."observed_at" IS NOT NULL
    GROUP BY
      "ah"."unit_code_id",
      width_bucket(
        "ah"."observed_at",
        "stream_edge"."period_starts"
      )
  ) AS "period_aggregate"
  JOIN (
    SELECT
      UNNEST("stream_edge"."period_starts") AS "bucket_start",
      UNNEST("stream_edge"."period_ends") AS "bucket_end",
      generate_subscripts("stream_edge"."period_starts", 1) AS "period_position"
  ) AS "page_period" ON "page_period"."period_position" = "period_aggregate"."period_position"
