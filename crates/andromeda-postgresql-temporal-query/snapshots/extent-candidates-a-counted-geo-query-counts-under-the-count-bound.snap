---
source: crates/andromeda-postgresql-temporal-query/src/stage1/extent_candidates.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "rs"."entity_key"
  FROM
    "temporal_attribute_streams" AS "rs"
  WHERE
    "rs"."attribute_name_key" = $1
    AND (
      "rs"."value_extent" && ST_MakeEnvelope($2, $3, $4, $5, $6)
    )
  LIMIT
    10001
)
SELECT
  COUNT("e"."id")
FROM
  (
    SELECT
      "e".*
    FROM
      (
        SELECT
          "e"."entity_key"
        FROM
          (
            SELECT
              "entity_key",
              "id"
            FROM
              "entity_type_members"
            WHERE
              "entity_type_name_key" = (1)
              AND "is_evolution_member"
              AND "entity_key" IN (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            ORDER BY
              "id" ASC OFFSET 0
          ) AS "e"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "candidates"
          ) <= $7
        UNION ALL
        (
          SELECT
            "e"."entity_key"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (1)
                AND "is_evolution_member"
            ) AS "e"
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $8
        )
      ) AS "k"
      JOIN LATERAL (
        SELECT
          *
        FROM
          (
            SELECT
              *
            FROM
              "entities"
            WHERE
              "entities"."evolution_created_at" IS NOT NULL
          ) AS "e"
        WHERE
          "e"."entity_key" = "k"."entity_key" OFFSET 0
      ) AS "e" ON TRUE
  ) AS "e"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
        WHERE
          "rs"."entity_key" = "e"."entity_key"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $9
      AND (
        (
          COALESCE(
            "qh"."value_geometry_reach",
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::box2d && ST_MakeEnvelope($10, $11, $12, $13, $14)::box2d
        )
        AND _ST_DWithin(
          COALESCE(
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($15))::geography,
          $16
        )
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $17
  )
  AND EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
      ) AS "ah"
    WHERE
      "ah"."observed_at" < $18
      AND "ah"."entity_key" = "e"."entity_key"
  )
1: Int 2
2: Double 4.4702749827517545
3: Double 52.48191161045816
4: Double 4.5297250172482455
5: Double 52.51808838954184
6: Int 4326
7: BigUnsigned 10000
8: BigUnsigned 10000
9: Int 2
10: Double 4.4702749827517545
11: Double 52.48191161045816
12: Double 4.5297250172482455
13: Double 52.51808838954184
14: Int 4326
15: Bytes '\x0101000020E610000000000000000012400000000000404A40'
16: Double 2000
17: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
18: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
