                      )
                    )
                    AND "pe"."entity_id" = "e"."id"
                )
              ) AS "qh"
            WHERE
              "qh"."attribute_name_key" = $26
              AND (FALSE)
              AND "qh"."value_kind" <> (0)
              AND "qh"."observed_at" IS NOT NULL
              AND "qh"."observed_at" >= $27
          )
          OR EXISTS (
