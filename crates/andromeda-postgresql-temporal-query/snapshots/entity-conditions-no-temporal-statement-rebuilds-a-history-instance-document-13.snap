                                              AND "pd"."write_id" = "pe"."write_id"
                                              AND "pd"."write_ordinal" = "pe"."write_ordinal"
                                          )
                                        )
                                      )
                                    )
                                    AND "pe"."entity_id" = "qs"."entity_id"
                                    AND "pe"."attribute_name_key" = "qs"."attribute_name_key"
                                    AND "pe"."dataset_key" = "qs"."dataset_key"
                                ) AS "qi"
                              WHERE
                                "qi"."deleted_at" <= $18
                                AND "qi"."observed_at" IS NULL
                              ORDER BY
                                "qi"."deleted_at" DESC
                            )
                            FETCH FIRST
                              1 ROW
                            WITH
                            TIES
                          ) AS "qe"
                      )
                      ORDER BY
                        "placed" DESC
                    )
                    FETCH FIRST
                      1 ROW
                    WITH
                    TIES
                  ) AS "qe"
              ) AS "qh" ON TRUE
            WHERE
              "qs"."attribute_name_key" = $19
              AND "qh"."placed" < $20
              AND "qh"."attribute_name_key" = $21
              AND (FALSE)
              AND "qh"."value_kind" <> (0)
          )
        )
        AND (
          CASE
            WHEN (
              (
                SELECT
                  COUNT(*)
                FROM
                  "short_walk"
              ) >= $22
            ) THEN FALSE
            WHEN (
              (
                SELECT
                  COUNT(*)
                FROM
                  "short_walk"
              ) >= $23
            ) THEN FALSE
            ELSE (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $24
          END
        )
        AND EXISTS (
          SELECT
