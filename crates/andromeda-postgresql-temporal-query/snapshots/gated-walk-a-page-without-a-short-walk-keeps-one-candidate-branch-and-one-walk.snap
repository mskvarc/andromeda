---
source: crates/andromeda-postgresql-temporal-query/src/stage1/gated_walk.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "entities"."entity_key"
  FROM
    "entities"
  WHERE
    ((("entities"."id") COLLATE "default") ~ $1)
    AND "entities"."evolution_created_at" IS NOT NULL
  LIMIT
    1001
)
SELECT
  *
FROM
  (
    SELECT
      "e"."id" AS "entity_id"
    FROM
      (
        SELECT
          *
        FROM
          (
            SELECT
              *
            FROM
              "entities"
            WHERE
              "entities"."evolution_created_at" IS NOT NULL
          ) AS "e"
        WHERE
          "e"."entity_key" IN (
            SELECT
              "entity_key"
            FROM
              "candidates"
          )
        ORDER BY
          "id" ASC OFFSET 0
      ) AS "e"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "candidates"
      ) <= $2
      AND EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "re"."id" AS "entity_id",
              "rs"."attribute_name_key" AS "attribute_name_key",
              "rs"."dataset_key" AS "dataset_key",
              "rh"."recorded_at",
              "rh"."write_id",
              "rh"."write_ordinal",
              "rh"."attribute_kind",
              "rh"."value_kind",
              "rh"."observed_at",
              "rh"."created_at",
              "rh"."modified_at",
              "rh"."deleted_at",
              "rh"."value_date_time",
              "rh"."expires_at",
              "rh"."generated_instance_id",
              "rh"."value_type_key",
              "rh"."value_datatype_key",
              "rh"."unit_code_id",
              "rh"."value_boolean",
              "rh"."verbatim_instance_id",
              "rh"."value_number",
              "rh"."value_string",
              "rh"."value_language",
              "rh"."value_geometry",
              "rh"."value_geometry_valid",
              "rh"."value_geometry_reach",
              "rh"."value_geometry_members",
              "rh"."value_object",
              "rh"."value_uri",
              "rh"."object_type_keys",
              "rh"."sub_attributes"
            FROM
              "attribute_history" AS "rh"
              JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
              JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
          ) AS "ah"
        WHERE
          "ah"."observed_at" < $3
          AND "ah"."entity_id" = "e"."id"
      )
    ORDER BY
      "e"."id" ASC
    LIMIT
      4990 OFFSET 20
  ) AS "indexed"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            *
          FROM
            "entities"
          WHERE
            "entities"."evolution_created_at" IS NOT NULL
        ) AS "e"
      WHERE
        ((("e"."id") COLLATE "default") ~ $4)
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $5
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."observed_at" < $6
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        4990 OFFSET 20
    ) AS "walk"
)
1: String '.*:0123.*'
2: BigUnsigned 1000
3: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
4: String '.*:0123.*'
5: BigUnsigned 1000
6: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
