---
source: crates/andromeda-postgresql-temporal-query/src/stage1/pattern_candidates.rs
---
WITH
"short_walk" AS MATERIALIZED (
  SELECT
    "e"."id" AS "entity_id"
  FROM
    (
      SELECT
        *
      FROM
        (
          SELECT DISTINCT
            ON ("held"."id") "held"."id",
            "held"."entity_key"
          FROM
            (
              SELECT
                "hr"."id",
                "hr"."entity_key"
              FROM
                (
                  SELECT
                    "hi"."id",
                    "hs"."entity_key"
                  FROM
                    "temporal_attribute_streams" AS "hs"
                    JOIN "entities" AS "hi" ON "hi"."entity_key" = "hs"."entity_key"
                  WHERE
                    "hs"."attribute_name_key" = (1)
                  ORDER BY
                    "hi"."id" ASC
                ) AS "hr"
            ) AS "held"
          ORDER BY
            "held"."id" ASC
        ) AS "e"
      ORDER BY
        "e"."id" ASC
      LIMIT
        5000 OFFSET 0
    ) AS "e"
  WHERE
    ((("e"."id") COLLATE "default") ~ $1)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "re"."id" AS "entity_id",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
            JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        ) AS "ah"
      WHERE
        "ah"."attribute_name_key" = $2
        AND "ah"."observed_at" < $3
        AND "ah"."entity_id" = "e"."id"
    )
  ORDER BY
    "e"."id" ASC
  LIMIT
    20
),
"candidates" AS MATERIALIZED (
  SELECT
    "entities"."entity_key"
  FROM
    "entities"
  WHERE
    ((("entities"."id") COLLATE "default") ~ $4)
    AND "entities"."evolution_created_at" IS NOT NULL
  LIMIT
    1001
)
SELECT
  *
FROM
  (
    SELECT
      *
    FROM
      "short_walk"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "short_walk"
      ) >= $5
    ORDER BY
      "entity_id" ASC
    LIMIT
      20 OFFSET 0
  ) AS "answered"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT DISTINCT
            ON ("held"."id") "held"."id",
            "held"."entity_key"
          FROM
            (
              SELECT
                "hr"."id",
                "hr"."entity_key"
              FROM
                (
                  SELECT
                    "hi"."id",
                    "hs"."entity_key"
                  FROM
                    "temporal_attribute_streams" AS "hs"
                    JOIN "entities" AS "hi" ON "hi"."entity_key" = "hs"."entity_key"
                  WHERE
                    "hs"."attribute_name_key" = (1)
                    AND "hs"."entity_key" IN (
                      SELECT
                        "entity_key"
                      FROM
                        "candidates"
                    )
                  ORDER BY
                    "hi"."id" ASC
                ) AS "hr"
            ) AS "held"
          ORDER BY
            "held"."id" ASC
        ) AS "e"
      WHERE
        (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $6
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $7
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."attribute_name_key" = $8
            AND "ah"."observed_at" < $9
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "indexed"
)
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT DISTINCT
            ON ("held"."id") "held"."id",
            "held"."entity_key"
          FROM
            (
              SELECT
                "hr"."id",
                "hr"."entity_key"
              FROM
                (
                  SELECT
                    "hi"."id",
                    "hs"."entity_key"
                  FROM
                    "temporal_attribute_streams" AS "hs"
                    JOIN "entities" AS "hi" ON "hi"."entity_key" = "hs"."entity_key"
                  WHERE
                    "hs"."attribute_name_key" = (1)
                  ORDER BY
                    "hi"."id" ASC
                ) AS "hr"
            ) AS "held"
          ORDER BY
            "held"."id" ASC
        ) AS "e"
      WHERE
        ((("e"."id") COLLATE "default") ~ $10)
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $11
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $12
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."attribute_name_key" = $13
            AND "ah"."observed_at" < $14
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "walk"
)
1: String '.*:0123.*'
2: Int 1
3: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
4: String '.*:0123.*'
5: BigUnsigned 20
6: BigUnsigned 20
7: BigUnsigned 1000
8: Int 1
9: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
10: String '.*:0123.*'
11: BigUnsigned 20
12: BigUnsigned 1000
13: Int 1
14: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
