---
source: crates/andromeda-postgresql-temporal-query/src/history.rs
---
SELECT
  "read_entity"."read_entity" AS "read_entity_id",
  "entity_rows".*
FROM
  UNNEST(ARRAY[$1]) AS "read_entity"
  JOIN LATERAL (
    SELECT
      "ah"."recorded_at",
      "ah"."attribute_kind",
      "ah"."value_kind",
      "ah"."observed_at",
      "ah"."created_at",
      "ah"."modified_at",
      "ah"."deleted_at",
      "ah"."generated_instance_id",
      "ah"."verbatim_instance_id",
      "ah"."value_number",
      "ah"."value_string",
      "ah"."value_language",
      "ah"."value_boolean",
      "ah"."value_geometry_members",
      "ah"."value_object",
      "ah"."value_date_time",
      "ah"."value_uri",
      "ah"."unit_code_id",
      "ah"."value_type_key",
      "ah"."value_datatype_key",
      "ah"."object_type_keys",
      "ah"."expires_at",
      "ah"."sub_attributes",
      "ah"."write_id",
      "ah"."write_ordinal",
      ST_AsEWKB("ah"."value_geometry") AS "value_geometry_ewkb",
      "an"."name" AS "attribute_name",
      "ah"."dataset_key",
      FALSE AS "stream_continues"
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "read_entity"."read_entity"
      ) AS "ah"
      JOIN "attribute_names" AS "an" ON "an"."attribute_name_key" = "ah"."attribute_name_key"
    WHERE
      "ah"."deleted_at" IS NOT NULL
      AND TRUE
      AND TRUE OFFSET 0
  ) AS "entity_rows" ON TRUE
ORDER BY
  "read_entity"."read_entity" ASC,
  "entity_rows"."attribute_name" ASC,
  "entity_rows"."deleted_at" ASC,
  "entity_rows"."write_id" ASC,
  "entity_rows"."write_ordinal" ASC
1: String 'urn:ngsi-ld:Vehicle:1'
