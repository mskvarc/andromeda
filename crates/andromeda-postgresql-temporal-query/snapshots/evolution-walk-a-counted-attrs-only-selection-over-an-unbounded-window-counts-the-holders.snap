---
source: crates/andromeda-postgresql-temporal-query/src/stage1/evolution_walk.rs
---
SELECT
  COUNT("e"."id")
FROM
  (
    SELECT DISTINCT
      ON ("held"."id") "held"."id",
      "held"."entity_key"
    FROM
      (
        SELECT
          "hr"."id",
          "hr"."entity_key"
        FROM
          (
            SELECT
              "hi"."id",
              "hs"."entity_key"
            FROM
              "temporal_attribute_streams" AS "hs"
              JOIN "entities" AS "hi" ON "hi"."entity_key" = "hs"."entity_key"
            WHERE
              "hs"."attribute_name_key" = (7)
            ORDER BY
              "hi"."id" ASC
          ) AS "hr"
      ) AS "held"
    ORDER BY
      "held"."id" ASC
  ) AS "e"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rs"."stream_key" AS "stream_key"
        FROM
          "temporal_attribute_streams" AS "rs"
      ) AS "s"
    WHERE
      "s"."attribute_name_key" = $1
      AND TRUE
      AND "s"."entity_key" = "e"."entity_key"
  )
1: Int 7
