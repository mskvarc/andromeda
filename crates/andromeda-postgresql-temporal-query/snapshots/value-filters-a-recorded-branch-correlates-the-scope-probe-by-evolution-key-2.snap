---
source: crates/andromeda-postgresql-temporal-query/src/value_filters.rs
---
SELECT
  $1
WHERE
  EXISTS (
    SELECT
      $2
    FROM
      (
        SELECT
          "rsh"."entity_key" AS "entity_key",
          "rsh"."recorded_at",
          "rsh"."write_id",
          "rsh"."write_ordinal",
          "rsh"."value_kind",
          "rsh"."observed_at",
          "rsh"."created_at",
          "rsh"."modified_at",
          "rsh"."deleted_at",
          "rsh"."scope_path",
          "rsh"."verbatim_scope_path"
        FROM
          "scope_history" AS "rsh"
        WHERE
          "rsh"."entity_key" = "e"."entity_key"
      ) AS "sh"
    WHERE
      "sh"."observed_at" IS NOT NULL
      AND ("sh"."scope_path" ~ ($3::lquery))
      AND (
        NOT EXISTS (
          SELECT
            $4
          FROM
            (
              SELECT
                "rsh"."entity_key" AS "entity_key",
                "rsh"."recorded_at",
                "rsh"."write_id",
                "rsh"."write_ordinal",
                "rsh"."value_kind",
                "rsh"."observed_at",
                "rsh"."created_at",
                "rsh"."modified_at",
                "rsh"."deleted_at",
                "rsh"."scope_path",
                "rsh"."verbatim_scope_path"
              FROM
                "scope_history" AS "rsh"
              WHERE
                "rsh"."entity_key" = "sh"."entity_key"
            ) AS "sh_next"
          WHERE
            "sh_next"."observed_at" > "sh"."observed_at"
            AND "sh_next"."observed_at" <= $5
        )
      )
  )
1: Int 1
2: Int 1
3: String 'city.moved1'
4: Int 1
5: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
