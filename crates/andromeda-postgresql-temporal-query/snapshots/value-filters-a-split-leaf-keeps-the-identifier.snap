---
source: crates/andromeda-postgresql-temporal-query/src/value_filters.rs
---
SELECT
  "e"."id",
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $1
      AND (
        "qh"."value_number" > $2
        AND "qh"."value_number" <> ('NaN'::numeric)
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $3
  ) AS "leaf_0",
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $4
      AND (
        (
          COALESCE(
            "qh"."value_geometry_reach",
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::box2d && ST_MakeEnvelope($5, $6, $7, $8, $9)::box2d
        )
        AND _ST_DWithin(
          COALESCE(
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($10))::geography,
          $11
        )
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $12
  ) AS "leaf_1",
  EXISTS (
    SELECT
      $13
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rsh"."recorded_at",
          "rsh"."write_id",
          "rsh"."write_ordinal",
          "rsh"."value_kind",
          "rsh"."observed_at",
          "rsh"."created_at",
          "rsh"."modified_at",
          "rsh"."deleted_at",
          "rsh"."scope_path",
          "rsh"."verbatim_scope_path"
        FROM
          "scope_history" AS "rsh"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rsh"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "sh"
    WHERE
      "sh"."observed_at" IS NOT NULL
      AND ("sh"."scope_path" ~ ($14::lquery))
      AND "sh"."observed_at" < $15
  ) AS "leaf_2"
FROM
  (
    SELECT
      *
    FROM
      "entities"
    WHERE
      "entities"."evolution_created_at" IS NOT NULL
  ) AS "e"
WHERE
  "e"."id" = ANY($16)
1: Int 1
2: BigDecimal 99
3: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
4: Int 2
5: Double 4.4702749827517545
6: Double 52.48191161045816
7: Double 4.5297250172482455
8: Double 52.51808838954184
9: Int 4326
10: Bytes '\x0101000020E610000000000000000012400000000000404A40'
11: Double 2000
12: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
13: Int 1
14: String 'city.moved1'
15: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
16: Array ARRAY ['urn:ngsi-ld:Sensor:000001','urn:ngsi-ld:Sensor:000002']
