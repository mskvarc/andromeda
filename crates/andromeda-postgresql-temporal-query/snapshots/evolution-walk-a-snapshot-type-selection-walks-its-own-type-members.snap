---
source: crates/andromeda-postgresql-temporal-query/src/stage1/evolution_walk.rs
---
SELECT
  "e"."id" AS "entity_id"
FROM
  (
    SELECT
      "entity_key",
      "id"
    FROM
      "snap_7"."entity_type_members"
    WHERE
      "entity_type_name_key" = (3)
      AND "is_evolution_member"
  ) AS "e"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rs"."stream_key" AS "stream_key"
        FROM
          "snap_7"."temporal_attribute_streams" AS "rs"
          JOIN "snap_7"."entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
      ) AS "s"
    WHERE
      TRUE
      AND "s"."entity_id" = "e"."id"
  )
ORDER BY
  "e"."id" ASC
LIMIT
  20 OFFSET 0
