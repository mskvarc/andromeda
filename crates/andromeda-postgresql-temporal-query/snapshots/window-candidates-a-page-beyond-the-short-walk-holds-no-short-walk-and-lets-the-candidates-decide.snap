---
source: crates/andromeda-postgresql-temporal-query/src/stage1/window_candidates.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "entities"."entity_key"
  FROM
    "entities"
  WHERE
    "entities"."evolution_active_until" >= $1
  LIMIT
    10001
)
SELECT
  *
FROM
  (
    SELECT
      "e"."id" AS "entity_id"
    FROM
      (
        SELECT
          "entity_key",
          "id"
        FROM
          "entity_type_members"
        WHERE
          "entity_type_name_key" = (1)
          AND "is_evolution_member"
          AND "entity_key" IN (
            SELECT
              "entity_key"
            FROM
              "candidates"
          )
        ORDER BY
          "id" ASC OFFSET 0
      ) AS "e"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "candidates"
      ) <= $2
      AND EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "re"."id" AS "entity_id",
              "rs"."attribute_name_key" AS "attribute_name_key",
              "rs"."dataset_key" AS "dataset_key",
              "rh"."recorded_at",
              "rh"."write_id",
              "rh"."write_ordinal",
              "rh"."attribute_kind",
              "rh"."value_kind",
              "rh"."observed_at",
              "rh"."created_at",
              "rh"."modified_at",
              "rh"."deleted_at",
              "rh"."value_date_time",
              "rh"."expires_at",
              "rh"."generated_instance_id",
              "rh"."value_type_key",
              "rh"."value_datatype_key",
              "rh"."unit_code_id",
              "rh"."value_boolean",
              "rh"."verbatim_instance_id",
              "rh"."value_number",
              "rh"."value_string",
              "rh"."value_language",
              "rh"."value_geometry",
              "rh"."value_geometry_valid",
              "rh"."value_geometry_reach",
              "rh"."value_geometry_members",
              "rh"."value_object",
              "rh"."value_uri",
              "rh"."object_type_keys",
              "rh"."sub_attributes"
            FROM
              "attribute_history" AS "rh"
              JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
              JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
          ) AS "ah"
        WHERE
          "ah"."modified_at" >= $3
          AND "ah"."entity_id" = "e"."id"
      )
    ORDER BY
      "e"."id" ASC
    LIMIT
      20 OFFSET 250
  ) AS "indexed"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
        ) AS "e"
      WHERE
        (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $4
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."modified_at" >= $5
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 250
    ) AS "walk"
)
1: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
2: BigUnsigned 10000
3: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
4: BigUnsigned 10000
5: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
