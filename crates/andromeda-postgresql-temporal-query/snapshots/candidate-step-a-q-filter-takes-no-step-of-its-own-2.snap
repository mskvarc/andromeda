---
source: crates/andromeda-postgresql-temporal-query/src/stage1/candidate_step.rs
---
SELECT
  COUNT("e"."id")
FROM
  (
    SELECT
      "entity_key",
      "id"
    FROM
      "entity_type_members"
    WHERE
      "entity_type_name_key" = (1)
      AND "is_evolution_member"
  ) AS "e"
WHERE
  (
    EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "rs"."entity_key" AS "entity_key",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          WHERE
            "rs"."entity_key" = "e"."entity_key"
        ) AS "qh"
      WHERE
        "qh"."attribute_name_key" = $1
        AND (
          "qh"."value_number" > $2
          AND "qh"."value_number" <> ('NaN'::numeric)
        )
        AND "qh"."value_kind" <> (0)
        AND "qh"."observed_at" IS NOT NULL
        AND "qh"."observed_at" >= $3
    )
    OR EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "rs"."entity_key" AS "entity_key",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rs"."stream_key" AS "stream_key"
          FROM
            "temporal_attribute_streams" AS "rs"
          WHERE
            "rs"."entity_key" = "e"."entity_key"
        ) AS "qs"
        JOIN LATERAL (
          SELECT
            *
          FROM
            (
              (
                SELECT
                  *
                FROM
                  (
                    (
                      SELECT
                        "qi".*,
                        "qi"."observed_at" AS "placed"
                      FROM
                        (
                          SELECT
                            "qs"."entity_key" AS "entity_key",
                            "qs"."attribute_name_key" AS "attribute_name_key",
                            "qs"."dataset_key" AS "dataset_key",
                            "rh"."recorded_at",
                            "rh"."write_id",
                            "rh"."write_ordinal",
                            "rh"."attribute_kind" AS "attribute_kind",
                            "rh"."value_kind" AS "value_kind",
                            "rh"."observed_at" AS "observed_at",
                            "rh"."created_at" AS "created_at",
                            "rh"."modified_at" AS "modified_at",
                            "rh"."deleted_at" AS "deleted_at",
                            "rh"."value_date_time" AS "value_date_time",
                            "rh"."expires_at" AS "expires_at",
                            "rh"."generated_instance_id" AS "generated_instance_id",
                            "rh"."value_type_key" AS "value_type_key",
                            "rh"."value_datatype_key" AS "value_datatype_key",
                            "rh"."unit_code_id" AS "unit_code_id",
                            "rh"."value_boolean" AS "value_boolean",
                            "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                            "rh"."value_number" AS "value_number",
                            "rh"."value_string" AS "value_string",
                            "rh"."value_language" AS "value_language",
                            "rh"."value_geometry" AS "value_geometry",
                            "rh"."value_geometry_valid" AS "value_geometry_valid",
                            "rh"."value_geometry_reach" AS "value_geometry_reach",
                            "rh"."value_geometry_members" AS "value_geometry_members",
                            "rh"."value_object" AS "value_object",
                            "rh"."value_uri" AS "value_uri",
                            "rh"."object_type_keys" AS "object_type_keys",
                            "rh"."sub_attributes" AS "sub_attributes"
                          FROM
                            "attribute_history" AS "rh"
                          WHERE
                            "rh"."stream_key" = "qs"."stream_key"
                        ) AS "qi"
                      WHERE
                        "qi"."observed_at" <= $4
                      ORDER BY
                        "qi"."observed_at" DESC
                    )
                    FETCH FIRST
                      1 ROW
                    WITH
                    TIES
                  ) AS "qe"
                UNION ALL
                (
                  SELECT
                    *
                  FROM
                    (
                      (
                        SELECT
                          "qi".*,
                          "qi"."deleted_at" AS "placed"
                        FROM
                          (
                            SELECT
                              "qs"."entity_key" AS "entity_key",
                              "qs"."attribute_name_key" AS "attribute_name_key",
                              "qs"."dataset_key" AS "dataset_key",
                              "rh"."recorded_at",
                              "rh"."write_id",
                              "rh"."write_ordinal",
                              "rh"."attribute_kind" AS "attribute_kind",
                              "rh"."value_kind" AS "value_kind",
                              "rh"."observed_at" AS "observed_at",
                              "rh"."created_at" AS "created_at",
                              "rh"."modified_at" AS "modified_at",
                              "rh"."deleted_at" AS "deleted_at",
                              "rh"."value_date_time" AS "value_date_time",
                              "rh"."expires_at" AS "expires_at",
                              "rh"."generated_instance_id" AS "generated_instance_id",
                              "rh"."value_type_key" AS "value_type_key",
                              "rh"."value_datatype_key" AS "value_datatype_key",
                              "rh"."unit_code_id" AS "unit_code_id",
                              "rh"."value_boolean" AS "value_boolean",
                              "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                              "rh"."value_number" AS "value_number",
                              "rh"."value_string" AS "value_string",
                              "rh"."value_language" AS "value_language",
                              "rh"."value_geometry" AS "value_geometry",
                              "rh"."value_geometry_valid" AS "value_geometry_valid",
                              "rh"."value_geometry_reach" AS "value_geometry_reach",
                              "rh"."value_geometry_members" AS "value_geometry_members",
                              "rh"."value_object" AS "value_object",
                              "rh"."value_uri" AS "value_uri",
                              "rh"."object_type_keys" AS "object_type_keys",
                              "rh"."sub_attributes" AS "sub_attributes"
                            FROM
                              "attribute_history" AS "rh"
                            WHERE
                              "rh"."stream_key" = "qs"."stream_key"
                          ) AS "qi"
                        WHERE
                          "qi"."deleted_at" <= $5
                          AND "qi"."observed_at" IS NULL
                        ORDER BY
                          "qi"."deleted_at" DESC
                      )
                      FETCH FIRST
                        1 ROW
                      WITH
                      TIES
                    ) AS "qe"
                )
                ORDER BY
                  "placed" DESC
              )
              FETCH FIRST
                1 ROW
              WITH
              TIES
            ) AS "qe"
        ) AS "qh" ON TRUE
      WHERE
        "qs"."attribute_name_key" = $6
        AND "qh"."placed" < $7
        AND "qh"."attribute_name_key" = $8
        AND (
          "qh"."value_number" > $9
          AND "qh"."value_number" <> ('NaN'::numeric)
        )
        AND "qh"."value_kind" <> (0)
    )
  )
  AND EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
      ) AS "ah"
    WHERE
      "ah"."observed_at" >= $10
      AND "ah"."entity_key" = "e"."entity_key"
  )
1: Int 1
2: BigDecimal 99
3: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
4: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
5: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
6: Int 1
7: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
8: Int 1
9: BigDecimal 99
10: ChronoDateTimeUtc '2026-10-18 03:00:00.000000 +00:00'
