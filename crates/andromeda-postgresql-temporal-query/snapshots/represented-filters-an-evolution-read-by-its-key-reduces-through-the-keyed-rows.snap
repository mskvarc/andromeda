---
source: crates/andromeda-postgresql-temporal-query/src/represented_filters.rs
---
SELECT
  $1
WHERE
  "ah"."attribute_name_key" <> $2
  OR (
    "ah"."attribute_name_key" = $3
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "rs"."entity_key" AS "entity_key",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          WHERE
            "rs"."entity_key" = "e"."entity_key"
        ) AS "qh"
      WHERE
        "qh"."attribute_name_key" = $4
        AND "qh"."dataset_key" = "ah"."dataset_key"
        AND "qh"."observed_at" = "ah"."observed_at"
        AND "qh"."recorded_at" = "ah"."recorded_at"
        AND "qh"."write_id" = "ah"."write_id"
        AND "qh"."write_ordinal" = "ah"."write_ordinal"
        AND (
          "qh"."value_number" > $5
          AND "qh"."value_number" <> ('NaN'::numeric)
        )
        AND "qh"."value_kind" <> (0)
        AND "qh"."observed_at" IS NOT NULL
        AND "qh"."observed_at" >= $6
    )
  )
1: Int 1
2: Int 1
3: Int 1
4: Int 1
5: BigDecimal 50
6: ChronoDateTimeUtc '2020-08-01 12:00:00.000000 +00:00'
