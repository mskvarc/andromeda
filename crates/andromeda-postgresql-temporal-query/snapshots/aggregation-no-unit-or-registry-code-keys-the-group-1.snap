---
source: crates/andromeda-postgresql-temporal-query/src/aggregation.rs
---
WITH
"bucket_origin" AS MATERIALIZED (
  SELECT
    MIN("ah2"."observed_at") AS "origin"
  FROM
    (
      SELECT
        "re"."id" AS "entity_id",
        "rs"."attribute_name_key" AS "attribute_name_key",
        "rs"."dataset_key" AS "dataset_key",
        "rh"."recorded_at",
        "rh"."write_id",
        "rh"."write_ordinal",
        "rh"."attribute_kind",
        "rh"."value_kind",
        "rh"."observed_at",
        "rh"."created_at",
        "rh"."modified_at",
        "rh"."deleted_at",
        "rh"."value_date_time",
        "rh"."expires_at",
        "rh"."generated_instance_id",
        "rh"."value_type_key",
        "rh"."value_datatype_key",
        "rh"."unit_code_id",
        "rh"."value_boolean",
        "rh"."verbatim_instance_id",
        "rh"."value_number",
        "rh"."value_string",
        "rh"."value_language",
        "rh"."value_geometry",
        "rh"."value_geometry_valid",
        "rh"."value_geometry_reach",
        "rh"."value_geometry_members",
        "rh"."value_object",
        "rh"."value_uri",
        "rh"."object_type_keys",
        "rh"."sub_attributes"
      FROM
        "attribute_history" AS "rh"
        JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
        JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
      WHERE
        "re"."id" = $1
        AND (
          "rh"."verbatim_instance_id" IS NULL
          OR (
            NOT EXISTS (
              SELECT
                1
              FROM
                "temporal_append_entries" AS "pr"
              WHERE
                "pr"."entity_id" = "re"."id"
                AND "pr"."attribute_name_key" = "rs"."attribute_name_key"
                AND "pr"."verbatim_instance_id" = "rh"."verbatim_instance_id"
                AND "pr"."entry_kind" IN (1, 2)
            )
          )
        )
      UNION ALL
      (
        SELECT
          "pe"."entity_id" AS "entity_id",
          "pe"."attribute_name_key" AS "attribute_name_key",
          "pe"."dataset_key" AS "dataset_key",
          "pe"."recorded_at" AS "recorded_at",
          "pe"."write_id" AS "write_id",
          "pe"."write_ordinal" AS "write_ordinal",
          "pe"."attribute_kind" AS "attribute_kind",
          "pe"."value_kind" AS "value_kind",
          "pe"."observed_at" AS "observed_at",
          "pe"."created_at" AS "created_at",
          "pe"."modified_at" AS "modified_at",
          "pe"."deleted_at" AS "deleted_at",
          "pe"."value_date_time" AS "value_date_time",
          "pe"."expires_at" AS "expires_at",
          "pe"."generated_instance_id" AS "generated_instance_id",
          "pe"."value_type_key" AS "value_type_key",
          "pe"."value_datatype_key" AS "value_datatype_key",
          "pe"."unit_code_id" AS "unit_code_id",
          "pe"."value_boolean" AS "value_boolean",
          "pe"."verbatim_instance_id" AS "verbatim_instance_id",
          "pe"."value_number" AS "value_number",
          "pe"."value_string" AS "value_string",
          "pe"."value_language" AS "value_language",
          "pe"."value_geometry" AS "value_geometry",
          (
            CASE
              WHEN (ST_IsValid("pe"."value_geometry")) THEN NULL
              ELSE ST_MakeValid("pe"."value_geometry")
            END
          ) AS "value_geometry_valid",
          "pe"."value_geometry_reach" AS "value_geometry_reach",
          "pe"."value_geometry_members" AS "value_geometry_members",
          "pe"."value_object" AS "value_object",
          "pe"."value_uri" AS "value_uri",
          "pe"."object_type_keys" AS "object_type_keys",
          "pe"."sub_attributes" AS "sub_attributes"
        FROM
          "temporal_append_entries" AS "pe"
        WHERE
          "pe"."entry_kind" IN (1, 2)
          AND (
            EXISTS (
              SELECT
                1
              FROM
                "entities" AS "pv"
              WHERE
                "pv"."id" = "pe"."entity_id"
                AND "pv"."evolution_created_at" IS NOT NULL
            )
            OR EXISTS (
              SELECT
                1
              FROM
                "temporal_append_intents" AS "pt"
              WHERE
                "pt"."entity_id" = "pe"."entity_id"
                AND cardinality("pt"."entity_type_name_keys") > 0
                AND (
                  "pe"."entry_kind" <> (2)
                  OR "pt"."intent_key" <= "pe"."intent_key"
                )
            )
          )
          AND (
            (
              "pe"."verbatim_instance_id" IS NOT NULL
              AND (
                NOT EXISTS (
                  SELECT
                    1
                  FROM
                    "temporal_append_entries" AS "pr"
                  WHERE
                    "pr"."entity_id" = "pe"."entity_id"
                    AND "pr"."attribute_name_key" = "pe"."attribute_name_key"
                    AND "pr"."verbatim_instance_id" = "pe"."verbatim_instance_id"
                    AND "pr"."entry_kind" IN (1, 2)
                    AND "pr"."intent_key" > "pe"."intent_key"
                )
              )
            )
            OR (
              "pe"."verbatim_instance_id" IS NULL
              AND (
                NOT EXISTS (
                  SELECT
                    1
                  FROM
                    "attribute_history" AS "pd"
                  WHERE
                    "pd"."recorded_at" = "pe"."recorded_at"
                    AND "pd"."write_id" = "pe"."write_id"
                    AND "pd"."write_ordinal" = "pe"."write_ordinal"
                )
              )
            )
          )
          AND "pe"."entity_id" = $2
      )
    ) AS "ah2"
)
SELECT
  "an"."name" AS "attribute_name",
  "st"."dataset_key" AS "dataset_key",
  "page".*,
  (
    SELECT
      "bucket_origin"."origin"
    FROM
      "bucket_origin"
  )::timestamptz AS "period_origin",
  FALSE AS "stream_continues"
FROM
  (
    SELECT
      "re"."id" AS "entity_id",
      "rs"."attribute_name_key" AS "attribute_name_key",
      "rs"."dataset_key" AS "dataset_key",
      "rs"."stream_key" AS "stream_key"
    FROM
      "temporal_attribute_streams" AS "rs"
      JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
    WHERE
      "re"."id" = $3
    UNION ALL
    (
      SELECT DISTINCT
        "pe"."entity_id" AS "entity_id",
        "pe"."attribute_name_key" AS "attribute_name_key",
        "pe"."dataset_key" AS "dataset_key",
        NULL::bigint AS "stream_key"
      FROM
        "temporal_append_entries" AS "pe"
      WHERE
        "pe"."entry_kind" IN (1, 2)
        AND (
          EXISTS (
            SELECT
              1
            FROM
              "entities" AS "pv"
            WHERE
              "pv"."id" = "pe"."entity_id"
              AND "pv"."evolution_created_at" IS NOT NULL
          )
          OR EXISTS (
            SELECT
              1
            FROM
              "temporal_append_intents" AS "pt"
            WHERE
              "pt"."entity_id" = "pe"."entity_id"
              AND cardinality("pt"."entity_type_name_keys") > 0
              AND (
                "pe"."entry_kind" <> (2)
                OR "pt"."intent_key" <= "pe"."intent_key"
              )
          )
        )
        AND (
          NOT EXISTS (
            SELECT
              1
            FROM
              "temporal_attribute_streams" AS "ps"
              JOIN "entities" AS "pv" ON "pv"."entity_key" = "ps"."entity_key"
            WHERE
              "pv"."id" = "pe"."entity_id"
              AND "ps"."attribute_name_key" = "pe"."attribute_name_key"
              AND "ps"."dataset_key" = "pe"."dataset_key"
          )
        )
        AND "pe"."entity_id" = $4
    )
  ) AS "st"
  JOIN "attribute_names" AS "an" ON "an"."attribute_name_key" = "st"."attribute_name_key"
  JOIN LATERAL (
    SELECT
      MIN("ah"."attribute_kind") AS "attribute_kind_lowest",
      MAX("ah"."attribute_kind") AS "attribute_kind_highest",
      MIN(
        (
          CASE
            WHEN (
              "ah"."value_kind" = (5)
              AND jsonb_typeof(
                COALESCE(
                  (
                    CASE
                      WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                    END
                  ),
                  "ah"."value_object"
                )
              ) = ('array')
            ) THEN 6::smallint
            WHEN ("ah"."value_kind" = (5)) THEN 5::smallint
            WHEN ("ah"."value_kind" = (9)) THEN 9::smallint
            WHEN ("ah"."value_kind" = (8)) THEN 8::smallint
            WHEN ("ah"."value_kind" = (2)) THEN 2::smallint
            WHEN ("ah"."value_kind" IN (1, 10)) THEN 1::smallint
            WHEN ("ah"."value_kind" IN (3, 11)) THEN 3::smallint
            WHEN ("ah"."value_kind" = (4)) THEN 4::smallint
            WHEN ("ah"."value_kind" = (6)) THEN 7::smallint
            WHEN ("ah"."value_kind" = (7)) THEN 10::smallint
          END
        )
      ) AS "recorded_shape_lowest",
      MAX(
        (
          CASE
            WHEN (
              "ah"."value_kind" = (5)
              AND jsonb_typeof(
                COALESCE(
                  (
                    CASE
                      WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                    END
                  ),
                  "ah"."value_object"
                )
              ) = ('array')
            ) THEN 6::smallint
            WHEN ("ah"."value_kind" = (5)) THEN 5::smallint
            WHEN ("ah"."value_kind" = (9)) THEN 9::smallint
            WHEN ("ah"."value_kind" = (8)) THEN 8::smallint
            WHEN ("ah"."value_kind" = (2)) THEN 2::smallint
            WHEN ("ah"."value_kind" IN (1, 10)) THEN 1::smallint
            WHEN ("ah"."value_kind" IN (3, 11)) THEN 3::smallint
            WHEN ("ah"."value_kind" = (4)) THEN 4::smallint
            WHEN ("ah"."value_kind" = (6)) THEN 7::smallint
            WHEN ("ah"."value_kind" = (7)) THEN 10::smallint
          END
        )
      ) AS "recorded_shape_highest",
      MIN("ah"."unit_code_id") AS "unit_code_id_lowest",
      MAX("ah"."unit_code_id") AS "unit_code_id_highest",
      BOOL_OR("ah"."unit_code_id" IS NULL) AS "any_unitless",
      COUNT(*) AS "agg_total_count",
      AVG(
        (
          CASE
            WHEN ("ah"."attribute_kind" NOT IN (2, 8, 4)) THEN COALESCE(
              (
                CASE
                  WHEN (
                    "ah"."value_number" NOT IN (
                      'NaN'::numeric,
                      'Infinity'::numeric,
                      '-Infinity'::numeric
                    )
                  ) THEN "ah"."value_number"
                END
              ),
              "ah"."value_boolean"::integer::numeric,
              (
                CASE
                  WHEN (
                    jsonb_typeof(
                      COALESCE(
                        (
                          CASE
                            WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                          END
                        ),
                        "ah"."value_object"
                      )
                    ) = ('array')
                  ) THEN jsonb_array_length(
                    COALESCE(
                      (
                        CASE
                          WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                        END
                      ),
                      "ah"."value_object"
                    )
                  )::numeric
                END
              )
            )
          END
        )
      ) AS "agg_avg",
      AVG(
        (
          CASE
            WHEN (
              "ah"."value_kind" = (9)
              AND "ah"."attribute_kind" NOT IN (2, 8, 4)
            ) THEN "ah"."value_string"::time:: interval
          END
        )
      )::time AS "agg_avg_time",
      MIN(
        (
          CASE
            WHEN ("ah"."attribute_kind" NOT IN (2, 8, 4)) THEN COALESCE(
              (
                CASE
                  WHEN (
                    "ah"."value_number" NOT IN (
                      'NaN'::numeric,
                      'Infinity'::numeric,
                      '-Infinity'::numeric
                    )
                  ) THEN "ah"."value_number"
                END
              ),
              "ah"."value_boolean"::integer::numeric,
              (
                CASE
                  WHEN (
                    jsonb_typeof(
                      COALESCE(
                        (
                          CASE
                            WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                          END
                        ),
                        "ah"."value_object"
                      )
                    ) = ('array')
                  ) THEN jsonb_array_length(
                    COALESCE(
                      (
                        CASE
                          WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                        END
                      ),
                      "ah"."value_object"
                    )
                  )::numeric
                END
              )
            )
          END
        )
      ) AS "agg_min",
      MIN(
        (
          CASE
            WHEN ("ah"."attribute_kind" NOT IN (2, 8, 4)) THEN "ah"."value_string"
          END
        )
      ) AS "agg_min_str",
      MIN(
        (
          CASE
            WHEN ("ah"."attribute_kind" NOT IN (2, 8, 4)) THEN "ah"."value_date_time"
          END
        )
      ) AS "agg_min_dt",
      "bucket"."bucket_start" AS "bucket_start",
      "bucket"."bucket_start" + ($5:: interval) AS "bucket_end",
      ROW_NUMBER() OVER (
        ORDER BY
          "bucket"."bucket_start" ASC) AS "period_order"
    FROM
      (
        SELECT
          "part".*
        FROM
          (
            SELECT
              "ah".*
            FROM
              (
                SELECT
                  "st"."entity_id" AS "entity_id",
                  "st"."attribute_name_key" AS "attribute_name_key",
                  "st"."dataset_key" AS "dataset_key",
                  "rh"."recorded_at",
                  "rh"."write_id",
                  "rh"."write_ordinal",
                  "rh"."attribute_kind" AS "attribute_kind",
                  "rh"."value_kind" AS "value_kind",
                  "rh"."observed_at" AS "observed_at",
                  "rh"."created_at" AS "created_at",
                  "rh"."modified_at" AS "modified_at",
                  "rh"."deleted_at" AS "deleted_at",
                  "rh"."value_date_time" AS "value_date_time",
                  "rh"."expires_at" AS "expires_at",
                  "rh"."generated_instance_id" AS "generated_instance_id",
                  "rh"."value_type_key" AS "value_type_key",
                  "rh"."value_datatype_key" AS "value_datatype_key",
                  "rh"."unit_code_id" AS "unit_code_id",
                  "rh"."value_boolean" AS "value_boolean",
                  "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                  "rh"."value_number" AS "value_number",
                  "rh"."value_string" AS "value_string",
                  "rh"."value_language" AS "value_language",
                  "rh"."value_geometry" AS "value_geometry",
                  "rh"."value_geometry_valid" AS "value_geometry_valid",
                  "rh"."value_geometry_reach" AS "value_geometry_reach",
                  "rh"."value_geometry_members" AS "value_geometry_members",
                  "rh"."value_object" AS "value_object",
                  "rh"."value_uri" AS "value_uri",
                  "rh"."object_type_keys" AS "object_type_keys",
                  "rh"."sub_attributes" AS "sub_attributes"
                FROM
                  "attribute_history" AS "rh"
                WHERE
                  "rh"."stream_key" = "st"."stream_key"
                  AND (
                    "rh"."verbatim_instance_id" IS NULL
                    OR (
                      NOT EXISTS (
                        SELECT
                          1
                        FROM
                          "temporal_append_entries" AS "pr"
                        WHERE
                          "pr"."entity_id" = "st"."entity_id"
                          AND "pr"."attribute_name_key" = "st"."attribute_name_key"
                          AND "pr"."verbatim_instance_id" = "rh"."verbatim_instance_id"
                          AND "pr"."entry_kind" IN (1, 2)
                      )
                    )
                  )
              ) AS "ah"
            WHERE
              "ah"."value_kind" <> (0)
          ) AS "part"
        UNION ALL
        (
          SELECT
            "part".*
          FROM
            (
              SELECT
                "ah".*
              FROM
                (
                  SELECT
                    "pe"."entity_id" AS "entity_id",
                    "pe"."attribute_name_key" AS "attribute_name_key",
                    "pe"."dataset_key" AS "dataset_key",
                    "pe"."recorded_at" AS "recorded_at",
                    "pe"."write_id" AS "write_id",
                    "pe"."write_ordinal" AS "write_ordinal",
                    "pe"."attribute_kind" AS "attribute_kind",
                    "pe"."value_kind" AS "value_kind",
                    "pe"."observed_at" AS "observed_at",
                    "pe"."created_at" AS "created_at",
                    "pe"."modified_at" AS "modified_at",
                    "pe"."deleted_at" AS "deleted_at",
                    "pe"."value_date_time" AS "value_date_time",
                    "pe"."expires_at" AS "expires_at",
                    "pe"."generated_instance_id" AS "generated_instance_id",
                    "pe"."value_type_key" AS "value_type_key",
                    "pe"."value_datatype_key" AS "value_datatype_key",
                    "pe"."unit_code_id" AS "unit_code_id",
                    "pe"."value_boolean" AS "value_boolean",
                    "pe"."verbatim_instance_id" AS "verbatim_instance_id",
                    "pe"."value_number" AS "value_number",
                    "pe"."value_string" AS "value_string",
                    "pe"."value_language" AS "value_language",
                    "pe"."value_geometry" AS "value_geometry",
                    (
                      CASE
                        WHEN (ST_IsValid("pe"."value_geometry")) THEN NULL
                        ELSE ST_MakeValid("pe"."value_geometry")
                      END
                    ) AS "value_geometry_valid",
                    "pe"."value_geometry_reach" AS "value_geometry_reach",
                    "pe"."value_geometry_members" AS "value_geometry_members",
                    "pe"."value_object" AS "value_object",
                    "pe"."value_uri" AS "value_uri",
                    "pe"."object_type_keys" AS "object_type_keys",
                    "pe"."sub_attributes" AS "sub_attributes"
                  FROM
                    "temporal_append_entries" AS "pe"
                  WHERE
                    "pe"."entry_kind" IN (1, 2)
                    AND (
                      EXISTS (
                        SELECT
                          1
                        FROM
                          "entities" AS "pv"
                        WHERE
                          "pv"."id" = "pe"."entity_id"
                          AND "pv"."evolution_created_at" IS NOT NULL
                      )
                      OR EXISTS (
                        SELECT
                          1
                        FROM
                          "temporal_append_intents" AS "pt"
                        WHERE
                          "pt"."entity_id" = "pe"."entity_id"
                          AND cardinality("pt"."entity_type_name_keys") > 0
                          AND (
                            "pe"."entry_kind" <> (2)
                            OR "pt"."intent_key" <= "pe"."intent_key"
                          )
                      )
                    )
                    AND (
                      (
                        "pe"."verbatim_instance_id" IS NOT NULL
                        AND (
                          NOT EXISTS (
                            SELECT
                              1
                            FROM
                              "temporal_append_entries" AS "pr"
                            WHERE
                              "pr"."entity_id" = "pe"."entity_id"
                              AND "pr"."attribute_name_key" = "pe"."attribute_name_key"
                              AND "pr"."verbatim_instance_id" = "pe"."verbatim_instance_id"
                              AND "pr"."entry_kind" IN (1, 2)
                              AND "pr"."intent_key" > "pe"."intent_key"
                          )
                        )
                      )
                      OR (
                        "pe"."verbatim_instance_id" IS NULL
                        AND (
                          NOT EXISTS (
                            SELECT
                              1
                            FROM
                              "attribute_history" AS "pd"
                            WHERE
                              "pd"."recorded_at" = "pe"."recorded_at"
                              AND "pd"."write_id" = "pe"."write_id"
                              AND "pd"."write_ordinal" = "pe"."write_ordinal"
                          )
                        )
                      )
                    )
                    AND "pe"."entity_id" = "st"."entity_id"
                    AND "pe"."attribute_name_key" = "st"."attribute_name_key"
                    AND "pe"."dataset_key" = "st"."dataset_key"
                ) AS "ah"
              WHERE
                "ah"."value_kind" <> (0)
            ) AS "part"
        )
      ) AS "ah"
      JOIN LATERAL (
        SELECT
          time_bucket(
            $6:: interval,
            "ah"."observed_at",
            (
              SELECT
                "bucket_origin"."origin"
              FROM
                "bucket_origin"
            )::timestamptz
          ) AS "bucket_start"
      ) AS "bucket" ON TRUE
    GROUP BY
      "bucket"."bucket_start"
  ) AS "page" ON TRUE
1: String 'urn:ngsi-ld:Vehicle:1'
2: String 'urn:ngsi-ld:Vehicle:1'
3: String 'urn:ngsi-ld:Vehicle:1'
4: String 'urn:ngsi-ld:Vehicle:1'
5: String 'PT1H'
6: String 'PT1H'
