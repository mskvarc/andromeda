---
source: crates/andromeda-postgresql-temporal-query/src/stage1/entity_conditions.rs
---
WITH
"short_walk" AS MATERIALIZED (
  SELECT
    "e"."id" AS "entity_id"
  FROM
    (
      SELECT
        *
      FROM
        (
          SELECT
            "ru"."id",
            "ru"."evolution_type_name_keys"
          FROM
            (
              SELECT
                "re"."id",
                "re"."evolution_type_name_keys",
                FALSE AS "queued"
              FROM
                "entities" AS "re"
              WHERE
                "re"."evolution_created_at" IS NOT NULL
              UNION ALL
              (
                SELECT
                  "first_stated"."id",
                  array_agg(
                    "first_stated"."stated_key"
                    ORDER BY
                      (
                        "first_stated"."list_rank",
                        "first_stated"."key_position"
                      )
                  ) AS "entity_type_name_keys",
                  TRUE AS "queued"
                FROM
                  (
                    SELECT DISTINCT
                      ON ("stated_list"."id", "stated_key"."stated_key") "stated_list"."id",
                      "stated_key"."stated_key",
                      "stated_list"."list_rank",
                      array_position(
                        "stated_list"."entity_type_name_keys",
                        "stated_key"."stated_key"
                      ) AS "key_position"
                    FROM
                      (
                        SELECT
                          "pv"."id" AS "id",
                          "pv"."evolution_type_name_keys" AS "entity_type_name_keys",
                          0 AS "list_rank"
                        FROM
                          "entities" AS "pv"
                        WHERE
                          "pv"."evolution_created_at" IS NOT NULL
                          AND EXISTS (
                            SELECT
                              1
                            FROM
                              "temporal_append_intents" AS "pt"
                            WHERE
                              "pt"."entity_id" = "pv"."id"
                              AND cardinality("pt"."entity_type_name_keys") > 0
                          )
                        UNION ALL
                        (
                          SELECT
                            "pt"."entity_id" AS "id",
                            "pt"."entity_type_name_keys" AS "entity_type_name_keys",
                            "pt"."intent_key" AS "list_rank"
                          FROM
                            "temporal_append_intents" AS "pt"
                          WHERE
                            cardinality("pt"."entity_type_name_keys") > 0
                        )
                      ) AS "stated_list",
                      UNNEST("stated_list"."entity_type_name_keys") AS "stated_key"
                    ORDER BY
                      "stated_list"."id" ASC,
                      "stated_key"."stated_key" ASC,
                      "stated_list"."list_rank" ASC
                  ) AS "first_stated"
                GROUP BY
                  "first_stated"."id"
              )
            ) AS "ru"
          WHERE
            "ru"."queued"
            OR (
              NOT EXISTS (
                SELECT
                  1
                FROM
                  "temporal_append_intents" AS "pt"
                WHERE
                  "pt"."entity_id" = "ru"."id"
                  AND cardinality("pt"."entity_type_name_keys") > 0
              )
            )
        ) AS "e"
      ORDER BY
        "e"."id" ASC
      LIMIT
        200 OFFSET 0
    ) AS "e"
  WHERE
    EXISTS (
      SELECT
        $1
      FROM
        (
          SELECT
            "re"."id" AS "entity_id",
            "rsh"."recorded_at",
            "rsh"."write_id",
            "rsh"."write_ordinal",
            "rsh"."value_kind",
            "rsh"."observed_at",
            "rsh"."created_at",
            "rsh"."modified_at",
            "rsh"."deleted_at",
            "rsh"."scope_path",
            "rsh"."verbatim_scope_path"
          FROM
            "scope_history" AS "rsh"
            JOIN "entities" AS "re" ON "re"."entity_key" = "rsh"."entity_key"
          WHERE
            "re"."id" = "e"."id"
          UNION ALL
          (
            SELECT
              "pe"."entity_id" AS "entity_id",
              "pe"."recorded_at" AS "recorded_at",
              "pe"."write_id" AS "write_id",
              "pe"."write_ordinal" AS "write_ordinal",
              "pe"."value_kind" AS "value_kind",
              "pe"."observed_at" AS "observed_at",
              "pe"."created_at" AS "created_at",
              "pe"."modified_at" AS "modified_at",
              "pe"."deleted_at" AS "deleted_at",
              "pe"."scope_path"::ltree AS "scope_path",
              "pe"."verbatim_scope_path" AS "verbatim_scope_path"
            FROM
              "temporal_append_entries" AS "pe"
            WHERE
              "pe"."entry_kind" IN (3, 4)
              AND (
                EXISTS (
                  SELECT
                    1
                  FROM
                    "entities" AS "pv"
                  WHERE
                    "pv"."id" = "pe"."entity_id"
                    AND "pv"."evolution_created_at" IS NOT NULL
                )
                OR EXISTS (
                  SELECT
                    1
                  FROM
                    "temporal_append_intents" AS "pt"
                  WHERE
                    "pt"."entity_id" = "pe"."entity_id"
                    AND cardinality("pt"."entity_type_name_keys") > 0
                    AND (
                      "pe"."entry_kind" <> (2)
                      OR "pt"."intent_key" <= "pe"."intent_key"
                    )
                )
              )
              AND (
                NOT EXISTS (
                  SELECT
                    1
                  FROM
                    "scope_history" AS "pd"
                  WHERE
                    "pd"."recorded_at" = "pe"."recorded_at"
                    AND "pd"."write_id" = "pe"."write_id"
                    AND "pd"."write_ordinal" = "pe"."write_ordinal"
                )
              )
              AND (
                "pe"."entry_kind" <> 4
                OR (
                  NOT (
                    (
                      (
                        ARRAY (
                          SELECT
                            "sas"."verbatim_scope_path"
                          FROM
                            (
                              SELECT
                                "pj"."recorded_at",
                                "pj"."observed_at",
                                "pj"."verbatim_scope_path"
                              FROM
                                "scope_history" AS "pj"
                                JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                              WHERE
                                "pjv"."id" = "pe"."entity_id"
                              UNION ALL
                              (
                                SELECT
                                  "pq"."recorded_at" AS "recorded_at",
                                  "pq"."observed_at" AS "observed_at",
                                  "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                FROM
                                  "temporal_append_entries" AS "pq"
                                WHERE
                                  "pq"."entity_id" = "pe"."entity_id"
                                  AND "pq"."intent_key" < "pe"."intent_key"
                                  AND "pq"."entry_kind" IN (3, 4)
                              )
                            ) AS "sas"
                          WHERE
                            "sas"."verbatim_scope_path" IS NOT NULL
                            AND "sas"."recorded_at" = (
                              SELECT
                                "sah"."recorded_at"
                              FROM
                                (
                                  SELECT
                                    "pj"."recorded_at",
                                    "pj"."observed_at",
                                    "pj"."verbatim_scope_path"
                                  FROM
                                    "scope_history" AS "pj"
                                    JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                  WHERE
                                    "pjv"."id" = "pe"."entity_id"
                                  UNION ALL
                                  (
                                    SELECT
                                      "pq"."recorded_at" AS "recorded_at",
                                      "pq"."observed_at" AS "observed_at",
                                      "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                    FROM
                                      "temporal_append_entries" AS "pq"
                                    WHERE
                                      "pq"."entity_id" = "pe"."entity_id"
                                      AND "pq"."intent_key" < "pe"."intent_key"
                                      AND "pq"."entry_kind" IN (3, 4)
                                  )
                                ) AS "sah"
                              WHERE
                                "sah"."recorded_at" <= "pe"."recorded_at"
                              ORDER BY
                                "sah"."recorded_at" DESC
                              LIMIT
                                1
                            )
                          ORDER BY
                            ("sas"."verbatim_scope_path") COLLATE "C" ASC
                        )
                      ) COLLATE "C"
                    ) = (
                      (
                        ARRAY (
                          SELECT
                            "pa"."verbatim_scope_path"
                          FROM
                            "temporal_append_entries" AS "pa"
                          WHERE
                            "pa"."intent_key" = "pe"."intent_key"
                            AND "pa"."entry_kind" IN (4)
                          ORDER BY
                            ("pa"."verbatim_scope_path") COLLATE "C" ASC
                        )
                      ) COLLATE "C"
                    )
                    AND (
                      (
                        ARRAY (
                          SELECT
                            "sas"."verbatim_scope_path"
                          FROM
                            (
                              SELECT
                                "pj"."recorded_at",
                                "pj"."observed_at",
                                "pj"."verbatim_scope_path"
                              FROM
                                "scope_history" AS "pj"
                                JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                              WHERE
                                "pjv"."id" = "pe"."entity_id"
                              UNION ALL
                              (
                                SELECT
                                  "pq"."recorded_at" AS "recorded_at",
                                  "pq"."observed_at" AS "observed_at",
                                  "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                FROM
                                  "temporal_append_entries" AS "pq"
                                WHERE
                                  "pq"."entity_id" = "pe"."entity_id"
                                  AND "pq"."intent_key" < "pe"."intent_key"
                                  AND "pq"."entry_kind" IN (3, 4)
                              )
                            ) AS "sas"
                          WHERE
                            "sas"."verbatim_scope_path" IS NOT NULL
                            AND "sas"."observed_at" = (
                              SELECT
                                "sah"."observed_at"
                              FROM
                                (
                                  SELECT
                                    "pj"."recorded_at",
                                    "pj"."observed_at",
                                    "pj"."verbatim_scope_path"
                                  FROM
                                    "scope_history" AS "pj"
                                    JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                  WHERE
                                    "pjv"."id" = "pe"."entity_id"
                                  UNION ALL
                                  (
                                    SELECT
                                      "pq"."recorded_at" AS "recorded_at",
                                      "pq"."observed_at" AS "observed_at",
                                      "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                    FROM
                                      "temporal_append_entries" AS "pq"
                                    WHERE
                                      "pq"."entity_id" = "pe"."entity_id"
                                      AND "pq"."intent_key" < "pe"."intent_key"
                                      AND "pq"."entry_kind" IN (3, 4)
                                  )
                                ) AS "sah"
                              WHERE
                                "sah"."observed_at" <= "pe"."recorded_at"
                              ORDER BY
                                "sah"."observed_at" DESC
                              LIMIT
                                1
                            )
                          ORDER BY
                            ("sas"."verbatim_scope_path") COLLATE "C" ASC
                        )
                      ) COLLATE "C"
                    ) = (
                      (
                        ARRAY (
                          SELECT
                            "pa"."verbatim_scope_path"
                          FROM
                            "temporal_append_entries" AS "pa"
                          WHERE
                            "pa"."intent_key" = "pe"."intent_key"
                            AND "pa"."entry_kind" IN (4)
                          ORDER BY
                            ("pa"."verbatim_scope_path") COLLATE "C" ASC
                        )
                      ) COLLATE "C"
                    )
                  )
                )
              )
              AND "pe"."entity_id" = "e"."id"
          )
        ) AS "sh"
      WHERE
        "sh"."observed_at" IS NOT NULL
        AND ("sh"."scope_path" ~ ($2::lquery))
    )
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "re"."id" AS "entity_id",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rs"."stream_key" AS "stream_key"
          FROM
            "temporal_attribute_streams" AS "rs"
            JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
          WHERE
            "re"."id" = "e"."id"
          UNION ALL
          (
            SELECT DISTINCT
              "pe"."entity_id" AS "entity_id",
              "pe"."attribute_name_key" AS "attribute_name_key",
              "pe"."dataset_key" AS "dataset_key",
              NULL::bigint AS "stream_key"
            FROM
              "temporal_append_entries" AS "pe"
            WHERE
              "pe"."entry_kind" IN (1, 2)
              AND (
                EXISTS (
                  SELECT
                    1
                  FROM
                    "entities" AS "pv"
                  WHERE
                    "pv"."id" = "pe"."entity_id"
                    AND "pv"."evolution_created_at" IS NOT NULL
                )
                OR EXISTS (
                  SELECT
                    1
                  FROM
                    "temporal_append_intents" AS "pt"
                  WHERE
                    "pt"."entity_id" = "pe"."entity_id"
                    AND cardinality("pt"."entity_type_name_keys") > 0
                    AND (
                      "pe"."entry_kind" <> (2)
                      OR "pt"."intent_key" <= "pe"."intent_key"
                    )
                )
              )
              AND (
                NOT EXISTS (
                  SELECT
                    1
                  FROM
                    "temporal_attribute_streams" AS "ps"
                    JOIN "entities" AS "pv" ON "pv"."entity_key" = "ps"."entity_key"
                  WHERE
                    "pv"."id" = "pe"."entity_id"
                    AND "ps"."attribute_name_key" = "pe"."attribute_name_key"
                    AND "ps"."dataset_key" = "pe"."dataset_key"
                )
              )
              AND "pe"."entity_id" = "e"."id"
          )
        ) AS "s"
      WHERE
        TRUE
    )
  ORDER BY
    "e"."id" ASC
  LIMIT
    20
),
"candidates" AS MATERIALIZED (
  SELECT
    "entities"."id"
  FROM
    "scope_history"
    JOIN "entities" ON "entities"."entity_key" = "scope_history"."entity_key"
  WHERE
    "scope_history"."value_kind" = $3
    AND ("scope_history"."scope_path" ~ ($4::lquery))
  UNION ALL
  (
    SELECT
      "entity_id"
    FROM
      "temporal_append_intents"
  )
  LIMIT
    10001
)
SELECT
  *
FROM
  (
    SELECT
      *
    FROM
      "short_walk"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "short_walk"
      ) >= $5
    ORDER BY
      "entity_id" ASC
    LIMIT
      20 OFFSET 0
  ) AS "answered"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            *
          FROM
            (
              SELECT
                "ru"."id",
                "ru"."evolution_type_name_keys"
              FROM
                (
                  SELECT
                    "re"."id",
                    "re"."evolution_type_name_keys",
                    FALSE AS "queued"
                  FROM
                    "entities" AS "re"
                  WHERE
                    "re"."evolution_created_at" IS NOT NULL
                  UNION ALL
                  (
                    SELECT
                      "first_stated"."id",
                      array_agg(
                        "first_stated"."stated_key"
                        ORDER BY
                          (
                            "first_stated"."list_rank",
                            "first_stated"."key_position"
                          )
                      ) AS "entity_type_name_keys",
                      TRUE AS "queued"
                    FROM
                      (
                        SELECT DISTINCT
                          ON ("stated_list"."id", "stated_key"."stated_key") "stated_list"."id",
                          "stated_key"."stated_key",
                          "stated_list"."list_rank",
                          array_position(
                            "stated_list"."entity_type_name_keys",
                            "stated_key"."stated_key"
                          ) AS "key_position"
                        FROM
                          (
                            SELECT
                              "pv"."id" AS "id",
                              "pv"."evolution_type_name_keys" AS "entity_type_name_keys",
                              0 AS "list_rank"
                            FROM
                              "entities" AS "pv"
                            WHERE
                              "pv"."evolution_created_at" IS NOT NULL
                              AND EXISTS (
                                SELECT
                                  1
                                FROM
                                  "temporal_append_intents" AS "pt"
                                WHERE
                                  "pt"."entity_id" = "pv"."id"
                                  AND cardinality("pt"."entity_type_name_keys") > 0
                              )
                            UNION ALL
                            (
                              SELECT
                                "pt"."entity_id" AS "id",
                                "pt"."entity_type_name_keys" AS "entity_type_name_keys",
                                "pt"."intent_key" AS "list_rank"
                              FROM
                                "temporal_append_intents" AS "pt"
                              WHERE
                                cardinality("pt"."entity_type_name_keys") > 0
                            )
                          ) AS "stated_list",
                          UNNEST("stated_list"."entity_type_name_keys") AS "stated_key"
                        ORDER BY
                          "stated_list"."id" ASC,
                          "stated_key"."stated_key" ASC,
                          "stated_list"."list_rank" ASC
                      ) AS "first_stated"
                    GROUP BY
                      "first_stated"."id"
                  )
                ) AS "ru"
              WHERE
                "ru"."queued"
                OR (
                  NOT EXISTS (
                    SELECT
                      1
                    FROM
                      "temporal_append_intents" AS "pt"
                    WHERE
                      "pt"."entity_id" = "ru"."id"
                      AND cardinality("pt"."entity_type_name_keys") > 0
                  )
                )
            ) AS "e"
          WHERE
            "e"."id" IN (
              SELECT
                "id"
              FROM
                "candidates"
            )
          ORDER BY
            "id" ASC OFFSET 0
        ) AS "e"
      WHERE
        EXISTS (
          SELECT
            $6
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rsh"."recorded_at",
                "rsh"."write_id",
                "rsh"."write_ordinal",
                "rsh"."value_kind",
                "rsh"."observed_at",
                "rsh"."created_at",
                "rsh"."modified_at",
                "rsh"."deleted_at",
                "rsh"."scope_path",
                "rsh"."verbatim_scope_path"
              FROM
                "scope_history" AS "rsh"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rsh"."entity_key"
              WHERE
                "re"."id" = "e"."id"
              UNION ALL
              (
                SELECT
                  "pe"."entity_id" AS "entity_id",
                  "pe"."recorded_at" AS "recorded_at",
                  "pe"."write_id" AS "write_id",
                  "pe"."write_ordinal" AS "write_ordinal",
                  "pe"."value_kind" AS "value_kind",
                  "pe"."observed_at" AS "observed_at",
                  "pe"."created_at" AS "created_at",
                  "pe"."modified_at" AS "modified_at",
                  "pe"."deleted_at" AS "deleted_at",
                  "pe"."scope_path"::ltree AS "scope_path",
                  "pe"."verbatim_scope_path" AS "verbatim_scope_path"
                FROM
                  "temporal_append_entries" AS "pe"
                WHERE
                  "pe"."entry_kind" IN (3, 4)
                  AND (
                    EXISTS (
                      SELECT
                        1
                      FROM
                        "entities" AS "pv"
                      WHERE
                        "pv"."id" = "pe"."entity_id"
                        AND "pv"."evolution_created_at" IS NOT NULL
                    )
                    OR EXISTS (
                      SELECT
                        1
                      FROM
                        "temporal_append_intents" AS "pt"
                      WHERE
                        "pt"."entity_id" = "pe"."entity_id"
                        AND cardinality("pt"."entity_type_name_keys") > 0
                        AND (
                          "pe"."entry_kind" <> (2)
                          OR "pt"."intent_key" <= "pe"."intent_key"
                        )
                    )
                  )
                  AND (
                    NOT EXISTS (
                      SELECT
                        1
                      FROM
                        "scope_history" AS "pd"
                      WHERE
                        "pd"."recorded_at" = "pe"."recorded_at"
                        AND "pd"."write_id" = "pe"."write_id"
                        AND "pd"."write_ordinal" = "pe"."write_ordinal"
                    )
                  )
                  AND (
                    "pe"."entry_kind" <> 4
                    OR (
                      NOT (
                        (
                          (
                            ARRAY (
                              SELECT
                                "sas"."verbatim_scope_path"
                              FROM
                                (
                                  SELECT
                                    "pj"."recorded_at",
                                    "pj"."observed_at",
                                    "pj"."verbatim_scope_path"
                                  FROM
                                    "scope_history" AS "pj"
                                    JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                  WHERE
                                    "pjv"."id" = "pe"."entity_id"
                                  UNION ALL
                                  (
                                    SELECT
                                      "pq"."recorded_at" AS "recorded_at",
                                      "pq"."observed_at" AS "observed_at",
                                      "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                    FROM
                                      "temporal_append_entries" AS "pq"
                                    WHERE
                                      "pq"."entity_id" = "pe"."entity_id"
                                      AND "pq"."intent_key" < "pe"."intent_key"
                                      AND "pq"."entry_kind" IN (3, 4)
                                  )
                                ) AS "sas"
                              WHERE
                                "sas"."verbatim_scope_path" IS NOT NULL
                                AND "sas"."recorded_at" = (
                                  SELECT
                                    "sah"."recorded_at"
                                  FROM
                                    (
                                      SELECT
                                        "pj"."recorded_at",
                                        "pj"."observed_at",
                                        "pj"."verbatim_scope_path"
                                      FROM
                                        "scope_history" AS "pj"
                                        JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                      WHERE
                                        "pjv"."id" = "pe"."entity_id"
                                      UNION ALL
                                      (
                                        SELECT
                                          "pq"."recorded_at" AS "recorded_at",
                                          "pq"."observed_at" AS "observed_at",
                                          "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                        FROM
                                          "temporal_append_entries" AS "pq"
                                        WHERE
                                          "pq"."entity_id" = "pe"."entity_id"
                                          AND "pq"."intent_key" < "pe"."intent_key"
                                          AND "pq"."entry_kind" IN (3, 4)
                                      )
                                    ) AS "sah"
                                  WHERE
                                    "sah"."recorded_at" <= "pe"."recorded_at"
                                  ORDER BY
                                    "sah"."recorded_at" DESC
                                  LIMIT
                                    1
                                )
                              ORDER BY
                                ("sas"."verbatim_scope_path") COLLATE "C" ASC
                            )
                          ) COLLATE "C"
                        ) = (
                          (
                            ARRAY (
                              SELECT
                                "pa"."verbatim_scope_path"
                              FROM
                                "temporal_append_entries" AS "pa"
                              WHERE
                                "pa"."intent_key" = "pe"."intent_key"
                                AND "pa"."entry_kind" IN (4)
                              ORDER BY
                                ("pa"."verbatim_scope_path") COLLATE "C" ASC
                            )
                          ) COLLATE "C"
                        )
                        AND (
                          (
                            ARRAY (
                              SELECT
                                "sas"."verbatim_scope_path"
                              FROM
                                (
                                  SELECT
                                    "pj"."recorded_at",
                                    "pj"."observed_at",
                                    "pj"."verbatim_scope_path"
                                  FROM
                                    "scope_history" AS "pj"
                                    JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                  WHERE
                                    "pjv"."id" = "pe"."entity_id"
                                  UNION ALL
                                  (
                                    SELECT
                                      "pq"."recorded_at" AS "recorded_at",
                                      "pq"."observed_at" AS "observed_at",
                                      "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                    FROM
                                      "temporal_append_entries" AS "pq"
                                    WHERE
                                      "pq"."entity_id" = "pe"."entity_id"
                                      AND "pq"."intent_key" < "pe"."intent_key"
                                      AND "pq"."entry_kind" IN (3, 4)
                                  )
                                ) AS "sas"
                              WHERE
                                "sas"."verbatim_scope_path" IS NOT NULL
                                AND "sas"."observed_at" = (
                                  SELECT
                                    "sah"."observed_at"
                                  FROM
                                    (
                                      SELECT
                                        "pj"."recorded_at",
                                        "pj"."observed_at",
                                        "pj"."verbatim_scope_path"
                                      FROM
                                        "scope_history" AS "pj"
                                        JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                      WHERE
                                        "pjv"."id" = "pe"."entity_id"
                                      UNION ALL
                                      (
                                        SELECT
                                          "pq"."recorded_at" AS "recorded_at",
                                          "pq"."observed_at" AS "observed_at",
                                          "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                        FROM
                                          "temporal_append_entries" AS "pq"
                                        WHERE
                                          "pq"."entity_id" = "pe"."entity_id"
                                          AND "pq"."intent_key" < "pe"."intent_key"
                                          AND "pq"."entry_kind" IN (3, 4)
                                      )
                                    ) AS "sah"
                                  WHERE
                                    "sah"."observed_at" <= "pe"."recorded_at"
                                  ORDER BY
                                    "sah"."observed_at" DESC
                                  LIMIT
                                    1
                                )
                              ORDER BY
                                ("sas"."verbatim_scope_path") COLLATE "C" ASC
                            )
                          ) COLLATE "C"
                        ) = (
                          (
                            ARRAY (
                              SELECT
                                "pa"."verbatim_scope_path"
                              FROM
                                "temporal_append_entries" AS "pa"
                              WHERE
                                "pa"."intent_key" = "pe"."intent_key"
                                AND "pa"."entry_kind" IN (4)
                              ORDER BY
                                ("pa"."verbatim_scope_path") COLLATE "C" ASC
                            )
                          ) COLLATE "C"
                        )
                      )
                    )
                  )
                  AND "pe"."entity_id" = "e"."id"
              )
            ) AS "sh"
          WHERE
            "sh"."observed_at" IS NOT NULL
            AND ("sh"."scope_path" ~ ($7::lquery))
        )
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $8
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $9
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rs"."stream_key" AS "stream_key"
              FROM
                "temporal_attribute_streams" AS "rs"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
              WHERE
                "re"."id" = "e"."id"
              UNION ALL
              (
                SELECT DISTINCT
                  "pe"."entity_id" AS "entity_id",
                  "pe"."attribute_name_key" AS "attribute_name_key",
                  "pe"."dataset_key" AS "dataset_key",
                  NULL::bigint AS "stream_key"
                FROM
                  "temporal_append_entries" AS "pe"
                WHERE
                  "pe"."entry_kind" IN (1, 2)
                  AND (
