                                AND "pa"."entry_kind" IN (4)
                              ORDER BY
                                ("pa"."verbatim_scope_path") COLLATE "C" ASC
                            )
                          ) COLLATE "C"
                        )
                        AND (
                          (
                            ARRAY (
                              SELECT
                                "sas"."verbatim_scope_path"
                              FROM
                                (
                                  SELECT
                                    "pj"."recorded_at",
                                    "pj"."observed_at",
                                    "pj"."verbatim_scope_path"
                                  FROM
                                    "scope_history" AS "pj"
                                    JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                  WHERE
                                    "pjv"."id" = "pe"."entity_id"
                                  UNION ALL
                                  (
                                    SELECT
                                      "pq"."recorded_at" AS "recorded_at",
                                      "pq"."observed_at" AS "observed_at",
                                      "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                    FROM
                                      "temporal_append_entries" AS "pq"
                                    WHERE
                                      "pq"."entity_id" = "pe"."entity_id"
                                      AND "pq"."intent_key" < "pe"."intent_key"
                                      AND "pq"."entry_kind" IN (3, 4)
                                  )
                                ) AS "sas"
                              WHERE
                                "sas"."verbatim_scope_path" IS NOT NULL
                                AND "sas"."observed_at" = (
                                  SELECT
                                    "sah"."observed_at"
                                  FROM
                                    (
                                      SELECT
                                        "pj"."recorded_at",
                                        "pj"."observed_at",
                                        "pj"."verbatim_scope_path"
                                      FROM
                                        "scope_history" AS "pj"
                                        JOIN "entities" AS "pjv" ON "pjv"."entity_key" = "pj"."entity_key"
                                      WHERE
                                        "pjv"."id" = "pe"."entity_id"
                                      UNION ALL
                                      (
                                        SELECT
                                          "pq"."recorded_at" AS "recorded_at",
                                          "pq"."observed_at" AS "observed_at",
                                          "pq"."verbatim_scope_path" AS "verbatim_scope_path"
                                        FROM
                                          "temporal_append_entries" AS "pq"
                                        WHERE
                                          "pq"."entity_id" = "pe"."entity_id"
                                          AND "pq"."intent_key" < "pe"."intent_key"
                                          AND "pq"."entry_kind" IN (3, 4)
