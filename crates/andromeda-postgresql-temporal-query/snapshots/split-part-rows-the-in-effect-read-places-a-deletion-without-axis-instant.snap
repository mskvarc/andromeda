---
source: crates/andromeda-postgresql-temporal-query/src/split_part_rows.rs
---
SELECT
  "ah"."recorded_at",
  "ah"."attribute_kind",
  "ah"."value_kind",
  "ah"."observed_at",
  "ah"."created_at",
  "ah"."modified_at",
  "ah"."deleted_at",
  "ah"."generated_instance_id",
  "ah"."verbatim_instance_id",
  "ah"."value_number",
  "ah"."value_string",
  "ah"."value_language",
  "ah"."value_boolean",
  "ah"."value_geometry_members",
  "ah"."value_object",
  "ah"."value_date_time",
  "ah"."value_uri",
  "ah"."unit_code_id",
  "ah"."value_type_key",
  "ah"."value_datatype_key",
  "ah"."object_type_keys",
  "ah"."expires_at",
  "ah"."sub_attributes",
  "ah"."write_id",
  "ah"."write_ordinal",
  ST_AsEWKB("ah"."value_geometry") AS "value_geometry_ewkb",
  "an"."name" AS "attribute_name",
  "ah"."dataset_key",
  FALSE AS "stream_continues",
  "e"."id" AS "read_entity_id"
FROM
  (
    SELECT
      *
    FROM
      "entities"
    WHERE
      "entities"."evolution_created_at" IS NOT NULL
  ) AS "e"
  JOIN LATERAL (
    SELECT
      "qh".*
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rs"."stream_key" AS "stream_key"
        FROM
          "temporal_attribute_streams" AS "rs"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qs"
      JOIN LATERAL (
        SELECT
          *
        FROM
          (
            (
              SELECT
                *
              FROM
                (
                  (
                    SELECT
                      "qi".*,
                      "qi"."observed_at" AS "placed"
                    FROM
                      (
                        SELECT
                          "qs"."entity_id" AS "entity_id",
                          "qs"."attribute_name_key" AS "attribute_name_key",
                          "qs"."dataset_key" AS "dataset_key",
                          "rh"."recorded_at",
                          "rh"."write_id",
                          "rh"."write_ordinal",
                          "rh"."attribute_kind" AS "attribute_kind",
                          "rh"."value_kind" AS "value_kind",
                          "rh"."observed_at" AS "observed_at",
                          "rh"."created_at" AS "created_at",
                          "rh"."modified_at" AS "modified_at",
                          "rh"."deleted_at" AS "deleted_at",
                          "rh"."value_date_time" AS "value_date_time",
                          "rh"."expires_at" AS "expires_at",
                          "rh"."generated_instance_id" AS "generated_instance_id",
                          "rh"."value_type_key" AS "value_type_key",
                          "rh"."value_datatype_key" AS "value_datatype_key",
                          "rh"."unit_code_id" AS "unit_code_id",
                          "rh"."value_boolean" AS "value_boolean",
                          "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                          "rh"."value_number" AS "value_number",
                          "rh"."value_string" AS "value_string",
                          "rh"."value_language" AS "value_language",
                          "rh"."value_geometry" AS "value_geometry",
                          "rh"."value_geometry_valid" AS "value_geometry_valid",
                          "rh"."value_geometry_reach" AS "value_geometry_reach",
                          "rh"."value_geometry_members" AS "value_geometry_members",
                          "rh"."value_object" AS "value_object",
                          "rh"."value_uri" AS "value_uri",
                          "rh"."object_type_keys" AS "object_type_keys",
                          "rh"."sub_attributes" AS "sub_attributes"
                        FROM
                          "attribute_history" AS "rh"
                        WHERE
                          "rh"."stream_key" = "qs"."stream_key"
                      ) AS "qi"
                    WHERE
                      "qi"."observed_at" <= $1
                    ORDER BY
                      "qi"."observed_at" DESC
                  )
                  FETCH FIRST
                    1 ROW
                  WITH
                  TIES
                ) AS "qe"
              UNION ALL
              (
                SELECT
                  *
                FROM
                  (
                    (
                      SELECT
                        "qi".*,
                        "qi"."deleted_at" AS "placed"
                      FROM
                        (
                          SELECT
                            "qs"."entity_id" AS "entity_id",
                            "qs"."attribute_name_key" AS "attribute_name_key",
                            "qs"."dataset_key" AS "dataset_key",
                            "rh"."recorded_at",
                            "rh"."write_id",
                            "rh"."write_ordinal",
                            "rh"."attribute_kind" AS "attribute_kind",
                            "rh"."value_kind" AS "value_kind",
                            "rh"."observed_at" AS "observed_at",
                            "rh"."created_at" AS "created_at",
                            "rh"."modified_at" AS "modified_at",
                            "rh"."deleted_at" AS "deleted_at",
                            "rh"."value_date_time" AS "value_date_time",
                            "rh"."expires_at" AS "expires_at",
                            "rh"."generated_instance_id" AS "generated_instance_id",
                            "rh"."value_type_key" AS "value_type_key",
                            "rh"."value_datatype_key" AS "value_datatype_key",
                            "rh"."unit_code_id" AS "unit_code_id",
                            "rh"."value_boolean" AS "value_boolean",
                            "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                            "rh"."value_number" AS "value_number",
                            "rh"."value_string" AS "value_string",
                            "rh"."value_language" AS "value_language",
                            "rh"."value_geometry" AS "value_geometry",
                            "rh"."value_geometry_valid" AS "value_geometry_valid",
                            "rh"."value_geometry_reach" AS "value_geometry_reach",
                            "rh"."value_geometry_members" AS "value_geometry_members",
                            "rh"."value_object" AS "value_object",
                            "rh"."value_uri" AS "value_uri",
                            "rh"."object_type_keys" AS "object_type_keys",
                            "rh"."sub_attributes" AS "sub_attributes"
                          FROM
                            "attribute_history" AS "rh"
                          WHERE
                            "rh"."stream_key" = "qs"."stream_key"
                        ) AS "qi"
                      WHERE
                        "qi"."deleted_at" <= $2
                        AND "qi"."observed_at" IS NULL
                      ORDER BY
                        "qi"."deleted_at" DESC
                    )
                    FETCH FIRST
                      1 ROW
                    WITH
                    TIES
                  ) AS "qe"
              )
              ORDER BY
                "placed" DESC
            )
            FETCH FIRST
              1 ROW
            WITH
            TIES
          ) AS "qe"
      ) AS "qh" ON TRUE
    WHERE
      "qs"."attribute_name_key" = $3
      AND "qh"."placed" < $4
  ) AS "ah" ON TRUE
  JOIN "attribute_names" AS "an" ON "an"."attribute_name_key" = "ah"."attribute_name_key"
WHERE
  "e"."id" = $5
ORDER BY
  "e"."id" ASC
1: ChronoDateTimeUtc '2020-08-01 12:00:00.000000 +00:00'
2: ChronoDateTimeUtc '2020-08-01 12:00:00.000000 +00:00'
3: Int 7
4: ChronoDateTimeUtc '2020-08-01 12:00:00.000000 +00:00'
5: String 'urn:ngsi-ld:Vehicle:1'
