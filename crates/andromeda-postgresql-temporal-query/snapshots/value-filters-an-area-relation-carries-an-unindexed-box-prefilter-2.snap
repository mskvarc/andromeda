---
source: crates/andromeda-postgresql-temporal-query/src/value_filters.rs
---
SELECT
  $1
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
        WHERE
          "rs"."entity_key" = "e"."entity_key"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $2
      AND (
        (
          COALESCE(
            "qh"."value_geometry_reach",
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::box2d && ST_MakeValid(ST_GeomFromEWKB($3))::box2d
        )
        AND _ST_Intersects(
          COALESCE(
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          ),
          ST_MakeValid(ST_GeomFromEWKB($4))
        )
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $5
  )
1: Int 1
2: Int 2
3: Bytes '\x0103000020E61000000100000005000000F6285C8FC2F511401F85EB51B83E4A400AD7A3703D0A12401F85EB51B83E4A400AD7A3703D0A1240E17A14AE47414A40F6285C8FC2F51140E17A14AE47414A40F6285C8FC2F511401F85EB51B83E4A40'
4: Bytes '\x0103000020E61000000100000005000000F6285C8FC2F511401F85EB51B83E4A400AD7A3703D0A12401F85EB51B83E4A400AD7A3703D0A1240E17A14AE47414A40F6285C8FC2F51140E17A14AE47414A40F6285C8FC2F511401F85EB51B83E4A40'
5: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
