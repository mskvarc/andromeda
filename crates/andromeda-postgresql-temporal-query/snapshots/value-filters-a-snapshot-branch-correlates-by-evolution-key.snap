---
source: crates/andromeda-postgresql-temporal-query/src/value_filters.rs
---
SELECT
  $1
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "snap_7"."attribute_history" AS "rh"
          JOIN "snap_7"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
        WHERE
          "rs"."entity_key" = "e"."entity_key"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $2
      AND (
        "qh"."value_number" > $3
        AND "qh"."value_number" <> ('NaN'::numeric)
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $4
  )
  AND EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "rs"."entity_key" AS "entity_key",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "snap_7"."attribute_history" AS "rh"
          JOIN "snap_7"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
        WHERE
          "rs"."entity_key" = "e"."entity_key"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $5
      AND (
        (
          COALESCE(
            "qh"."value_geometry_reach",
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::box2d && ST_MakeEnvelope($6, $7, $8, $9, $10)::box2d
        )
        AND _ST_DWithin(
          COALESCE(
            "qh"."value_geometry_valid",
            "qh"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($11))::geography,
          $12
        )
      )
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" < $13
  )
  AND EXISTS (
    SELECT
      $14
    FROM
      (
        SELECT
          "rsh"."entity_key" AS "entity_key",
          "rsh"."recorded_at",
          "rsh"."write_id",
          "rsh"."write_ordinal",
          "rsh"."value_kind",
          "rsh"."observed_at",
          "rsh"."created_at",
          "rsh"."modified_at",
          "rsh"."deleted_at",
          "rsh"."scope_path",
          "rsh"."verbatim_scope_path"
        FROM
          "snap_7"."scope_history" AS "rsh"
        WHERE
          "rsh"."entity_key" = "e"."entity_key"
      ) AS "sh"
    WHERE
      "sh"."observed_at" IS NOT NULL
      AND ("sh"."scope_path" ~ ($15::lquery))
      AND "sh"."observed_at" < $16
  )
1: Int 1
2: Int 1
3: BigDecimal 99
4: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
5: Int 2
6: Double 4.4702749827517545
7: Double 52.48191161045816
8: Double 4.5297250172482455
9: Double 52.51808838954184
10: Int 4326
11: Bytes '\x0101000020E610000000000000000012400000000000404A40'
12: Double 2000
13: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
14: Int 1
15: String 'city.moved1'
16: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
