---
source: crates/andromeda-postgresql-temporal-query/src/stage1/scope_candidates.rs
---
WITH
"short_walk" AS MATERIALIZED (
  SELECT
    "e"."id" AS "entity_id"
  FROM
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
        ) AS "e"
      ORDER BY
        "e"."id" ASC
      LIMIT
        200 OFFSET 0
    ) AS "e"
  WHERE
    (
      (
        EXISTS (
          SELECT
            $1
          FROM
            (
              SELECT
                "rsh"."entity_key" AS "entity_key",
                "rsh"."recorded_at",
                "rsh"."write_id",
                "rsh"."write_ordinal",
                "rsh"."value_kind",
                "rsh"."observed_at",
                "rsh"."created_at",
                "rsh"."modified_at",
                "rsh"."deleted_at",
                "rsh"."scope_path",
                "rsh"."verbatim_scope_path"
              FROM
                "scope_history" AS "rsh"
              WHERE
                "rsh"."entity_key" = "e"."entity_key"
            ) AS "sh"
          WHERE
            "sh"."observed_at" IS NOT NULL
            AND ("sh"."scope_path" ~ ($2::lquery))
            AND "sh"."observed_at" < $3
        )
        AND EXISTS (
          SELECT
            $4
          FROM
            (
              SELECT
                "rsh"."entity_key" AS "entity_key",
                "rsh"."recorded_at",
                "rsh"."write_id",
                "rsh"."write_ordinal",
                "rsh"."value_kind",
                "rsh"."observed_at",
                "rsh"."created_at",
                "rsh"."modified_at",
                "rsh"."deleted_at",
                "rsh"."scope_path",
                "rsh"."verbatim_scope_path"
              FROM
                "scope_history" AS "rsh"
              WHERE
                "rsh"."entity_key" = "e"."entity_key"
            ) AS "sh"
          WHERE
            "sh"."observed_at" IS NOT NULL
            AND ("sh"."scope_path" ~ ($5::lquery))
            AND "sh"."observed_at" < $6
        )
      )
      OR EXISTS (
        SELECT
          $7
        FROM
          (
            SELECT
              "rsh"."entity_key" AS "entity_key",
              "rsh"."recorded_at",
              "rsh"."write_id",
              "rsh"."write_ordinal",
              "rsh"."value_kind",
              "rsh"."observed_at",
              "rsh"."created_at",
              "rsh"."modified_at",
              "rsh"."deleted_at",
              "rsh"."scope_path",
              "rsh"."verbatim_scope_path"
            FROM
              "scope_history" AS "rsh"
            WHERE
              "rsh"."entity_key" = "e"."entity_key"
          ) AS "sh"
        WHERE
          "sh"."observed_at" IS NOT NULL
          AND ("sh"."scope_path" ~ ($8::lquery))
          AND "sh"."observed_at" < $9
      )
    )
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "re"."id" AS "entity_id",
            "rs"."attribute_name_key" AS "attribute_name_key",
            "rs"."dataset_key" AS "dataset_key",
            "rh"."recorded_at",
            "rh"."write_id",
            "rh"."write_ordinal",
            "rh"."attribute_kind",
            "rh"."value_kind",
            "rh"."observed_at",
            "rh"."created_at",
            "rh"."modified_at",
            "rh"."deleted_at",
            "rh"."value_date_time",
            "rh"."expires_at",
            "rh"."generated_instance_id",
            "rh"."value_type_key",
            "rh"."value_datatype_key",
            "rh"."unit_code_id",
            "rh"."value_boolean",
            "rh"."verbatim_instance_id",
            "rh"."value_number",
            "rh"."value_string",
            "rh"."value_language",
            "rh"."value_geometry",
            "rh"."value_geometry_valid",
            "rh"."value_geometry_reach",
            "rh"."value_geometry_members",
            "rh"."value_object",
            "rh"."value_uri",
            "rh"."object_type_keys",
            "rh"."sub_attributes"
          FROM
            "attribute_history" AS "rh"
            JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
            JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        ) AS "ah"
      WHERE
        "ah"."observed_at" < $10
        AND "ah"."entity_id" = "e"."id"
    )
  ORDER BY
    "e"."id" ASC
  LIMIT
    20
),
"candidates" AS MATERIALIZED (
  SELECT
    "scope_history"."entity_key"
  FROM
    "scope_history"
  WHERE
    "scope_history"."value_kind" = (1)
    AND (
      ("scope_history"."scope_path" ~ ($11::lquery))
      OR ("scope_history"."scope_path" ~ ($12::lquery))
      OR ("scope_history"."scope_path" ~ ($13::lquery))
    )
  LIMIT
    10001
)
SELECT
  *
FROM
  (
    SELECT
      *
    FROM
      "short_walk"
    WHERE
      (
        SELECT
          COUNT(*)
        FROM
          "short_walk"
      ) >= $14
    ORDER BY
      "entity_id" ASC
    LIMIT
      20 OFFSET 0
  ) AS "answered"
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
            AND "entity_key" IN (
              SELECT
                "entity_key"
              FROM
                "candidates"
            )
          ORDER BY
            "id" ASC OFFSET 0
        ) AS "e"
      WHERE
        (
          (
            EXISTS (
              SELECT
                $15
              FROM
                (
                  SELECT
                    "rsh"."entity_key" AS "entity_key",
                    "rsh"."recorded_at",
                    "rsh"."write_id",
                    "rsh"."write_ordinal",
                    "rsh"."value_kind",
                    "rsh"."observed_at",
                    "rsh"."created_at",
                    "rsh"."modified_at",
                    "rsh"."deleted_at",
                    "rsh"."scope_path",
                    "rsh"."verbatim_scope_path"
                  FROM
                    "scope_history" AS "rsh"
                  WHERE
                    "rsh"."entity_key" = "e"."entity_key"
                ) AS "sh"
              WHERE
                "sh"."observed_at" IS NOT NULL
                AND ("sh"."scope_path" ~ ($16::lquery))
                AND "sh"."observed_at" < $17
            )
            AND EXISTS (
              SELECT
                $18
              FROM
                (
                  SELECT
                    "rsh"."entity_key" AS "entity_key",
                    "rsh"."recorded_at",
                    "rsh"."write_id",
                    "rsh"."write_ordinal",
                    "rsh"."value_kind",
                    "rsh"."observed_at",
                    "rsh"."created_at",
                    "rsh"."modified_at",
                    "rsh"."deleted_at",
                    "rsh"."scope_path",
                    "rsh"."verbatim_scope_path"
                  FROM
                    "scope_history" AS "rsh"
                  WHERE
                    "rsh"."entity_key" = "e"."entity_key"
                ) AS "sh"
              WHERE
                "sh"."observed_at" IS NOT NULL
                AND ("sh"."scope_path" ~ ($19::lquery))
                AND "sh"."observed_at" < $20
            )
          )
          OR EXISTS (
            SELECT
              $21
            FROM
              (
                SELECT
                  "rsh"."entity_key" AS "entity_key",
                  "rsh"."recorded_at",
                  "rsh"."write_id",
                  "rsh"."write_ordinal",
                  "rsh"."value_kind",
                  "rsh"."observed_at",
                  "rsh"."created_at",
                  "rsh"."modified_at",
                  "rsh"."deleted_at",
                  "rsh"."scope_path",
                  "rsh"."verbatim_scope_path"
                FROM
                  "scope_history" AS "rsh"
                WHERE
                  "rsh"."entity_key" = "e"."entity_key"
              ) AS "sh"
            WHERE
              "sh"."observed_at" IS NOT NULL
              AND ("sh"."scope_path" ~ ($22::lquery))
              AND "sh"."observed_at" < $23
          )
        )
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $24
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $25
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."observed_at" < $26
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "indexed"
)
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (1)
            AND "is_evolution_member"
        ) AS "e"
      WHERE
        (
          (
            EXISTS (
              SELECT
                $27
              FROM
                (
                  SELECT
                    "rsh"."entity_key" AS "entity_key",
                    "rsh"."recorded_at",
                    "rsh"."write_id",
                    "rsh"."write_ordinal",
                    "rsh"."value_kind",
                    "rsh"."observed_at",
                    "rsh"."created_at",
                    "rsh"."modified_at",
                    "rsh"."deleted_at",
                    "rsh"."scope_path",
                    "rsh"."verbatim_scope_path"
                  FROM
                    "scope_history" AS "rsh"
                  WHERE
                    "rsh"."entity_key" = "e"."entity_key"
                ) AS "sh"
              WHERE
                "sh"."observed_at" IS NOT NULL
                AND ("sh"."scope_path" ~ ($28::lquery))
                AND "sh"."observed_at" < $29
            )
            AND EXISTS (
              SELECT
                $30
              FROM
                (
                  SELECT
                    "rsh"."entity_key" AS "entity_key",
                    "rsh"."recorded_at",
                    "rsh"."write_id",
                    "rsh"."write_ordinal",
                    "rsh"."value_kind",
                    "rsh"."observed_at",
                    "rsh"."created_at",
                    "rsh"."modified_at",
                    "rsh"."deleted_at",
                    "rsh"."scope_path",
                    "rsh"."verbatim_scope_path"
                  FROM
                    "scope_history" AS "rsh"
                  WHERE
                    "rsh"."entity_key" = "e"."entity_key"
                ) AS "sh"
              WHERE
                "sh"."observed_at" IS NOT NULL
                AND ("sh"."scope_path" ~ ($31::lquery))
                AND "sh"."observed_at" < $32
            )
          )
          OR EXISTS (
            SELECT
              $33
            FROM
              (
                SELECT
                  "rsh"."entity_key" AS "entity_key",
                  "rsh"."recorded_at",
                  "rsh"."write_id",
                  "rsh"."write_ordinal",
                  "rsh"."value_kind",
                  "rsh"."observed_at",
                  "rsh"."created_at",
                  "rsh"."modified_at",
                  "rsh"."deleted_at",
                  "rsh"."scope_path",
                  "rsh"."verbatim_scope_path"
                FROM
                  "scope_history" AS "rsh"
                WHERE
                  "rsh"."entity_key" = "e"."entity_key"
              ) AS "sh"
            WHERE
              "sh"."observed_at" IS NOT NULL
              AND ("sh"."scope_path" ~ ($34::lquery))
              AND "sh"."observed_at" < $35
          )
        )
        AND (
          SELECT
            COUNT(*)
          FROM
            "short_walk"
        ) < $36
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $37
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
            ) AS "ah"
          WHERE
            "ah"."observed_at" < $38
            AND "ah"."entity_id" = "e"."id"
        )
      ORDER BY
        "e"."id" ASC
      LIMIT
        20 OFFSET 0
    ) AS "walk"
)
1: Int 1
2: String 'A'
