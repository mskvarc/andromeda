                                ARRAY (
                                  SELECT
                                    "sas"."verbatim_scope_path"
                                  FROM
                                    (
                                      SELECT
                                        "pj"."recorded_at",
                                        "pj"."observed_at",
                                        "pj"."verbatim_scope_path"
                                      FROM
