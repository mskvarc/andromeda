          FROM
            "short_walk"
        ) < $25
        AND (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) > $26
        AND EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "re"."id" AS "entity_id",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rs"."stream_key" AS "stream_key"
              FROM
                "temporal_attribute_streams" AS "rs"
                JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
              WHERE
                "re"."id" = "e"."id"
              UNION ALL
              (
                SELECT DISTINCT
                  "pe"."entity_id" AS "entity_id",
                  "pe"."attribute_name_key" AS "attribute_name_key",
                  "pe"."dataset_key" AS "dataset_key",
                  NULL::bigint AS "stream_key"
                FROM
                  "temporal_append_entries" AS "pe"
                WHERE
                  "pe"."entry_kind" IN (1, 2)
                  AND (
                    EXISTS (
                      SELECT
                        1
                      FROM
