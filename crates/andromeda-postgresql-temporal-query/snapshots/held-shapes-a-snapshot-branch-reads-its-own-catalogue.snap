---
source: crates/andromeda-postgresql-temporal-query/src/stage1/held_shapes.rs
---
WITH
"candidates" AS MATERIALIZED (
  WITH
  RECURSIVE "held" ("attribute_name_key", "shape_mask") AS (
    SELECT
      "step"."attribute_name_key",
      "step"."shape_mask"
    FROM
      "attribute_names" AS "an"
      JOIN LATERAL (
        SELECT
          "ms"."attribute_name_key",
          "ms"."shape_mask"
        FROM
          "snap_1"."temporal_attribute_streams" AS "ms"
        WHERE
          "ms"."attribute_name_key" = "an"."attribute_name_key"
        ORDER BY
          "ms"."shape_mask" ASC
        LIMIT
          1
      ) AS "step" ON TRUE
    WHERE
      "an"."attribute_name_key" = $1
    UNION ALL
    (
      SELECT
        "step"."attribute_name_key",
        "step"."shape_mask"
      FROM
        "held"
        JOIN LATERAL (
          SELECT
            "ms"."attribute_name_key",
            "ms"."shape_mask"
          FROM
            "snap_1"."temporal_attribute_streams" AS "ms"
          WHERE
            "ms"."attribute_name_key" = "held"."attribute_name_key"
            AND "ms"."shape_mask" > "held"."shape_mask"
          ORDER BY
            "ms"."shape_mask" ASC
          LIMIT
            1
        ) AS "step" ON TRUE
    )
  )
  SELECT
    "rs"."entity_key"
  FROM
    "held"
    JOIN "snap_1"."temporal_attribute_streams" AS "rs" ON "rs"."attribute_name_key" = "held"."attribute_name_key"
    AND "rs"."shape_mask" = "held"."shape_mask"
  WHERE
    "held"."attribute_name_key" = $2
    AND get_bit("held"."shape_mask", 1) = $3
    AND TRUE
)
SELECT
  0 AS "combination"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          *
        FROM
          (
            SELECT
              *
            FROM
              "snap_1"."entities"
            WHERE
              "entities"."evolution_created_at" IS NOT NULL
          ) AS "e"
        WHERE
          "e"."entity_key" IN (
            SELECT
              "entity_key"
            FROM
              "candidates"
          )
        ORDER BY
          "id" ASC OFFSET 0
      ) AS "e"
    WHERE
      EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "rs"."entity_key" AS "entity_key",
              "rs"."attribute_name_key" AS "attribute_name_key",
              "rs"."dataset_key" AS "dataset_key",
              "rh"."recorded_at",
              "rh"."write_id",
              "rh"."write_ordinal",
              "rh"."attribute_kind",
              "rh"."value_kind",
              "rh"."observed_at",
              "rh"."created_at",
              "rh"."modified_at",
              "rh"."deleted_at",
              "rh"."value_date_time",
              "rh"."expires_at",
              "rh"."generated_instance_id",
              "rh"."value_type_key",
              "rh"."value_datatype_key",
              "rh"."unit_code_id",
              "rh"."value_boolean",
              "rh"."verbatim_instance_id",
              "rh"."value_number",
              "rh"."value_string",
              "rh"."value_language",
              "rh"."value_geometry",
              "rh"."value_geometry_valid",
              "rh"."value_geometry_reach",
              "rh"."value_geometry_members",
              "rh"."value_object",
              "rh"."value_uri",
              "rh"."object_type_keys",
              "rh"."sub_attributes"
            FROM
              "snap_1"."attribute_history" AS "rh"
              JOIN "snap_1"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          ) AS "ah"
        WHERE
          "ah"."observed_at" >= $4
          AND "ah"."entity_key" = "e"."entity_key"
      )
      AND EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "rs"."entity_key" AS "entity_key",
              "rs"."attribute_name_key" AS "attribute_name_key",
              "rs"."dataset_key" AS "dataset_key",
              "rh"."recorded_at",
              "rh"."write_id",
              "rh"."write_ordinal",
              "rh"."attribute_kind",
              "rh"."value_kind",
              "rh"."observed_at",
              "rh"."created_at",
              "rh"."modified_at",
              "rh"."deleted_at",
              "rh"."value_date_time",
              "rh"."expires_at",
              "rh"."generated_instance_id",
              "rh"."value_type_key",
              "rh"."value_datatype_key",
              "rh"."unit_code_id",
              "rh"."value_boolean",
              "rh"."verbatim_instance_id",
              "rh"."value_number",
              "rh"."value_string",
              "rh"."value_language",
              "rh"."value_geometry",
              "rh"."value_geometry_valid",
              "rh"."value_geometry_reach",
              "rh"."value_geometry_members",
              "rh"."value_object",
              "rh"."value_uri",
              "rh"."object_type_keys",
              "rh"."sub_attributes"
            FROM
              "snap_1"."attribute_history" AS "rh"
              JOIN "snap_1"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
            WHERE
              "rs"."entity_key" = "e"."entity_key"
          ) AS "ah"
        WHERE
          "ah"."observed_at" IS NOT NULL
          AND "ah"."observed_at" >= $5
          AND TRUE
          AND "ah"."attribute_name_key" = $6
          AND "ah"."attribute_kind" = $7
          AND "ah"."value_kind" <> (0)
          AND (
            CASE
              WHEN (
                "ah"."value_kind" = (5)
                AND jsonb_typeof(
                  COALESCE(
                    (
                      CASE
                        WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value')
                      END
                    ),
                    "ah"."value_object"
                  )
                ) = ('array')
              ) THEN 6::smallint
              WHEN ("ah"."value_kind" = (5)) THEN 5::smallint
              WHEN ("ah"."value_kind" = (9)) THEN 9::smallint
              WHEN ("ah"."value_kind" = (8)) THEN 8::smallint
              WHEN ("ah"."value_kind" = (2)) THEN 2::smallint
              WHEN ("ah"."value_kind" IN (1, 10)) THEN 1::smallint
              WHEN ("ah"."value_kind" IN (3, 11)) THEN 3::smallint
              WHEN ("ah"."value_kind" = (4)) THEN 4::smallint
              WHEN ("ah"."value_kind" = (6)) THEN 7::smallint
              WHEN ("ah"."value_kind" = (7)) THEN 10::smallint
            END
          ) = $8
      )
  )
1: Int 7
2: Int 7
3: Int 1
4: ChronoDateTimeUtc '2024-01-01 00:00:00.000000 +00:00'
5: ChronoDateTimeUtc '2024-01-01 00:00:00.000000 +00:00'
6: Int 7
7: SmallInt 1
8: SmallInt 2
