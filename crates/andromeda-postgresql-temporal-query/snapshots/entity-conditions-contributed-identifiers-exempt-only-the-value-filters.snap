                                        AND "pe"."attribute_name_key" = "qs"."attribute_name_key"
                                        AND "pe"."dataset_key" = "qs"."dataset_key"
                                    ) AS "qi"
                                  WHERE
                                    "qi"."deleted_at" <= $50
                                    AND "qi"."observed_at" IS NULL
                                  ORDER BY
                                    "qi"."deleted_at" DESC
                                )
                                FETCH FIRST
                                  1 ROW
                                WITH
                                TIES
                              ) AS "qe"
                          )
                          ORDER BY
                            "placed" DESC
                        )
                        FETCH FIRST
                          1 ROW
                        WITH
                        TIES
                      ) AS "qe"
                  ) AS "qh" ON TRUE
                WHERE
                  "qs"."attribute_name_key" = $51
                  AND "qh"."placed" < $52
                  AND "qh"."attribute_name_key" = $53
                  AND (
                    "qh"."value_number" > $54
                    AND "qh"."value_number" <> ('NaN'::numeric)
                  )
                  AND "qh"."value_kind" <> (0)
              )
            )
