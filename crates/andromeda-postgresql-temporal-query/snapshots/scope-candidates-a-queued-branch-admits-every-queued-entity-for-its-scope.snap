)
UNION ALL
(
  SELECT
    *
  FROM
    (
      SELECT
        "e"."id" AS "entity_id"
      FROM
        (
          SELECT
            "ru"."id"
          FROM
            (
              SELECT
                "rw"."id",
                FALSE AS "queued"
              FROM
                (
                  SELECT
                    "entity_key",
                    "id"
                  FROM
                    "entity_type_members"
                  WHERE
                    "entity_type_name_key" = (1)
                    AND "is_evolution_member"
                  ORDER BY
                    "id" ASC
                ) AS "rw"
              UNION ALL
              (
                SELECT
                  "rq"."id",
                  TRUE AS "queued"
                FROM
                  (
                    SELECT
                      "first_stated"."id",
                      array_agg(
                        "first_stated"."stated_key"
                        ORDER BY
                          (
                            "first_stated"."list_rank",
                            "first_stated"."key_position"
                          )
                      ) AS "entity_type_name_keys"
                    FROM
                      (
                        SELECT DISTINCT
                          ON ("stated_list"."id", "stated_key"."stated_key") "stated_list"."id",
                          "stated_key"."stated_key",
                          "stated_list"."list_rank",
                          array_position(
                            "stated_list"."entity_type_name_keys",
                            "stated_key"."stated_key"
                          ) AS "key_position"
                        FROM
                          (
                            SELECT
                              "pv"."id" AS "id",
                              "pv"."evolution_type_name_keys" AS "entity_type_name_keys",
                              0 AS "list_rank"
                            FROM
                              "entities" AS "pv"
                            WHERE
                              "pv"."evolution_created_at" IS NOT NULL
                              AND EXISTS (
                                SELECT
                                  1
                                FROM
                                  "temporal_append_intents" AS "pt"
