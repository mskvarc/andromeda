---
source: crates/andromeda-postgresql-temporal-query/src/stage1/held_shapes.rs
---
WITH
"candidates" AS MATERIALIZED (
  WITH
  RECURSIVE "held" ("attribute_name_key", "shape_mask") AS (
    SELECT
      "step"."attribute_name_key",
      "step"."shape_mask"
    FROM
      "attribute_names" AS "an"
      JOIN LATERAL (
        SELECT
          "ms"."attribute_name_key",
          "ms"."shape_mask"
        FROM
          "temporal_attribute_streams" AS "ms"
        WHERE
          "ms"."attribute_name_key" = "an"."attribute_name_key"
        ORDER BY
          "ms"."shape_mask" ASC
        LIMIT
          1
      ) AS "step" ON TRUE
    WHERE
      "an"."attribute_name_key" = $1
    UNION ALL
    (
      SELECT
        "step"."attribute_name_key",
        "step"."shape_mask"
      FROM
        "held"
        JOIN LATERAL (
          SELECT
            "ms"."attribute_name_key",
            "ms"."shape_mask"
          FROM
            "temporal_attribute_streams" AS "ms"
          WHERE
            "ms"."attribute_name_key" = "held"."attribute_name_key"
            AND "ms"."shape_mask" > "held"."shape_mask"
          ORDER BY
            "ms"."shape_mask" ASC
          LIMIT
            1
        ) AS "step" ON TRUE
    )
  )
  SELECT
    "rs"."entity_key"
  FROM
    "held"
    JOIN "temporal_attribute_streams" AS "rs" ON "rs"."attribute_name_key" = "held"."attribute_name_key"
    AND "rs"."shape_mask" = "held"."shape_mask"
  WHERE
    "held"."attribute_name_key" = $2
    AND get_bit("held"."shape_mask", 1) = $3
    AND TRUE
)
SELECT
  0 AS "combination"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          *
        FROM
          (
            SELECT
              *
            FROM
              "entities"
            WHERE
              "entities"."evolution_created_at" IS NOT NULL
          ) AS "e"
        WHERE
          "e"."entity_key" IN (
            SELECT
              "entity_key"
            FROM
              "candidates"
          )
        ORDER BY
          "id" ASC OFFSET 0
      ) AS "e"
    WHERE
      (
        EXISTS (
          SELECT
            1
          FROM
            (
              SELECT
                "rs"."entity_key" AS "entity_key",
                "rs"."attribute_name_key" AS "attribute_name_key",
                "rs"."dataset_key" AS "dataset_key",
                "rh"."recorded_at",
                "rh"."write_id",
                "rh"."write_ordinal",
                "rh"."attribute_kind",
                "rh"."value_kind",
                "rh"."observed_at",
                "rh"."created_at",
                "rh"."modified_at",
                "rh"."deleted_at",
                "rh"."value_date_time",
                "rh"."expires_at",
                "rh"."generated_instance_id",
                "rh"."value_type_key",
                "rh"."value_datatype_key",
                "rh"."unit_code_id",
                "rh"."value_boolean",
                "rh"."verbatim_instance_id",
                "rh"."value_number",
                "rh"."value_string",
                "rh"."value_language",
                "rh"."value_geometry",
                "rh"."value_geometry_valid",
                "rh"."value_geometry_reach",
                "rh"."value_geometry_members",
                "rh"."value_object",
                "rh"."value_uri",
                "rh"."object_type_keys",
                "rh"."sub_attributes"
              FROM
                "attribute_history" AS "rh"
                JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
              WHERE
                "rs"."entity_key" = "e"."entity_key"
            ) AS "qh"
          WHERE
            "qh"."attribute_name_key" = $4
            AND (
              (
                "qh"."value_string" = $5
                AND nullif("qh"."value_kind" = (2), FALSE)
              )
              OR "qh"."value_uri" = $6
              OR (
                "qh"."attribute_kind" <> (6)
                AND (
                  (
                    (
                      "qh"."value_object" @> jsonb_build_array($7::text)
                    )
                    OR (
                      "qh"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $8::text))
                    )
                  )
                  AND EXISTS (
                    SELECT
                      1
                    FROM
                      jsonb_array_elements(
                        (
                          CASE
                            WHEN (jsonb_typeof("qh"."value_object") = ('array')) THEN "qh"."value_object"
                          END
                        )
                      ) AS "dm"
                      LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                        CASE
                          WHEN ("qh"."attribute_kind" IN (1, 7)) THEN "qh"."value_type_key"
                        END
                      )
                    WHERE
                      (
                        CASE
                          WHEN (
                            jsonb_typeof(
                              COALESCE("dm"."value" -> ('@value'), "dm"."value")
                            ) = ('string')
                            AND (
                              NOT COALESCE(
                                COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                  'https://uri.etsi.org/ngsi-ld/DateTime',
                                  'https://uri.etsi.org/ngsi-ld/Date',
                                  'https://uri.etsi.org/ngsi-ld/Time'
                                )
                                OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                  'http://www.w3.org/2001/XMLSchema#decimal',
                                  'http://www.w3.org/2001/XMLSchema#integer',
                                  'http://www.w3.org/2001/XMLSchema#long',
                                  'http://www.w3.org/2001/XMLSchema#int',
                                  'http://www.w3.org/2001/XMLSchema#short',
                                  'http://www.w3.org/2001/XMLSchema#byte',
                                  'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                  'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                  'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                  'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                  'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                  'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                  'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                  'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                  'http://www.w3.org/2001/XMLSchema#float',
                                  'http://www.w3.org/2001/XMLSchema#double'
                                )
                                OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                FALSE
                              )
                            )
                          ) THEN (
                            COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $9)))) AND "qh"."value_kind" <> (0) AND "qh"."observed_at" IS NOT NULL AND "qh"."observed_at" >= $10) OR "e"."id" = $11) AND EXISTS(SELECT 1 FROM (SELECT "rs"."entity_key" AS "entity_key", "rs"."attribute_name_key" AS "attribute_name_key", "rs"."dataset_key" AS "dataset_key", "rh"."recorded_at", "rh"."write_id", "rh"."write_ordinal", "rh"."attribute_kind", "rh"."value_kind", "rh"."observed_at", "rh"."created_at", "rh"."modified_at", "rh"."deleted_at", "rh"."value_date_time", "rh"."expires_at", "rh"."generated_instance_id", "rh"."value_type_key", "rh"."value_datatype_key", "rh"."unit_code_id", "rh"."value_boolean", "rh"."verbatim_instance_id", "rh"."value_number", "rh"."value_string", "rh"."value_language", "rh"."value_geometry", "rh"."value_geometry_valid", "rh"."value_geometry_reach", "rh"."value_geometry_members", "rh"."value_object", "rh"."value_uri", "rh"."object_type_keys", "rh"."sub_attributes" FROM "attribute_history" AS "rh" JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key") AS "ah" WHERE "ah"."observed_at" >= $12 AND "ah"."entity_key" = "e"."entity_key") AND EXISTS(SELECT 1 FROM (SELECT "rs"."entity_key" AS "entity_key", "rs"."attribute_name_key" AS "attribute_name_key", "rs"."dataset_key" AS "dataset_key", "rh"."recorded_at", "rh"."write_id", "rh"."write_ordinal", "rh"."attribute_kind", "rh"."value_kind", "rh"."observed_at", "rh"."created_at", "rh"."modified_at", "rh"."deleted_at", "rh"."value_date_time", "rh"."expires_at", "rh"."generated_instance_id", "rh"."value_type_key", "rh"."value_datatype_key", "rh"."unit_code_id", "rh"."value_boolean", "rh"."verbatim_instance_id", "rh"."value_number", "rh"."value_string", "rh"."value_language", "rh"."value_geometry", "rh"."value_geometry_valid", "rh"."value_geometry_reach", "rh"."value_geometry_members", "rh"."value_object", "rh"."value_uri", "rh"."object_type_keys", "rh"."sub_attributes" FROM "attribute_history" AS "rh" JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key" WHERE "rs"."entity_key" = "e"."entity_key") AS "ah" WHERE "ah"."observed_at" IS NOT NULL AND "ah"."observed_at" >= $13 AND TRUE AND ("ah"."attribute_name_key" <> $14 OR ("ah"."attribute_name_key" = $15 AND EXISTS(SELECT 1 FROM (SELECT "rs"."entity_key" AS "entity_key", "rs"."attribute_name_key" AS "attribute_name_key", "rs"."dataset_key" AS "dataset_key", "rh"."recorded_at", "rh"."write_id", "rh"."write_ordinal", "rh"."attribute_kind", "rh"."value_kind", "rh"."observed_at", "rh"."created_at", "rh"."modified_at", "rh"."deleted_at", "rh"."value_date_time", "rh"."expires_at", "rh"."generated_instance_id", "rh"."value_type_key", "rh"."value_datatype_key", "rh"."unit_code_id", "rh"."value_boolean", "rh"."verbatim_instance_id", "rh"."value_number", "rh"."value_string", "rh"."value_language", "rh"."value_geometry", "rh"."value_geometry_valid", "rh"."value_geometry_reach", "rh"."value_geometry_members", "rh"."value_object", "rh"."value_uri", "rh"."object_type_keys", "rh"."sub_attributes" FROM "attribute_history" AS "rh" JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key" WHERE "rs"."entity_key" = "e"."entity_key") AS "qh" WHERE "qh"."attribute_name_key" = $16 AND "qh"."dataset_key" = "ah"."dataset_key" AND "qh"."observed_at" = "ah"."observed_at" AND "qh"."recorded_at" = "ah"."recorded_at" AND "qh"."write_id" = "ah"."write_id" AND "qh"."write_ordinal" = "ah"."write_ordinal" AND (("qh"."value_string" = $17 AND nullif("qh"."value_kind" = (2), FALSE)) OR "qh"."value_uri" = $18 OR ("qh"."attribute_kind" <> (6) AND ((("qh"."value_object" @> jsonb_build_array($19::text)) OR ("qh"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $20::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("qh"."value_object") = ('array')) THEN "qh"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("qh"."attribute_kind" IN (1, 7)) THEN "qh"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $21)))) AND "qh"."value_kind" <> (0) AND "qh"."observed_at" IS NOT NULL AND "qh"."observed_at" >= $22)) OR "e"."id" = $23) AND "ah"."attribute_name_key" = $24 AND "ah"."attribute_kind" = $25 AND "ah"."value_kind" <> (0) AND (CASE WHEN ("ah"."value_kind" = (5) AND jsonb_typeof(COALESCE((CASE WHEN (("ah"."value_object" ->> ('@type')) = ('@json')) THEN "ah"."value_object" -> ('@value') END), "ah"."value_object")) = ('array')) THEN 6::smallint WHEN ("ah"."value_kind" = (5)) THEN 5::smallint WHEN ("ah"."value_kind" = (9)) THEN 9::smallint WHEN ("ah"."value_kind" = (8)) THEN 8::smallint WHEN ("ah"."value_kind" = (2)) THEN 2::smallint WHEN ("ah"."value_kind" IN (1, 10)) THEN 1::smallint WHEN ("ah"."value_kind" IN (3, 11)) THEN 3::smallint WHEN ("ah"."value_kind" = (4)) THEN 4::smallint WHEN ("ah"."value_kind" = (6)) THEN 7::smallint WHEN ("ah"."value_kind" = (7)) THEN 10::smallint END) = $26))
