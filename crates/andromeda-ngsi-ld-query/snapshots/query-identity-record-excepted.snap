{"entities":{"excepted":[{"type":"https://example.com/Bus"},{"type":"https://example.com/Car"},{"type":"https://example.com/Truck"}]},"attrs":["https://example.com/brand","https://example.com/speed"],"q":{"any":[{"all":[{"term":{"hops":[],"attribute":"https://example.com/brand","sub_attributes":[],"terminal":"own-value","test":{"value":{"test":{"equals-any":[{"text":"x"},{"text":"y"}]},"polarity":"asserted"}}}},{"term":{"hops":[],"attribute":"https://example.com/speed","sub_attributes":[],"terminal":"own-value","test":{"value":{"test":{"ordered":{"relation":"greater","operand":{"number":50}}},"polarity":"asserted"}}}}]},{"term":{"hops":[],"attribute":"https://example.com/seen","sub_attributes":[],"terminal":"own-value","test":{"value":{"test":{"equals-any":[{"date-time":"2024-01-01T00:00:00Z"}]},"polarity":"asserted"}}}}]},"geo":{"georel":"within","geometry":{"type":"Polygon","coordinates":[[[0,0],[1,0],[1,1],[0,1],[0,0]]]},"geoproperty":"https://uri.etsi.org/ngsi-ld/location"},"scope_q":"/Madrid/#","csf":{"term":{"hops":[],"attribute":"https://example.com/tier","sub_attributes":[],"terminal":"own-value","test":{"value":{"test":{"equals-any":[{"text":"gold"}]},"polarity":"asserted"}}}},"members":{"any-of":{"attributes":["https://example.com/speed"],"scope":"removed"}}}
