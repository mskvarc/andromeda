---
source: crates/andromeda-postgresql-query/src/q_predicate/projection.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        ("ca"."value_string" !~ $2)
        OR (
          (("ca"."value_long_text") COLLATE "default") !~ $3
        )
        OR (
          EXISTS (
            SELECT
              1
            FROM
              jsonb_array_elements(
                (
                  CASE
                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                  END
                )
              ) AS "ls"
          )
          AND (
            NOT EXISTS (
              SELECT
                1
              FROM
                jsonb_array_elements(
                  (
                    CASE
                      WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                    END
                  )
                ) AS "ls"
              WHERE
                ("ls"."value" ->> ('@value')) ~ $4
            )
          )
        )
      )
      AND "ca"."entity_key" = "entities"."entity_key"
  )
1: Int 14
2: String '^A.*'
3: String '^A.*'
4: String '^A.*'
