---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            ("j" -> ('value')) IS NOT NULL
            OR ("j" ->> ('type')) IN (
              'Property',
              'Relationship',
              'GeoProperty',
              'VocabProperty',
              'LanguageProperty',
              'JsonProperty',
              'ListProperty',
              'ListRelationship'
            )
          ) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('color') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    NOT COALESCE(
      EXISTS (
        SELECT
          1
        FROM
          jsonb_path_query(
            (
              SELECT
                (
                  CASE
                    WHEN (
                      ("j" -> ('value')) IS NOT NULL
                      OR ("j" ->> ('type')) IN (
                        'Property',
                        'Relationship',
                        'GeoProperty',
                        'VocabProperty',
                        'LanguageProperty',
                        'JsonProperty',
                        'ListProperty',
                        'ListRelationship'
                      )
                    ) THEN "j" -> ('value')
                    ELSE "j"
                  END
                )
              FROM
                (
                  SELECT
                    "context_source_properties" -> ('color') AS "j"
                ) AS "s"
            ),
            '$[*]'
          ) AS "element"
        WHERE
          (
            CASE
              WHEN (
                jsonb_typeof("element"."element") = ('string')
                AND (
                  NOT COALESCE(
                    (NULL::text) IN (
                      'https://uri.etsi.org/ngsi-ld/DateTime',
                      'https://uri.etsi.org/ngsi-ld/Date',
                      'https://uri.etsi.org/ngsi-ld/Time'
                    )
                    OR (NULL::text) IN (
                      'http://www.w3.org/2001/XMLSchema#decimal',
                      'http://www.w3.org/2001/XMLSchema#integer',
                      'http://www.w3.org/2001/XMLSchema#long',
                      'http://www.w3.org/2001/XMLSchema#int',
                      'http://www.w3.org/2001/XMLSchema#short',
                      'http://www.w3.org/2001/XMLSchema#byte',
                      'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                      'http://www.w3.org/2001/XMLSchema#positiveInteger',
                      'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                      'http://www.w3.org/2001/XMLSchema#negativeInteger',
                      'http://www.w3.org/2001/XMLSchema#unsignedLong',
                      'http://www.w3.org/2001/XMLSchema#unsignedInt',
                      'http://www.w3.org/2001/XMLSchema#unsignedShort',
                      'http://www.w3.org/2001/XMLSchema#unsignedByte',
                      'http://www.w3.org/2001/XMLSchema#float',
                      'http://www.w3.org/2001/XMLSchema#double'
                    )
                    OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                    FALSE
                  )
                )
              ) THEN (
                "element"."element" #>> ('{}'))::text END) = $1 OR (CASE WHEN (jsonb_typeof("element"."element") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN ("element"."element" #>> ('{}'))::text END) = $2), FALSE))
1: String 'blue'
2: String 'red'
