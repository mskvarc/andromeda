---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            jsonb_typeof(
              (
                CASE
                  WHEN (
                    ("j" -> ('value')) IS NOT NULL
                    OR ("j" ->> ('type')) IN (
                      'Property',
                      'Relationship',
                      'GeoProperty',
                      'VocabProperty',
                      'LanguageProperty',
                      'JsonProperty',
                      'ListProperty',
                      'ListRelationship'
                    )
                  ) THEN "j" -> ('value')
                  ELSE "j"
                END
              )
            ) = ('string')
          ) THEN (
            CASE
              WHEN (
                ("j" -> ('value')) IS NOT NULL
                OR ("j" ->> ('type')) IN (
                  'Property',
                  'Relationship',
                  'GeoProperty',
                  'VocabProperty',
                  'LanguageProperty',
                  'JsonProperty',
                  'ListProperty',
                  'ListRelationship'
                )
              ) THEN "j" -> ('value')
              ELSE "j"
            END
          )
        END
      )
    FROM
      (
        SELECT
          (
            SELECT
              (
                CASE
                  WHEN (
                    ("j" -> ('value')) IS NOT NULL
                    OR ("j" ->> ('type')) IN (
                      'Property',
                      'Relationship',
                      'GeoProperty',
                      'VocabProperty',
                      'LanguageProperty',
                      'JsonProperty',
                      'ListProperty',
                      'ListRelationship'
                    )
                  ) THEN "j" -> ('observedAt')
                END
              )
            FROM
              (
                SELECT
                  "context_source_properties" -> ('a') AS "j"
              ) AS "s"
          ) AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    CASE
      WHEN (
        (
          CASE
            WHEN (
              (
                (
                  (
                    SELECT
                      (
                        CASE
                          WHEN (
                            jsonb_typeof(
                              (
                                CASE
                                  WHEN (
                                    ("j" -> ('value')) IS NOT NULL
                                    OR ("j" ->> ('type')) IN (
                                      'Property',
                                      'Relationship',
                                      'GeoProperty',
                                      'VocabProperty',
                                      'LanguageProperty',
                                      'JsonProperty',
                                      'ListProperty',
                                      'ListRelationship'
                                    )
                                  ) THEN "j" -> ('value')
                                  ELSE "j"
                                END
                              )
                            ) = ('string')
                          ) THEN (
                            CASE
                              WHEN (
                                ("j" -> ('value')) IS NOT NULL
                                OR ("j" ->> ('type')) IN (
                                  'Property',
                                  'Relationship',
                                  'GeoProperty',
                                  'VocabProperty',
                                  'LanguageProperty',
                                  'JsonProperty',
                                  'ListProperty',
                                  'ListRelationship'
                                )
                              ) THEN "j" -> ('value')
                              ELSE "j"
                            END
                          )
                        END
                      )
                    FROM
                      (
                        SELECT
                          (
                            SELECT
                              (
                                CASE
                                  WHEN (
                                    ("j" -> ('value')) IS NOT NULL
                                    OR ("j" ->> ('type')) IN (
                                      'Property',
                                      'Relationship',
                                      'GeoProperty',
                                      'VocabProperty',
                                      'LanguageProperty',
                                      'JsonProperty',
                                      'ListProperty',
                                      'ListRelationship'
                                    )
                                  ) THEN "j" -> ('observedAt')
                                END
                              )
                            FROM
                              (
                                SELECT
                                  "context_source_properties" -> ('a') AS "j"
                              ) AS "s"
                          ) AS "j"
                      ) AS "s"
                  ) #>> ('{}')) ~ ('^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.,][0-9]{1,6})?Z$')) AND pg_input_is_valid(translate((SELECT (CASE WHEN (jsonb_typeof((CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END)) = ('string')) THEN (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) END) FROM (SELECT (SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('observedAt') END) FROM (SELECT "context_source_properties" -> ('a') AS "j") AS "s") AS "j") AS "s") #>> ('{}'), ',', '.'), 'timestamptz')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' END) = ('https://uri.etsi.org/ngsi-ld/DateTime') AND pg_input_is_valid(to_jsonb(translate((SELECT (CASE WHEN (jsonb_typeof((CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END)) = ('string')) THEN (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) END) FROM (SELECT (SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('observedAt') END) FROM (SELECT "context_source_properties" -> ('a') AS "j") AS "s") AS "j") AS "s") #>> ('{}'), ',', '.')) #>> ('{}'), 'timestamptz')) THEN (to_jsonb(translate((SELECT (CASE WHEN (jsonb_typeof((CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END)) = ('string')) THEN (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) END) FROM (SELECT (SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('observedAt') END) FROM (SELECT "context_source_properties" -> ('a') AS "j") AS "s") AS "j") AS "s") #>> ('{}'), ',', '.')) #>> ('{}'))::timestamptz END) > $1
1: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
