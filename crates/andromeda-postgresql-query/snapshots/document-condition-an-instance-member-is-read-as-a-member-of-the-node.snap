---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            jsonb_typeof(COALESCE("j" -> ('value'), "j")) = ('string')
          ) THEN COALESCE("j" -> ('value'), "j")
        END
      )
    FROM
      (
        SELECT
          ("context_source_properties" -> ('a')) -> ('https://uri.etsi.org/ngsi-ld/observedAt') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    CASE
      WHEN (
        (
          CASE
            WHEN (
              pg_input_is_valid(
                (
                  SELECT
                    (
                      CASE
                        WHEN (
                          jsonb_typeof(COALESCE("j" -> ('value'), "j")) = ('string')
                        ) THEN COALESCE("j" -> ('value'), "j")
                      END
                    )
                  FROM
                    (
                      SELECT
                        ("context_source_properties" -> ('a')) -> ('https://uri.etsi.org/ngsi-ld/observedAt') AS "j"
                    ) AS "s"
                ) #>> ('{}'), 'timestamptz')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' END) = ('https://uri.etsi.org/ngsi-ld/DateTime') AND pg_input_is_valid((SELECT (CASE WHEN (jsonb_typeof(COALESCE("j" -> ('value'), "j")) = ('string')) THEN COALESCE("j" -> ('value'), "j") END) FROM (SELECT ("context_source_properties" -> ('a')) -> ('https://uri.etsi.org/ngsi-ld/observedAt') AS "j") AS "s") #>> ('{}'), 'timestamptz')) THEN ((SELECT (CASE WHEN (jsonb_typeof(COALESCE("j" -> ('value'), "j")) = ('string')) THEN COALESCE("j" -> ('value'), "j") END) FROM (SELECT ("context_source_properties" -> ('a')) -> ('https://uri.etsi.org/ngsi-ld/observedAt') AS "j") AS "s") #>> ('{}'))::timestamptz END) > $1
1: ChronoDateTimeUtc '2030-01-01 00:00:00.000000 +00:00'
