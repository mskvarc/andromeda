SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        (
          EXISTS (
            SELECT
              1
            FROM
              jsonb_array_elements(
                (
                  CASE
                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                  END
                )
              ) AS "ls"
          )
          AND (
            NOT COALESCE(
              EXISTS (
                SELECT
                  1
                FROM
                  jsonb_array_elements(
                    (
                      CASE
                        WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                      END
                    )
                  ) AS "ls"
                WHERE
                  LOWER(("ls"."value" ->> ('@language')) COLLATE "C") = LOWER(($2::text) COLLATE "C")
                  AND (("ls"."value" ->> ('@value')) ~ $3)
              ),
              FALSE
            )
          )
        )
        OR (
          (
            "ca"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
            AND EXISTS (
              SELECT
                1
              FROM
                (
                  SELECT
                    jsonb_path_query_array(
                      "member"."member",
                      'lax $[*] ? (exists(@."@value"))'
                    ) AS "member"
                  FROM
                    jsonb_path_query("ca"."value_object", 'strict $."en"', '{}', TRUE) AS "member"
                ) AS "member"
              WHERE
                jsonb_array_length("member"."member") = (1)
                AND (
                  (("member"."member" -> (0)) -> ('@value')) IS NOT NULL
                  AND (
                    jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('string')
                    AND (
                      NOT COALESCE(
                        (("member"."member" -> (0)) ->> ('@type')) IN (
                          'https://uri.etsi.org/ngsi-ld/DateTime',
                          'https://uri.etsi.org/ngsi-ld/Date',
                          'https://uri.etsi.org/ngsi-ld/Time'
                        )
                        OR (("member"."member" -> (0)) ->> ('@type')) IN (
                          'http://www.w3.org/2001/XMLSchema#decimal',
                          'http://www.w3.org/2001/XMLSchema#integer',
                          'http://www.w3.org/2001/XMLSchema#long',
                          'http://www.w3.org/2001/XMLSchema#int',
                          'http://www.w3.org/2001/XMLSchema#short',
                          'http://www.w3.org/2001/XMLSchema#byte',
                          'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                          'http://www.w3.org/2001/XMLSchema#positiveInteger',
                          'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                          'http://www.w3.org/2001/XMLSchema#negativeInteger',
                          'http://www.w3.org/2001/XMLSchema#unsignedLong',
                          'http://www.w3.org/2001/XMLSchema#unsignedInt',
                          'http://www.w3.org/2001/XMLSchema#unsignedShort',
                          'http://www.w3.org/2001/XMLSchema#unsignedByte',
                          'http://www.w3.org/2001/XMLSchema#float',
                          'http://www.w3.org/2001/XMLSchema#double'
                        )
                        OR (("member"."member" -> (0)) ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                        FALSE
                      )
                    )
                  )
                )
                AND (
                  NOT COALESCE(
                    jsonb_array_length("member"."member") = (1)
                    AND (
                      (("member"."member" -> (0)) -> ('@value')) IS NOT NULL
                      AND (
                        jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('string')
                        AND (
                          NOT COALESCE(
                            (("member"."member" -> (0)) ->> ('@type')) IN (
                              'https://uri.etsi.org/ngsi-ld/DateTime',
                              'https://uri.etsi.org/ngsi-ld/Date',
                              'https://uri.etsi.org/ngsi-ld/Time'
                            )
                            OR (("member"."member" -> (0)) ->> ('@type')) IN (
                              'http://www.w3.org/2001/XMLSchema#decimal',
                              'http://www.w3.org/2001/XMLSchema#integer',
                              'http://www.w3.org/2001/XMLSchema#long',
                              'http://www.w3.org/2001/XMLSchema#int',
                              'http://www.w3.org/2001/XMLSchema#short',
                              'http://www.w3.org/2001/XMLSchema#byte',
                              'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                              'http://www.w3.org/2001/XMLSchema#positiveInteger',
                              'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                              'http://www.w3.org/2001/XMLSchema#negativeInteger',
                              'http://www.w3.org/2001/XMLSchema#unsignedLong',
                              'http://www.w3.org/2001/XMLSchema#unsignedInt',
                              'http://www.w3.org/2001/XMLSchema#unsignedShort',
                              'http://www.w3.org/2001/XMLSchema#unsignedByte',
                              'http://www.w3.org/2001/XMLSchema#float',
                              'http://www.w3.org/2001/XMLSchema#double'
                            )
                            OR (("member"."member" -> (0)) ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                            FALSE
                          )
                        )
                      )
                      AND (
                        (
                          (
                            (("member"."member" -> (0)) -> ('@value')) #>> ('{}'))::text) ~ $4)), FALSE)))) OR ("ca"."attribute_kind" = (6) AND EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query("ca"."value_object", 'strict $."en"', '{}', TRUE) AS "member") AS "member" WHERE (NOT jsonb_typeof("member"."member") = ('array')) AND ("member"."member" IS NOT NULL AND (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE)))) AND (NOT COALESCE((NOT jsonb_typeof("member"."member") = ('array')) AND ("member"."member" IS NOT NULL AND (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) AND ((("member"."member" #>> ('{}'))::text) ~ $5)), FALSE)))) OR ("ca"."attribute_kind" IN (3) AND EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query(ST_AsGeoJSON("ca"."value_geometry", 15)::jsonb, 'strict $."en"', '{}', TRUE) AS "member") AS "member" WHERE (NOT jsonb_typeof("member"."member") = ('array')) AND ("member"."member" IS NOT NULL AND (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE)))) AND (NOT COALESCE((NOT jsonb_typeof("member"."member") = ('array')) AND ("member"."member" IS NOT NULL AND (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) AND ((("member"."member" #>> ('{}'))::text) ~ $6)), FALSE)))))) AND "ca"."entity_key" = "entities"."entity_key")
