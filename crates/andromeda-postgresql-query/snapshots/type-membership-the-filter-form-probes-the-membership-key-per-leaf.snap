---
source: crates/andromeda-postgresql-query/src/type_membership.rs
---
SELECT
  $1
WHERE
  (
    EXISTS (
      SELECT
        1
      FROM
        "entity_type_members" AS "type_member"
      WHERE
        "type_member"."entity_type_name_key" = (1)
        AND "type_member"."id" = "selected"."id"
        AND "type_member"."is_current_member"
    )
    AND EXISTS (
      SELECT
        1
      FROM
        "entity_type_members" AS "type_member"
      WHERE
        "type_member"."entity_type_name_key" = (2)
        AND "type_member"."id" = "selected"."id"
        AND "type_member"."is_current_member"
    )
  )
  OR (FALSE)
1: Int 1
