---
source: crates/andromeda-postgresql-query/src/history_source/attribute_rows.rs
---
SELECT
  *
FROM
  (
    SELECT
      "rs"."entity_key" AS "entity_key",
      "rs"."attribute_name_key" AS "attribute_name_key",
      "rs"."dataset_key" AS "dataset_key",
      "rh"."recorded_at",
      "rh"."write_id",
      "rh"."write_ordinal",
      "rh"."attribute_kind",
      "rh"."value_kind",
      "rh"."observed_at",
      "rh"."created_at",
      "rh"."modified_at",
      "rh"."deleted_at",
      "rh"."value_date_time",
      "rh"."expires_at",
      "rh"."generated_instance_id",
      "rh"."value_type_key",
      "rh"."value_datatype_key",
      "rh"."unit_code_id",
      "rh"."value_boolean",
      "rh"."verbatim_instance_id",
      "rh"."value_number",
      "rh"."value_string",
      "rh"."value_language",
      "rh"."value_geometry",
      "rh"."value_geometry_valid",
      "rh"."value_geometry_reach",
      "rh"."value_geometry_members",
      "rh"."value_object",
      "rh"."value_uri",
      "rh"."object_type_keys",
      "rh"."sub_attributes"
    FROM
      "snap_1"."attribute_history" AS "rh"
      JOIN "snap_1"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
    WHERE
      "rs"."entity_key" = "e"."entity_key"
  ) AS "ah"
