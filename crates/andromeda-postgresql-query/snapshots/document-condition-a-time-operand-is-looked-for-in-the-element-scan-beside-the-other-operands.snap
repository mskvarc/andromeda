---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            ("j" -> ('value')) IS NOT NULL
            OR ("j" ->> ('type')) IN (
              'Property',
              'Relationship',
              'GeoProperty',
              'VocabProperty',
              'LanguageProperty',
              'JsonProperty',
              'ListProperty',
              'ListRelationship'
            )
          ) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('since') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND EXISTS (
    SELECT
      1
    FROM
      jsonb_path_query(
        (
          SELECT
            (
              CASE
                WHEN (
                  ("j" -> ('value')) IS NOT NULL
                  OR ("j" ->> ('type')) IN (
                    'Property',
                    'Relationship',
                    'GeoProperty',
                    'VocabProperty',
                    'LanguageProperty',
                    'JsonProperty',
                    'ListProperty',
                    'ListRelationship'
                  )
                ) THEN "j" -> ('value')
                ELSE "j"
              END
            )
          FROM
            (
              SELECT
                "context_source_properties" -> ('since') AS "j"
            ) AS "s"
        ),
        '$[*]'
      ) AS "element"
    WHERE
      (
        CASE
          WHEN (
            jsonb_typeof("element"."element") = ('string')
            AND (
              NOT COALESCE(
                (NULL::text) IN (
                  'https://uri.etsi.org/ngsi-ld/DateTime',
                  'https://uri.etsi.org/ngsi-ld/Date',
                  'https://uri.etsi.org/ngsi-ld/Time'
                )
                OR (NULL::text) IN (
                  'http://www.w3.org/2001/XMLSchema#decimal',
                  'http://www.w3.org/2001/XMLSchema#integer',
                  'http://www.w3.org/2001/XMLSchema#long',
                  'http://www.w3.org/2001/XMLSchema#int',
                  'http://www.w3.org/2001/XMLSchema#short',
                  'http://www.w3.org/2001/XMLSchema#byte',
                  'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                  'http://www.w3.org/2001/XMLSchema#positiveInteger',
                  'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                  'http://www.w3.org/2001/XMLSchema#negativeInteger',
                  'http://www.w3.org/2001/XMLSchema#unsignedLong',
                  'http://www.w3.org/2001/XMLSchema#unsignedInt',
                  'http://www.w3.org/2001/XMLSchema#unsignedShort',
                  'http://www.w3.org/2001/XMLSchema#unsignedByte',
                  'http://www.w3.org/2001/XMLSchema#float',
                  'http://www.w3.org/2001/XMLSchema#double'
                )
                OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                FALSE
              )
            )
          ) THEN (
            "element"."element" #>> ('{}'))::text END) = $1 OR (CASE WHEN ((CASE WHEN (("element"."element" ->> ('@type')) IN ('DateTime', 'https://uri.etsi.org/ngsi-ld/DateTime') AND (((("element"."element" -> ('@value')) #>> ('{}')) ~ ('^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.,][0-9]{1,6})?Z$')) AND pg_input_is_valid(regexp_replace(translate(("element"."element" -> ('@value')) #>> ('{}'), ',', '.'), '^0000(.*)$', E'0001\\1 BC'), 'timestamptz'))) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' END) = ('https://uri.etsi.org/ngsi-ld/DateTime') AND pg_input_is_valid(regexp_replace(to_jsonb(translate(("element"."element" -> ('@value')) #>> ('{}'), ',', '.')) #>> ('{}'), '^0000(.*)$', E'0001\\1 BC'), 'timestamptz')) THEN (regexp_replace(to_jsonb(translate(("element"."element" -> ('@value')) #>> ('{}'), ',', '.')) #>> ('{}'), '^0000(.*)$', E'0001\\1 BC'))::timestamptz END) = $2)
1: String 'x'
2: ChronoDateTimeUtc '2024-01-01 00:00:00.000000 +00:00'
