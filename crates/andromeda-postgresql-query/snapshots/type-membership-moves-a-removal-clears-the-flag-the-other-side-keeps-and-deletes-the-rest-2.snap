---
source: crates/andromeda-postgresql-query/src/type_membership_moves.rs
---
DELETE FROM
  "entity_type_members"
WHERE
  ("entity_type_name_key", "id") IN (
    SELECT
      "carried"."entity_type_name_key",
      "written"."id"
    FROM
      "written"
      INNER JOIN LATERAL (
        SELECT
          UNNEST("written"."old_types") AS "entity_type_name_key"
      ) AS "carried" ON TRUE
    WHERE
      NOT "carried"."entity_type_name_key" = ANY("written"."new_types")
  )
  AND (NOT "is_evolution_member")
