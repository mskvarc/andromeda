---
source: crates/andromeda-postgresql-query/src/q_predicate/structured_target.rs
---
SELECT
  1
WHERE
  "attribute_kind" <> (6)
  AND (
    (
      ("value_object" @> jsonb_build_array($1::numeric))
      OR (
        "value_object" @> jsonb_build_array(jsonb_build_object('@value', $2::numeric))
      )
      OR ("value_object" @> jsonb_build_array($3::text))
      OR (
        "value_object" @> jsonb_build_array(jsonb_build_object('@value', $4::text))
      )
      OR ("value_object" @> jsonb_build_array($5::text))
      OR (
        "value_object" @> jsonb_build_array(jsonb_build_object('@value', $6::text))
      )
    )
    AND EXISTS (
      SELECT
        1
      FROM
        jsonb_array_elements(
          (
            CASE
              WHEN (jsonb_typeof("value_object") = ('array')) THEN "value_object"
            END
          )
        ) AS "dm"
        LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
          CASE
            WHEN ("attribute_kind" IN (1, 7)) THEN "value_type_key"
          END
        )
      WHERE
        (
          CASE
            WHEN (
              jsonb_typeof(
                COALESCE("dm"."value" -> ('@value'), "dm"."value")
              ) = ('number')
            ) THEN (
              COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}')) <> ('NaN') AND pg_input_is_valid(COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'), 'numeric')) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric END) = $7))
1: BigDecimal 1E-7
2: BigDecimal 1E-7
3: String '0.0000001'
4: String '0.0000001'
5: String '1E-7'
6: String '1E-7'
7: BigDecimal 1E-7
