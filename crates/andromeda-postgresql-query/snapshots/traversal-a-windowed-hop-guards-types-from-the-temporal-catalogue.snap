---
source: crates/andromeda-postgresql-query/src/q_predicate/traversal.rs
---
SELECT
  $1
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "attribute_history" AS "rh"
          JOIN "temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          JOIN "entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qh_ln1"
      JOIN jsonb_array_elements_text(
        COALESCE(
          "qh_ln1"."value_object",
          jsonb_build_array("qh_ln1"."value_uri")
        )
      ) AS "lo1" ON TRUE
      JOIN (
        SELECT
          *
        FROM
          "entities"
        WHERE
          "entities"."evolution_created_at" IS NOT NULL
      ) AS "le1" ON "le1"."id" = "lo1"
    WHERE
      "qh_ln1"."attribute_name_key" = $2
      AND "qh_ln1"."value_kind" <> (0)
      AND "qh_ln1"."observed_at" IS NOT NULL
      AND "qh_ln1"."observed_at" >= $3
      AND "qh_ln1"."attribute_kind" IN (2, 8)
      AND ("le1"."evolution_type_name_keys" @> (ARRAY[3]))
  )
1: Int 1
2: Int 4
3: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
