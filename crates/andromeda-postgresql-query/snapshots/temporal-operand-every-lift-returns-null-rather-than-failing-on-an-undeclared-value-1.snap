---
source: crates/andromeda-postgresql-query/src/temporal_operand.rs
---
SELECT
  (
    CASE
      WHEN (
        "datatype" = ('https://uri.etsi.org/ngsi-ld/DateTime')
        AND pg_input_is_valid(
          regexp_replace("text", '^0000(.*)$', E'0001\\1 BC'),
          'timestamptz'
        )
      ) THEN (
        regexp_replace("text", '^0000(.*)$', E'0001\\1 BC')
      )::timestamptz
    END
  )
