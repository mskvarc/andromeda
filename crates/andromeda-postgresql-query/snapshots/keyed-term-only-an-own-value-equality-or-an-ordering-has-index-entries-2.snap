---
source: crates/andromeda-postgresql-query/src/q_predicate/keyed_term.rs
---
SELECT
  *
FROM
  (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."value_number" >= $2
        AND "ca"."value_number" <> ('NaN'::numeric)
        AND "ca"."value_number" <= $3
      )
  ) AS "matches"
1: Int 9
2: BigDecimal 1
3: BigDecimal 5
