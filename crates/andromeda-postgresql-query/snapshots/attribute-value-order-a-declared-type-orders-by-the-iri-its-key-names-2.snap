---
source: crates/andromeda-postgresql-query/src/ordering/attribute_value_order.rs
---
SELECT
  NULL::numeric AS "value_number",
  NULL::boolean AS "value_boolean",
  NULL::timestamptz AS "value_date_time",
  (
    CASE
      WHEN (cardinality("ordered"."object_type_keys") = (1)) THEN (
        SELECT
          "mt"."name"
        FROM
          "entity_type_names" AS "mt"
        WHERE
          "mt"."entity_type_name_key" = (("ordered"."object_type_keys")[1])
      )
    END
  ) AS "value_text",
  NULL::text AS "value_declared_datatype",
  NULL::jsonb AS "value_object",
  (
    CASE
      WHEN ((NULL::numeric) IS NOT NULL) THEN 'number'
      WHEN ((NULL::boolean) IS NOT NULL) THEN 'boolean'
      WHEN ((NULL::timestamptz) IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime'
      WHEN (
        (NULL::text) = ('https://uri.etsi.org/ngsi-ld/DateTime')
      ) THEN 'https://uri.etsi.org/ngsi-ld/DateTime'
      WHEN (
        (NULL::text) = ('https://uri.etsi.org/ngsi-ld/Date')
      ) THEN 'https://uri.etsi.org/ngsi-ld/Date'
      WHEN (
        (NULL::text) = ('https://uri.etsi.org/ngsi-ld/Time')
      ) THEN 'https://uri.etsi.org/ngsi-ld/Time'
      WHEN (
        (
          CASE
            WHEN (cardinality("ordered"."object_type_keys") = (1)) THEN (
              SELECT
                "mt"."name"
              FROM
                "entity_type_names" AS "mt"
              WHERE
                "mt"."entity_type_name_key" = (("ordered"."object_type_keys")[1])
            )
          END
        ) IS NOT NULL
      ) THEN 'string'
      WHEN (FALSE) THEN 'null'
      WHEN (
        jsonb_typeof(NULL::jsonb) = ('array')
        OR ((NULL::jsonb) ? ('@list'))
      ) THEN 'array'
      WHEN ((NULL::jsonb) IS NOT NULL) THEN 'object'
    END
  ) AS "value_datatype"
FROM
  (
    SELECT
      "ca".*
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."entity_key" = "entities"."entity_key"
      AND "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
    ORDER BY
      "ca"."ordinal" ASC
    LIMIT
      1
  ) AS "ordered"
1: Int 7
