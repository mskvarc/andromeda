---
source: crates/andromeda-postgresql-query/src/geo_predicate.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  "entities"."entity_key" IN (
    SELECT DISTINCT
      "geo_matched"."entity_key"
    FROM
      (
        SELECT
          "geo_default"."entity_key"
        FROM
          "entity_search" AS "geo_default"
        WHERE
          (
            "geo_default"."location_expires_at" IS NULL
            OR "geo_default"."location_expires_at" > NOW()
          )
          AND (
            COALESCE(
              "geo_default"."location_reach",
              "geo_default"."location"
            ) && ST_MakeEnvelope($1, $2, $3, $4, $5)
          )
          AND (
            _ST_DWithin(
              "geo_default"."location"::geography,
              ST_MakeValid(ST_GeomFromEWKB($6))::geography,
              $7
            )
            AND ST_Distance(
              "geo_default"."location"::geography,
              ST_MakeValid(ST_GeomFromEWKB($8))::geography
            ) >= $9
          )
      ) AS "geo_matched"
    ORDER BY
      "geo_matched"."entity_key" ASC
  )
1: Double 0.9954743838616097
2: Double 1.9954771526145392
3: Double 1.0045256161383902
4: Double 2.004522847385461
5: Int 4326
6: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
7: Double 500
8: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
9: Double 100
