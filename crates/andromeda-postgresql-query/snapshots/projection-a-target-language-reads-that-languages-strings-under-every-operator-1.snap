---
source: crates/andromeda-postgresql-query/src/q_predicate/projection.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        EXISTS (
          SELECT
            1
          FROM
            jsonb_array_elements(
              (
                CASE
                  WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                END
              )
            ) AS "ls"
          WHERE
            LOWER(("ls"."value" ->> ('@language')) COLLATE "C") = LOWER(($2::text) COLLATE "C")
            AND (
              ("ls"."value" ->> ('@value')) COLLATE "und-x-icu"
            ) > $3
        )
        OR (
          (
            "ca"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
            AND (NOT "ca"."attribute_kind" = (6))
            AND (
              EXISTS (
                SELECT
                  1
                FROM
                  (
                    SELECT
                      "member"."member" AS "member"
                    FROM
                      jsonb_path_query("ca"."value_object", 'strict $."en"', '{}', TRUE) AS "member"
                  ) AS "member"
                WHERE
                  jsonb_array_length("member"."member") = (1)
                  AND (
                    (
                      (
                        CASE
                          WHEN (
                            jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('string')
                            AND (
                              NOT COALESCE(
                                (("member"."member" -> (0)) ->> ('@type')) IN (
                                  'https://uri.etsi.org/ngsi-ld/DateTime',
                                  'https://uri.etsi.org/ngsi-ld/Date',
                                  'https://uri.etsi.org/ngsi-ld/Time'
                                )
                                OR (("member"."member" -> (0)) ->> ('@type')) IN (
                                  'http://www.w3.org/2001/XMLSchema#decimal',
                                  'http://www.w3.org/2001/XMLSchema#integer',
                                  'http://www.w3.org/2001/XMLSchema#long',
                                  'http://www.w3.org/2001/XMLSchema#int',
                                  'http://www.w3.org/2001/XMLSchema#short',
                                  'http://www.w3.org/2001/XMLSchema#byte',
                                  'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                  'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                  'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                  'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                  'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                  'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                  'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                  'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                  'http://www.w3.org/2001/XMLSchema#float',
                                  'http://www.w3.org/2001/XMLSchema#double'
                                )
                                OR (("member"."member" -> (0)) ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                FALSE
                              )
                            )
                          ) THEN (
                            (("member"."member" -> (0)) -> ('@value')) #>> ('{}'))::text END)) COLLATE "und-x-icu") > $4) OR EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query((CASE WHEN (("ca"."value_object" ->> ('@type')) = ('@json')) THEN "ca"."value_object" -> ('@value') END), 'strict $."en"', '{}', TRUE) AS "member") AS "member" WHERE (NOT jsonb_typeof("member"."member") = ('array')) AND (((CASE WHEN (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN ("member"."member" #>> ('{}'))::text END)) COLLATE "und-x-icu") > $5))) OR ("ca"."attribute_kind" = (6) AND EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query("ca"."value_object", 'strict $."en"', '{}', TRUE) AS "member") AS "member" WHERE (NOT jsonb_typeof("member"."member") = ('array')) AND (((CASE WHEN (jsonb_typeof("member"."member") = ('string') AND (NOT COALESCE((NULL::text) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (NULL::text) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN ("member"."member" #>> ('{}'))::text END)) COLLATE "und-x-icu") > $6)) OR ("ca"."attribute_kind" IN (3) AND EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query("ca"."value_geometry_members", 'strict $."en"', '{}', TRUE) AS "member") AS "member" WHERE jsonb_array_length("member"."member") = (1) AND (((CASE WHEN (jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('string') AND (NOT COALESCE((("member"."member" -> (0)) ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR (("member"."member" -> (0)) ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR (("member"."member" -> (0)) ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN ((("member"."member" -> (0)) -> ('@value')) #>> ('{}'))::text END)) COLLATE "und-x-icu") > $7)))) AND "ca"."entity_key" = "entities"."entity_key")
1: Int 13
2: String 'en'
3: String 'm'
4: String 'm'
5: String 'm'
6: String 'm'
7: String 'm'
