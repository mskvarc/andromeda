---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            ("j" -> ('value')) IS NOT NULL
            OR ("j" ->> ('type')) IN (
              'Property',
              'Relationship',
              'GeoProperty',
              'VocabProperty',
              'LanguageProperty',
              'JsonProperty',
              'ListProperty',
              'ListRelationship'
            )
          ) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('https://example.com/since') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    CASE
      WHEN (
        (
          CASE
            WHEN (
              (
                (
                  SELECT
                    (
                      CASE
                        WHEN (
                          ("j" -> ('value')) IS NOT NULL
                          OR ("j" ->> ('type')) IN (
                            'Property',
                            'Relationship',
                            'GeoProperty',
                            'VocabProperty',
                            'LanguageProperty',
                            'JsonProperty',
                            'ListProperty',
                            'ListRelationship'
                          )
                        ) THEN "j" -> ('value')
                        ELSE "j"
                      END
                    )
                  FROM
                    (
                      SELECT
                        "context_source_properties" -> ('https://example.com/since') AS "j"
                    ) AS "s"
                ) ->> ('@type')
              ) IN ('Date', 'https://uri.etsi.org/ngsi-ld/Date')
              AND (
                (
                  (
                    (
                      (
                        SELECT
                          (
                            CASE
                              WHEN (
                                ("j" -> ('value')) IS NOT NULL
                                OR ("j" ->> ('type')) IN (
                                  'Property',
                                  'Relationship',
                                  'GeoProperty',
                                  'VocabProperty',
                                  'LanguageProperty',
                                  'JsonProperty',
                                  'ListProperty',
                                  'ListRelationship'
                                )
                              ) THEN "j" -> ('value')
                              ELSE "j"
                            END
                          )
                        FROM
                          (
                            SELECT
                              "context_source_properties" -> ('https://example.com/since') AS "j"
                          ) AS "s"
                      ) -> ('@value')
                    ) #>> ('{}')) ~ ('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) AND pg_input_is_valid(regexp_replace(((SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/since') AS "j") AS "s") -> ('@value')) #>> ('{}'), '^0000(.*)$', E'0001\\1 BC'), 'date'))) THEN 'https://uri.etsi.org/ngsi-ld/Date' END) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN to_jsonb(translate(((SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/since') AS "j") AS "s") -> ('@value')) #>> ('{}'), ',', '.')) #>> ('{}') END) > $1
1: String '2023-12-31'
