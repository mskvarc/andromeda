---
source: crates/andromeda-postgresql-query/src/q_predicate/language_map.rs
---
SELECT
  EXISTS (
    SELECT
      1
    FROM
      jsonb_array_elements("map") AS "ls"
  )
  AND (
    NOT EXISTS (
      SELECT
        1
      FROM
        jsonb_array_elements("map") AS "ls"
      WHERE
        LOWER(("ls"."value" ->> ('@language')) COLLATE "C") = LOWER(($1::text) COLLATE "C")
        AND ("ls"."value" ->> ('@value')) = ('Door')
    )
  )
1: String 'fr'
