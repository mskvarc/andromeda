---
source: crates/andromeda-postgresql-query/src/q_predicate/language_term.rs
---
SELECT
  EXISTS (
    SELECT
      1
    FROM
      jsonb_array_elements("map") AS "ls"
    WHERE
      (("ls"."value" ->> ('@value')) COLLATE "C") = $1
      OR (("ls"."value" ->> ('@value')) COLLATE "C") = $2
  )
1: String 'Door'
2: String 'Gate'
