---
source: crates/andromeda-postgresql-query/src/ordering/attribute_value_order.rs
---
SELECT
  COALESCE(
    "ordered"."value_number",
    (
      CASE
        WHEN (
          jsonb_typeof("ordered"."value_object") = ('number')
        ) THEN (
          "ordered"."value_object" #>> ('{}'))::numeric END)) AS "value_number", COALESCE("ordered"."value_boolean", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('boolean')) THEN ("ordered"."value_object" #>> ('{}'))::boolean END)) AS "value_boolean", "ordered"."value_date_time" AS "value_date_time", COALESCE("ordered"."value_string", "ordered"."value_long_text", "ordered"."value_uri", "ordered"."value_long_uri", (CASE WHEN ("ordered"."attribute_kind" = (5)) THEN ("ordered"."value_object" -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('string')) THEN ("ordered"."value_object" #>> ('{}'))::text END)) AS "value_text", (CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) AS "value_declared_datatype", COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) AS "value_object", COALESCE((CASE WHEN ("ordered"."value_kind" = (1)) THEN 'number' WHEN ("ordered"."value_kind" = (2)) THEN 'string' WHEN ("ordered"."value_kind" = (3)) THEN 'boolean' WHEN ("ordered"."value_kind" = (6)) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ("ordered"."value_kind" = (7)) THEN 'string' WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN ("ordered"."value_kind" = (10)) THEN 'number' WHEN ("ordered"."value_kind" = (11)) THEN 'boolean' END), (CASE WHEN (COALESCE("ordered"."value_number", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('number')) THEN ("ordered"."value_object" #>> ('{}'))::numeric END)) IS NOT NULL) THEN 'number' WHEN (COALESCE("ordered"."value_boolean", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('boolean')) THEN ("ordered"."value_object" #>> ('{}'))::boolean END)) IS NOT NULL) THEN 'boolean' WHEN ("ordered"."value_date_time" IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/DateTime')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Time')) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN (COALESCE("ordered"."value_string", "ordered"."value_long_text", "ordered"."value_uri", "ordered"."value_long_uri", (CASE WHEN ("ordered"."attribute_kind" = (5)) THEN ("ordered"."value_object" -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('string')) THEN ("ordered"."value_object" #>> ('{}'))::text END)) IS NOT NULL) THEN 'string' WHEN ("ordered"."value_object" IN (jsonb_build_object('@value', NULL::jsonb, '@type', '@json'), 'null'::jsonb)) THEN 'null' WHEN (jsonb_typeof(COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END))) = ('array') OR (COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) ? ('@list'))) THEN 'array' WHEN (COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) IS NOT NULL) THEN 'object' END)) AS "value_datatype" FROM (SELECT "ca".* FROM "current_attributes" AS "ca" WHERE "ca"."entity_key" = "entities"."entity_key" AND (FALSE) ORDER BY "ca"."ordinal" ASC LIMIT 1) AS "ordered"
