SELECT
WHERE
  (
    SELECT
      "mt"."name"
    FROM
      "entity_type_names" AS "mt"
    WHERE
      "mt"."entity_type_name_key" = "ca"."value_type_key"
  ) = $1
1: String 'https://example.com/String'
