---
source: crates/andromeda-postgresql-query/src/q_predicate/sub_attribute/element_path.rs
---
SELECT
WHERE
  "ca"."sub_attributes" IS NOT NULL
  AND (
    EXISTS (
      SELECT
        1
      FROM
        UNNEST("ca"."sub_attributes")
      WITH
      ORDINALITY AS "l0"
      JOIN UNNEST("ca"."sub_attributes") AS "l1" ON "l1"."parent" = "l0"."ordinality"
      WHERE
        "l0"."parent" = $1
        AND (
          "l0"."attribute_name_key" = $2
          AND (
            "l0"."expires_at" IS NULL
            OR "l0"."expires_at" > NOW()
          )
          AND "l1"."attribute_name_key" = $3
          AND (
            "l1"."expires_at" IS NULL
            OR "l1"."expires_at" > NOW()
          )
        )
        AND TRUE
    )
  )
1: BigInt 0
2: Int 5
3: Int 9
