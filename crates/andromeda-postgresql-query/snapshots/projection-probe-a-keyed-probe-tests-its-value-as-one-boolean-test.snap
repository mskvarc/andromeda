---
source: crates/andromeda-postgresql-query/src/q_predicate/projection_probe.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        (
          "ca"."value_string" = $2
          OR "ca"."value_uri" = $3
        ) IS TRUE
      )
      AND "ca"."entity_key" = "entities"."entity_key"
  )
1: Int 7
2: String 'red'
3: String 'red'
