---
source: crates/andromeda-postgresql-query/src/q_predicate/structured_target.rs
---
SELECT
  1
WHERE
  "attribute_kind" <> (6)
  AND (
    (
      (
        "value_object" @> jsonb_build_array(TRUE::boolean)
      )
      OR (
        "value_object" @> jsonb_build_array(jsonb_build_object('@value', TRUE::boolean))
      )
      OR ("value_object" @> jsonb_build_array($1::text))
      OR (
        "value_object" @> jsonb_build_array(jsonb_build_object('@value', $2::text))
      )
    )
    AND EXISTS (
      SELECT
        1
      FROM
        jsonb_array_elements(
          (
            CASE
              WHEN (jsonb_typeof("value_object") = ('array')) THEN "value_object"
            END
          )
        ) AS "dm"
        LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
          CASE
            WHEN ("attribute_kind" IN (1, 7)) THEN "value_type_key"
          END
        )
      WHERE
        (
          CASE
            WHEN (
              jsonb_typeof(
                COALESCE("dm"."value" -> ('@value'), "dm"."value")
              ) = ('boolean')
            ) THEN (
              COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::boolean WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean') AND pg_input_is_valid(COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'), 'boolean')) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::boolean END) = ($3::boolean)))
1: String 'true'
2: String 'true'
3: String 'true'
