---
source: crates/andromeda-postgresql-query/src/q_predicate/pattern_term.rs
---
SELECT
WHERE
  (
    ("ca"."value_string" ~ $1)
    AND nullif("ca"."value_kind" = (2), FALSE)
  )
  OR (
    (
      (("ca"."value_long_text") COLLATE "default") ~ $2
    )
    AND nullif("ca"."value_kind" = (2), FALSE)
  )
  OR EXISTS (
    SELECT
      1
    FROM
      jsonb_array_elements(
        (
          CASE
            WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
          END
        )
      ) AS "ls"
    WHERE
      ("ls"."value" ->> ('@value')) ~ $3
  )
1: String '^D'
2: String '^D'
3: String '^D'
