---
source: crates/andromeda-postgresql-query/src/scope_validity.rs
---
SELECT
  $1
FROM
  "scope_history" AS "sh"
WHERE
  NOT EXISTS (
    SELECT
      $2
    FROM
      (
        SELECT
          "rsh"."entity_key" AS "entity_key",
          "rsh"."recorded_at",
          "rsh"."write_id",
          "rsh"."write_ordinal",
          "rsh"."value_kind",
          "rsh"."observed_at",
          "rsh"."created_at",
          "rsh"."modified_at",
          "rsh"."deleted_at",
          "rsh"."scope_path",
          "rsh"."verbatim_scope_path"
        FROM
          "scope_history" AS "rsh"
        WHERE
          "rsh"."entity_key" = "sh"."entity_key"
      ) AS "sh_next"
    WHERE
      "sh_next"."observed_at" > "sh"."observed_at"
      AND "sh_next"."observed_at" <= $3
  )
1: Int 1
2: Int 1
3: ChronoDateTimeUtc '2018-08-01 12:00:00.000000 +00:00'
