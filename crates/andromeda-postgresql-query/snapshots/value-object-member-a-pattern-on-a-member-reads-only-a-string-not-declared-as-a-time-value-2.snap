              jsonb_path_query(
                "ca"."value_object",
                'strict $."city"',
                '{}',
                TRUE
              ) AS "member"
          ) AS "member"
        WHERE
          jsonb_array_length("member"."member") = (1)
          AND (
            (("member"."member" -> (0)) -> ('@value')) IS NOT NULL
