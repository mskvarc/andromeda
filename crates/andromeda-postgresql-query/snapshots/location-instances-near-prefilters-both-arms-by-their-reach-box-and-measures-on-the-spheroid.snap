---
source: crates/andromeda-postgresql-query/src/location_instances.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  "entities"."entity_key" IN (
    SELECT DISTINCT
      "geo_matched"."entity_key"
    FROM
      (
        SELECT
          "geo_default"."entity_key"
        FROM
          "entity_search" AS "geo_default"
        WHERE
          (
            "geo_default"."location_expires_at" IS NULL
            OR "geo_default"."location_expires_at" > NOW()
          )
          AND (
            COALESCE(
              "geo_default"."location_reach",
              "geo_default"."location"
            ) && ST_MakeEnvelope($1, $2, $3, $4, $5)
          )
          AND _ST_DWithin(
            "geo_default"."location"::geography,
            ST_MakeValid(ST_GeomFromEWKB($6))::geography,
            $7
          )
        UNION ALL
        (
          SELECT
            "geo_location_instance"."entity_key"
          FROM
            "current_attributes" AS "geo_location_instance"
          WHERE
            "geo_location_instance"."attribute_name_key" = $8
            AND "geo_location_instance"."dataset_key" <> ('')
            AND (
              "geo_location_instance"."expires_at" IS NULL
              OR "geo_location_instance"."expires_at" > NOW()
            )
            AND "geo_location_instance"."value_geometry" IS NOT NULL
            AND (
              COALESCE(
                "geo_location_instance"."value_geometry_reach",
                "geo_location_instance"."value_geometry_valid",
                "geo_location_instance"."value_geometry"
              ) && ST_MakeEnvelope($9, $10, $11, $12, $13)
            )
            AND _ST_DWithin(
              COALESCE(
                "geo_location_instance"."value_geometry_valid",
                "geo_location_instance"."value_geometry"
              )::geography,
              ST_MakeValid(ST_GeomFromEWKB($14))::geography,
              $15
            )
        )
      ) AS "geo_matched"
    ORDER BY
      "geo_matched"."entity_key" ASC
  )
1: Double 0.9909497426989623
2: Double 1.9909553052290783
3: Double 1.0090502573010376
4: Double 2.009044694770922
5: Int 4326
6: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
7: Double 1000
8: Int 9
9: Double 0.9909497426989623
10: Double 1.9909553052290783
11: Double 1.0090502573010376
12: Double 2.009044694770922
13: Int 4326
14: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
15: Double 1000
