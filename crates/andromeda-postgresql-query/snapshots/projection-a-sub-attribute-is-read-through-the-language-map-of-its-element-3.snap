---
source: crates/andromeda-postgresql-query/src/q_predicate/projection.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        "ca"."sub_attributes" IS NOT NULL
        AND (
          EXISTS (
            SELECT
              1
            FROM
              UNNEST("ca"."sub_attributes") AS "l0"
            WHERE
              "l0"."parent" = $2
              AND (
                "l0"."attribute_name_key" = $3
                AND (
                  "l0"."expires_at" IS NULL
                  OR "l0"."expires_at" > NOW()
                )
              )
              AND (
                EXISTS (
                  SELECT
                    1
                  FROM
                    jsonb_array_elements(
                      (
                        CASE
                          WHEN ("l0"."attribute_kind" = (5)) THEN sub_attribute_value_object(
                            "l0"."value_kind",
                            "l0"."value_object",
                            "l0"."value_proof"
                          )
                        END
                      )
                    ) AS "ls"
                  WHERE
                    LOWER(("ls"."value" ->> ('@language')) COLLATE "C") = LOWER(($4::text) COLLATE "C")
                )
                OR (
                  (
                    "l0"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
                    AND (
                      EXISTS (
                        SELECT
                          1
                        FROM
                          (
                            SELECT
                              jsonb_path_query_array(
                                "member"."member",
                                'lax $[*] ? (exists(@."@value"))'
                              ) AS "member"
                            FROM
                              jsonb_path_query(
                                sub_attribute_value_object(
                                  "l0"."value_kind",
                                  "l0"."value_object",
                                  "l0"."value_proof"
                                ),
                                'strict $."en"',
                                '{}',
                                TRUE
                              ) AS "member"
                          ) AS "member"
                        WHERE
                          TRUE
                      )
                      OR (
                        (NOT "l0"."attribute_kind" = (6))
                        AND EXISTS (
                          SELECT
                            1
                          FROM
                            (
                              SELECT
                                "member"."member" AS "member"
                              FROM
                                jsonb_path_query(
                                  (
                                    CASE
                                      WHEN (
                                        (
                                          sub_attribute_value_object(
                                            "l0"."value_kind",
                                            "l0"."value_object",
                                            "l0"."value_proof"
                                          ) ->> ('@type')
                                        ) = ('@json')
                                      ) THEN sub_attribute_value_object(
                                        "l0"."value_kind",
                                        "l0"."value_object",
                                        "l0"."value_proof"
                                      ) -> ('@value')
                                    END
                                  ),
                                  'strict $."en"',
                                  '{}',
                                  TRUE
                                ) AS "member"
                            ) AS "member"
                          WHERE
                            TRUE
                        )
                      )
                    )
                  )
                  OR (
                    "l0"."attribute_kind" = (6)
                    AND EXISTS (
                      SELECT
                        1
                      FROM
                        (
                          SELECT
                            "member"."member" AS "member"
                          FROM
                            jsonb_path_query(
                              sub_attribute_value_object(
                                "l0"."value_kind",
                                "l0"."value_object",
                                "l0"."value_proof"
                              ),
                              'strict $."en"',
                              '{}',
                              TRUE
                            ) AS "member"
                        ) AS "member"
                      WHERE
                        TRUE
                    )
                  )
                  OR (
                    "l0"."attribute_kind" IN (3)
                    AND EXISTS (
                      SELECT
                        1
                      FROM
                        (
                          SELECT
                            "member"."member" AS "member"
                          FROM
                            jsonb_path_query(
                              ST_AsGeoJSON("l0"."value_geometry", 15)::jsonb,
                              'strict $."en"',
                              '{}',
                              TRUE
                            ) AS "member"
                        ) AS "member"
                      WHERE
                        TRUE
                    )
                  )
                )
              )
          )
        )
      )
      AND "ca"."entity_key" = "entities"."entity_key" OFFSET 0
  )
1: Int 15
2: BigInt 0
3: Int 40
4: String 'en'
