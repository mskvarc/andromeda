---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (
            ("j" -> ('value')) IS NOT NULL
            OR ("j" ->> ('type')) IN (
              'Property',
              'Relationship',
              'GeoProperty',
              'VocabProperty',
              'LanguageProperty',
              'JsonProperty',
              'ListProperty',
              'ListRelationship'
            )
          ) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('https://example.com/since') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    CASE
      WHEN (
        (
          CASE
            WHEN (
              (
                (
                  SELECT
                    (
                      CASE
                        WHEN (
                          ("j" -> ('value')) IS NOT NULL
                          OR ("j" ->> ('type')) IN (
                            'Property',
                            'Relationship',
                            'GeoProperty',
                            'VocabProperty',
                            'LanguageProperty',
                            'JsonProperty',
                            'ListProperty',
                            'ListRelationship'
                          )
                        ) THEN "j" -> ('value')
                        ELSE "j"
                      END
                    )
                  FROM
                    (
                      SELECT
                        "context_source_properties" -> ('https://example.com/since') AS "j"
                    ) AS "s"
                ) ->> ('@type')
              ) IN ('Time', 'https://uri.etsi.org/ngsi-ld/Time')
              AND (
                (
                  (
                    (
                      SELECT
                        (
                          CASE
                            WHEN (
                              ("j" -> ('value')) IS NOT NULL
                              OR ("j" ->> ('type')) IN (
                                'Property',
                                'Relationship',
                                'GeoProperty',
                                'VocabProperty',
                                'LanguageProperty',
                                'JsonProperty',
                                'ListProperty',
                                'ListRelationship'
                              )
                            ) THEN "j" -> ('value')
                            ELSE "j"
                          END
                        )
                      FROM
                        (
                          SELECT
                            "context_source_properties" -> ('https://example.com/since') AS "j"
                        ) AS "s"
                    ) -> ('@value')
                  ) #>> ('{}')) ~ ('^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.,][0-9]{1,6})?Z$'))) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Time') AND pg_input_is_valid(('1970-01-01T') || (to_jsonb(translate(((SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/since') AS "j") AS "s") -> ('@value')) #>> ('{}'), ',', '.')) #>> ('{}')), 'timestamptz')) THEN to_char(((('1970-01-01T') || (to_jsonb(translate(((SELECT (CASE WHEN (("j" -> ('value')) IS NOT NULL OR ("j" ->> ('type')) IN ('Property', 'Relationship', 'GeoProperty', 'VocabProperty', 'LanguageProperty', 'JsonProperty', 'ListProperty', 'ListRelationship')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/since') AS "j") AS "s") -> ('@value')) #>> ('{}'), ',', '.')) #>> ('{}')))::timestamptz) AT TIME ZONE ('UTC'), 'HH24:MI:SS.US') || ('Z') END) > $1
1: String '07:00:00.000000Z'
