---
source: crates/andromeda-postgresql-query/src/type_membership.rs
---
SELECT
  "candidate"."entity_key",
  "candidate"."id"
FROM
  (
    SELECT
      "entity_key",
      "id"
    FROM
      "entity_type_members"
    WHERE
      "entity_type_name_key" = (1)
      AND "is_current_member"
  ) AS "candidate"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "entity_type_members" AS "type_member"
    WHERE
      "type_member"."entity_type_name_key" = (2)
      AND "type_member"."id" = "candidate"."id"
      AND "type_member"."is_current_member"
  )
