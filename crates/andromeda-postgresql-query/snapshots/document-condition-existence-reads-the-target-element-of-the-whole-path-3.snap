---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    (
      SELECT
        (
          CASE
            WHEN (
              ("j" -> ('value')) IS NOT NULL
              OR ("j" ->> ('type')) IN (
                'Property',
                'Relationship',
                'GeoProperty',
                'VocabProperty',
                'LanguageProperty',
                'JsonProperty',
                'ListProperty',
                'ListRelationship'
              )
            ) THEN "j" -> ('value')
            ELSE "j"
          END
        )
      FROM
        (
          SELECT
            "context_source_properties" -> ('a') AS "j"
        ) AS "s"
    ) -> ('m')
  ) IS NOT NULL
