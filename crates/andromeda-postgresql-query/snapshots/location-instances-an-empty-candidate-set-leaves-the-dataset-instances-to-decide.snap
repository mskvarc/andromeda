---
source: crates/andromeda-postgresql-query/src/location_instances.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  "entities"."entity_key" IN (
    SELECT DISTINCT
      "geo_matched"."entity_key"
    FROM
      (
        SELECT
          "geo_location_instance"."entity_key"
        FROM
          "current_attributes" AS "geo_location_instance"
        WHERE
          "geo_location_instance"."attribute_name_key" = $1
          AND "geo_location_instance"."dataset_key" <> ('')
          AND (
            "geo_location_instance"."expires_at" IS NULL
            OR "geo_location_instance"."expires_at" > NOW()
          )
          AND "geo_location_instance"."value_geometry" IS NOT NULL
          AND (
            COALESCE(
              "geo_location_instance"."value_geometry_reach",
              "geo_location_instance"."value_geometry_valid",
              "geo_location_instance"."value_geometry"
            ) && ST_MakeValid(ST_GeomFromEWKB($2))
          )
          AND _ST_Within(
            COALESCE(
              "geo_location_instance"."value_geometry_valid",
              "geo_location_instance"."value_geometry"
            ),
            ST_MakeValid(ST_GeomFromEWKB($3))
          )
      ) AS "geo_matched"
    ORDER BY
      "geo_matched"."entity_key" ASC
  )
1: Int 9
2: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
3: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
