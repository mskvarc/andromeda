---
source: crates/andromeda-postgresql-query/src/history_source/attribute_rows.rs
---
SELECT
  *
FROM
  (
    SELECT
      "re"."id" AS "entity_id",
      "rs"."attribute_name_key" AS "attribute_name_key",
      "rs"."dataset_key" AS "dataset_key",
      "rs"."stream_key" AS "stream_key"
    FROM
      "snap_1"."temporal_attribute_streams" AS "rs"
      JOIN "snap_1"."entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
  ) AS "qs"
