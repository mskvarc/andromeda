---
source: crates/andromeda-postgresql-query/src/geo_predicate.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "entity_search" AS "geo_default"
    WHERE
      "geo_default"."entity_key" = "walked"."entity_key"
      AND (
        "geo_default"."location_expires_at" IS NULL
        OR "geo_default"."location_expires_at" > NOW()
      )
      AND (
        COALESCE(
          "geo_default"."location_reach",
          "geo_default"."location"
        )::box2d && ST_MakeEnvelope($1, $2, $3, $4, $5)::box2d
      )
      AND (
        _ST_DWithin(
          "geo_default"."location"::geography,
          ST_MakeValid(ST_GeomFromEWKB($6))::geography,
          $7
        )
        AND ST_Distance(
          "geo_default"."location"::geography,
          ST_MakeValid(ST_GeomFromEWKB($8))::geography
        ) >= $9
      )
  )
  OR EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "geo_location_instance"
    WHERE
      "geo_location_instance"."entity_key" = "walked"."entity_key"
      AND "geo_location_instance"."attribute_name_key" = $10
      AND "geo_location_instance"."dataset_key" <> ('')
      AND (
        "geo_location_instance"."expires_at" IS NULL
        OR "geo_location_instance"."expires_at" > NOW()
      )
      AND "geo_location_instance"."value_geometry" IS NOT NULL
      AND (
        COALESCE(
          "geo_location_instance"."value_geometry_reach",
          "geo_location_instance"."value_geometry_valid",
          "geo_location_instance"."value_geometry"
        )::box2d && ST_MakeEnvelope($11, $12, $13, $14, $15)::box2d
      )
      AND (
        _ST_DWithin(
          COALESCE(
            "geo_location_instance"."value_geometry_valid",
            "geo_location_instance"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($16))::geography,
          $17
        )
        AND ST_Distance(
          COALESCE(
            "geo_location_instance"."value_geometry_valid",
            "geo_location_instance"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($18))::geography
        ) >= $19
      )
  )
