---
source: crates/andromeda-postgresql-query/src/q_predicate/history_window.rs
---
SELECT
  $1
WHERE
  EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rh"."recorded_at",
          "rh"."write_id",
          "rh"."write_ordinal",
          "rh"."attribute_kind",
          "rh"."value_kind",
          "rh"."observed_at",
          "rh"."created_at",
          "rh"."modified_at",
          "rh"."deleted_at",
          "rh"."value_date_time",
          "rh"."expires_at",
          "rh"."generated_instance_id",
          "rh"."value_type_key",
          "rh"."value_datatype_key",
          "rh"."unit_code_id",
          "rh"."value_boolean",
          "rh"."verbatim_instance_id",
          "rh"."value_number",
          "rh"."value_string",
          "rh"."value_language",
          "rh"."value_geometry",
          "rh"."value_geometry_valid",
          "rh"."value_geometry_reach",
          "rh"."value_geometry_members",
          "rh"."value_object",
          "rh"."value_uri",
          "rh"."object_type_keys",
          "rh"."sub_attributes"
        FROM
          "snap_7"."attribute_history" AS "rh"
          JOIN "snap_7"."temporal_attribute_streams" AS "rs" ON "rs"."stream_key" = "rh"."stream_key"
          JOIN "snap_7"."entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qh"
    WHERE
      "qh"."attribute_name_key" = $2
      AND "qh"."value_number" > $3
      AND "qh"."value_kind" <> (0)
      AND "qh"."observed_at" IS NOT NULL
      AND "qh"."observed_at" >= $4
  )
  OR EXISTS (
    SELECT
      1
    FROM
      (
        SELECT
          "re"."id" AS "entity_id",
          "rs"."attribute_name_key" AS "attribute_name_key",
          "rs"."dataset_key" AS "dataset_key",
          "rs"."stream_key" AS "stream_key"
        FROM
          "snap_7"."temporal_attribute_streams" AS "rs"
          JOIN "snap_7"."entities" AS "re" ON "re"."entity_key" = "rs"."entity_key"
        WHERE
          "re"."id" = "e"."id"
      ) AS "qs"
      JOIN LATERAL (
        SELECT
          *
        FROM
          (
            (
              SELECT
                *
              FROM
                (
                  (
                    SELECT
                      "qi".*,
                      "qi"."observed_at" AS "placed"
                    FROM
                      (
                        SELECT
                          "qs"."entity_id" AS "entity_id",
                          "qs"."attribute_name_key" AS "attribute_name_key",
                          "qs"."dataset_key" AS "dataset_key",
                          "rh"."recorded_at",
                          "rh"."write_id",
                          "rh"."write_ordinal",
                          "rh"."attribute_kind" AS "attribute_kind",
                          "rh"."value_kind" AS "value_kind",
                          "rh"."observed_at" AS "observed_at",
                          "rh"."created_at" AS "created_at",
                          "rh"."modified_at" AS "modified_at",
                          "rh"."deleted_at" AS "deleted_at",
                          "rh"."value_date_time" AS "value_date_time",
                          "rh"."expires_at" AS "expires_at",
                          "rh"."generated_instance_id" AS "generated_instance_id",
                          "rh"."value_type_key" AS "value_type_key",
                          "rh"."value_datatype_key" AS "value_datatype_key",
                          "rh"."unit_code_id" AS "unit_code_id",
                          "rh"."value_boolean" AS "value_boolean",
                          "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                          "rh"."value_number" AS "value_number",
                          "rh"."value_string" AS "value_string",
                          "rh"."value_language" AS "value_language",
                          "rh"."value_geometry" AS "value_geometry",
                          "rh"."value_geometry_valid" AS "value_geometry_valid",
                          "rh"."value_geometry_reach" AS "value_geometry_reach",
                          "rh"."value_geometry_members" AS "value_geometry_members",
                          "rh"."value_object" AS "value_object",
                          "rh"."value_uri" AS "value_uri",
                          "rh"."object_type_keys" AS "object_type_keys",
                          "rh"."sub_attributes" AS "sub_attributes"
                        FROM
                          "snap_7"."attribute_history" AS "rh"
                        WHERE
                          "rh"."stream_key" = "qs"."stream_key"
                      ) AS "qi"
                    WHERE
                      "qi"."observed_at" <= $5
                    ORDER BY
                      "qi"."observed_at" DESC
                  )
                  FETCH FIRST
                    1 ROW
                  WITH
                  TIES
                ) AS "qe"
              UNION ALL
              (
                SELECT
                  *
                FROM
                  (
                    (
                      SELECT
                        "qi".*,
                        "qi"."deleted_at" AS "placed"
                      FROM
                        (
                          SELECT
                            "qs"."entity_id" AS "entity_id",
                            "qs"."attribute_name_key" AS "attribute_name_key",
                            "qs"."dataset_key" AS "dataset_key",
                            "rh"."recorded_at",
                            "rh"."write_id",
                            "rh"."write_ordinal",
                            "rh"."attribute_kind" AS "attribute_kind",
                            "rh"."value_kind" AS "value_kind",
                            "rh"."observed_at" AS "observed_at",
                            "rh"."created_at" AS "created_at",
                            "rh"."modified_at" AS "modified_at",
                            "rh"."deleted_at" AS "deleted_at",
                            "rh"."value_date_time" AS "value_date_time",
                            "rh"."expires_at" AS "expires_at",
                            "rh"."generated_instance_id" AS "generated_instance_id",
                            "rh"."value_type_key" AS "value_type_key",
                            "rh"."value_datatype_key" AS "value_datatype_key",
                            "rh"."unit_code_id" AS "unit_code_id",
                            "rh"."value_boolean" AS "value_boolean",
                            "rh"."verbatim_instance_id" AS "verbatim_instance_id",
                            "rh"."value_number" AS "value_number",
                            "rh"."value_string" AS "value_string",
                            "rh"."value_language" AS "value_language",
                            "rh"."value_geometry" AS "value_geometry",
                            "rh"."value_geometry_valid" AS "value_geometry_valid",
                            "rh"."value_geometry_reach" AS "value_geometry_reach",
                            "rh"."value_geometry_members" AS "value_geometry_members",
                            "rh"."value_object" AS "value_object",
                            "rh"."value_uri" AS "value_uri",
                            "rh"."object_type_keys" AS "object_type_keys",
                            "rh"."sub_attributes" AS "sub_attributes"
                          FROM
                            "snap_7"."attribute_history" AS "rh"
                          WHERE
                            "rh"."stream_key" = "qs"."stream_key"
                        ) AS "qi"
                      WHERE
                        "qi"."deleted_at" <= $6
                        AND "qi"."observed_at" IS NULL
                      ORDER BY
                        "qi"."deleted_at" DESC
                    )
                    FETCH FIRST
                      1 ROW
                    WITH
                    TIES
                  ) AS "qe"
              )
              ORDER BY
                "placed" DESC
            )
            FETCH FIRST
              1 ROW
            WITH
            TIES
          ) AS "qe"
      ) AS "qh" ON TRUE
    WHERE
      "qs"."attribute_name_key" = $7
      AND "qh"."placed" < $8
      AND "qh"."attribute_name_key" = $9
      AND "qh"."value_number" > $10
      AND "qh"."value_kind" <> (0)
  )
1: Int 1
2: Int 7
3: Int 100
4: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
5: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
6: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
7: Int 7
8: ChronoDateTimeUtc '2019-01-01 00:00:00.000000 +00:00'
9: Int 7
10: Int 100
