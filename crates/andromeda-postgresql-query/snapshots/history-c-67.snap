                              AND "qi"."observed_at" IS NULL
                            ORDER BY
                              "qi"."deleted_at" DESC
                          )
                          FETCH FIRST
                            1 ROW
                          WITH
                          TIES
                        ) AS "qe"
                    )
                    ORDER BY
                      "placed" DESC
                  )
                  FETCH FIRST
                    1 ROW
                  WITH
                  TIES
                ) AS "qe"
            ) AS "qh" ON TRUE
          WHERE
            "qs"."attribute_name_key" = $28
            AND "qh"."placed" < $29
            AND "qh"."attribute_name_key" = $30
            AND "qh"."value_kind" <> (0)
        )
      )
  )
