---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  (
    SELECT
      COALESCE("j" -> ('value'), "j")
    FROM
      (
        SELECT
          "context_source_properties" -> ('https://example.com/name') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    jsonb_typeof(
      (
        SELECT
          COALESCE("j" -> ('value'), "j")
        FROM
          (
            SELECT
              "context_source_properties" -> ('https://example.com/name') AS "j"
          ) AS "s"
      )
    ) = ('string')
    AND (
      NOT COALESCE(
        jsonb_typeof(
          (
            SELECT
              COALESCE("j" -> ('value'), "j")
            FROM
              (
                SELECT
                  "context_source_properties" -> ('https://example.com/name') AS "j"
              ) AS "s"
          )
        ) = ('string')
        AND (
          (
            (
              SELECT
                COALESCE("j" -> ('value'), "j")
              FROM
                (
                  SELECT
                    "context_source_properties" -> ('https://example.com/name') AS "j"
                ) AS "s"
            ) #>> ('{}')) ~ $1), FALSE)))
1: String '^A.*'
