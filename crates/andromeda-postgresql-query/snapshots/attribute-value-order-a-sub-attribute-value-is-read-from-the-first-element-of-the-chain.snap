---
source: crates/andromeda-postgresql-query/src/ordering/attribute_value_order.rs
---
SELECT
  COALESCE(
    ("ordered"."element")."value_number",
    (
      CASE
        WHEN (
          jsonb_typeof(
            sub_attribute_value_object(
              ("ordered"."element")."value_kind",
              ("ordered"."element")."value_object",
              ("ordered"."element")."value_proof"
            )
          ) = ('number')
        ) THEN (
          sub_attribute_value_object(
            ("ordered"."element")."value_kind",
            ("ordered"."element")."value_object",
            ("ordered"."element")."value_proof"
          ) #>> ('{}'))::numeric END)) AS "value_number", COALESCE(("ordered"."element")."value_boolean", (CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) = ('boolean')) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") #>> ('{}'))::boolean END)) AS "value_boolean", ("ordered"."element")."value_date_time" AS "value_date_time", COALESCE(("ordered"."element")."value_string", ("ordered"."element")."value_uri", (CASE WHEN ((("ordered"."element")."attribute_kind") = (5)) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) = ('string')) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") #>> ('{}'))::text END)) AS "value_text", (CASE WHEN ((("ordered"."element")."value_kind") = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((("ordered"."element")."value_kind") = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) AS "value_declared_datatype", COALESCE((CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) IN ('object', 'array')) THEN sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") END), (CASE WHEN ((("ordered"."element")."value_geometry") IS NOT NULL) THEN jsonb_build_object() END)) AS "value_object", (CASE WHEN (COALESCE(("ordered"."element")."value_number", (CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) = ('number')) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") #>> ('{}'))::numeric END)) IS NOT NULL) THEN 'number' WHEN (COALESCE(("ordered"."element")."value_boolean", (CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) = ('boolean')) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") #>> ('{}'))::boolean END)) IS NOT NULL) THEN 'boolean' WHEN ((("ordered"."element")."value_date_time") IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ((("ordered"."element")."value_kind") = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((("ordered"."element")."value_kind") = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/DateTime')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ((("ordered"."element")."value_kind") = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((("ordered"."element")."value_kind") = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((CASE WHEN ((("ordered"."element")."value_kind") = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((("ordered"."element")."value_kind") = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Time')) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN (COALESCE(("ordered"."element")."value_string", ("ordered"."element")."value_uri", (CASE WHEN ((("ordered"."element")."attribute_kind") = (5)) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) = ('string')) THEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") #>> ('{}'))::text END)) IS NOT NULL) THEN 'string' WHEN (sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") IN (jsonb_build_object('@value', NULL::jsonb, '@type', '@json'), 'null'::jsonb)) THEN 'null' WHEN (jsonb_typeof(COALESCE((CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) IN ('object', 'array')) THEN sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") END), (CASE WHEN ((("ordered"."element")."value_geometry") IS NOT NULL) THEN jsonb_build_object() END))) = ('array') OR (COALESCE((CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) IN ('object', 'array')) THEN sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") END), (CASE WHEN ((("ordered"."element")."value_geometry") IS NOT NULL) THEN jsonb_build_object() END)) ? ('@list'))) THEN 'array' WHEN (COALESCE((CASE WHEN (jsonb_typeof(sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof")) IN ('object', 'array')) THEN sub_attribute_value_object(("ordered"."element")."value_kind", ("ordered"."element")."value_object", ("ordered"."element")."value_proof") END), (CASE WHEN ((("ordered"."element")."value_geometry") IS NOT NULL) THEN jsonb_build_object() END)) IS NOT NULL) THEN 'object' END) AS "value_datatype" FROM (SELECT "ca".*, (SELECT "l0" FROM UNNEST("ca"."sub_attributes") AS "l0" WHERE "l0"."parent" = $1 AND ("l0"."attribute_name_key" = $2 AND ("l0"."expires_at" IS NULL OR "l0"."expires_at" > NOW())) AND TRUE LIMIT 1) AS "element" FROM "current_attributes" AS "ca" WHERE "ca"."entity_key" = "entities"."entity_key" AND "ca"."attribute_name_key" = $3 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND "ca"."sub_attributes" IS NOT NULL AND (EXISTS (SELECT 1 FROM UNNEST("ca"."sub_attributes") AS "l0" WHERE "l0"."parent" = $4 AND ("l0"."attribute_name_key" = $5 AND ("l0"."expires_at" IS NULL OR "l0"."expires_at" > NOW())) AND TRUE)) ORDER BY "ca"."ordinal" ASC LIMIT 1) AS "ordered"
1: BigInt 0
2: Int 20
3: Int 12
4: BigInt 0
5: Int 20
