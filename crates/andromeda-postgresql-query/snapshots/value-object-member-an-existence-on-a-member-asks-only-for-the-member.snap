---
source: crates/andromeda-postgresql-query/src/q_predicate/value_object_member.rs
---
SELECT
WHERE
  (
    "ca"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
    AND (NOT "ca"."attribute_kind" = (6))
    AND (
      EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "member"."member" AS "member"
            FROM
              jsonb_path_query(
                "ca"."value_object",
                'strict $."city"',
                '{}',
                TRUE
              ) AS "member"
          ) AS "member"
        WHERE
          TRUE
      )
      OR EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              "member"."member" AS "member"
            FROM
              jsonb_path_query(
                (
                  CASE
                    WHEN (("ca"."value_object" ->> ('@type')) = ('@json')) THEN "ca"."value_object" -> ('@value')
                  END
                ),
                'strict $."city"',
                '{}',
                TRUE
              ) AS "member"
          ) AS "member"
        WHERE
          TRUE
      )
    )
  )
  OR (
    "ca"."attribute_kind" = (6)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "member"."member" AS "member"
          FROM
            jsonb_path_query(
              "ca"."value_object",
              'strict $."city"',
              '{}',
              TRUE
            ) AS "member"
        ) AS "member"
      WHERE
        TRUE
    )
  )
  OR (
    "ca"."attribute_kind" IN (3)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "member"."member" AS "member"
          FROM
            jsonb_path_query(
              "ca"."value_geometry_members",
              'strict $."city"',
              '{}',
              TRUE
            ) AS "member"
        ) AS "member"
      WHERE
        TRUE
    )
  )
