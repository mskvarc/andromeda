---
source: crates/andromeda-postgresql-query/src/q_predicate/value_object_member.rs
---
SELECT
WHERE
  (
    "ca"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            jsonb_path_query_array(
              "member"."member",
              'lax $[*] ? (exists(@."@value"))'
            ) AS "member"
          FROM
            jsonb_path_query(
              "ca"."value_object",
              'strict $."city"',
              '{}',
              TRUE
            ) AS "member"
        ) AS "member"
      WHERE
        TRUE
    )
  )
  OR (
    "ca"."attribute_kind" = (6)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "member"."member" AS "member"
          FROM
            jsonb_path_query(
              "ca"."value_object",
              'strict $."city"',
              '{}',
              TRUE
            ) AS "member"
        ) AS "member"
      WHERE
        TRUE
    )
  )
  OR (
    "ca"."attribute_kind" IN (3)
    AND EXISTS (
      SELECT
        1
      FROM
        (
          SELECT
            "member"."member" AS "member"
          FROM
            jsonb_path_query(
              ST_AsGeoJSON("ca"."value_geometry", 15)::jsonb,
              'strict $."city"',
              '{}',
              TRUE
            ) AS "member"
        ) AS "member"
      WHERE
        TRUE
    )
  )
