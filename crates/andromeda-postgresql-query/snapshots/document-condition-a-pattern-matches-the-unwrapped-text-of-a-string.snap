---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('name') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    jsonb_typeof(
      (
        SELECT
          (
            CASE
              WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
              ELSE "j"
            END
          )
        FROM
          (
            SELECT
              "context_source_properties" -> ('name') AS "j"
          ) AS "s"
      )
    ) = ('string')
    AND (
      (
        (
          SELECT
            (
              CASE
                WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
                ELSE "j"
              END
            )
          FROM
            (
              SELECT
                "context_source_properties" -> ('name') AS "j"
            ) AS "s"
        ) #>> ('{}')) ~ $1))
1: String '^A.*'
