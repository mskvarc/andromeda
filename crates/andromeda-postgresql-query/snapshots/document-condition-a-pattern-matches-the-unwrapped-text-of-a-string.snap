---
source: crates/andromeda-postgresql-query/src/q_predicate/document/condition.rs
---
SELECT
  1
FROM
  "context_source_registrations"
WHERE
  (
    SELECT
      COALESCE("j" -> ('value'), "j")
    FROM
      (
        SELECT
          "context_source_properties" -> ('name') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    jsonb_typeof(
      (
        SELECT
          COALESCE("j" -> ('value'), "j")
        FROM
          (
            SELECT
              "context_source_properties" -> ('name') AS "j"
          ) AS "s"
      )
    ) = ('string')
    AND (
      (
        (
          SELECT
            COALESCE("j" -> ('value'), "j")
          FROM
            (
              SELECT
                "context_source_properties" -> ('name') AS "j"
            ) AS "s"
        ) #>> ('{}')) ~ $1))
1: String '^A.*'
