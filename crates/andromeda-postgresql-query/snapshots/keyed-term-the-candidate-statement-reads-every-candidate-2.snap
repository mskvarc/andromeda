---
source: crates/andromeda-postgresql-query/src/q_predicate/keyed_term.rs
---
SELECT
  "entity_key"
FROM
  (
    SELECT
      "ca"."entity_key"
    FROM
      "current_attributes" AS "ca"
    WHERE
      "ca"."attribute_name_key" = $1
      AND (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        ((("ca"."value_string") COLLATE "default") ~ $2)
        AND nullif("ca"."value_kind" = (2), FALSE)
      )
    UNION ALL
    (
      SELECT
        "ca"."entity_key"
      FROM
        "current_attributes" AS "ca"
      WHERE
        "ca"."attribute_name_key" = $3
        AND (
          "ca"."expires_at" IS NULL
          OR "ca"."expires_at" > NOW()
        )
        AND (
          (
            (("ca"."value_long_text") COLLATE "default") ~ $4
          )
          AND nullif("ca"."value_kind" = (2), FALSE)
        )
    )
    UNION ALL
    (
      SELECT
        "ca"."entity_key"
      FROM
        "current_attributes" AS "ca"
      WHERE
        "ca"."attribute_name_key" = $5
        AND (
          "ca"."expires_at" IS NULL
          OR "ca"."expires_at" > NOW()
        )
        AND (
          "ca"."attribute_kind" = (5)
          AND "ca"."value_object" IS NOT NULL
        )
        AND EXISTS (
          SELECT
            1
          FROM
            jsonb_array_elements(
              (
                CASE
                  WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                END
              )
            ) AS "ls"
          WHERE
            ("ls"."value" ->> ('@value')) ~ $6
        )
    )
  ) AS "matches"
1: Int 2
2: String 'text-71.*'
3: Int 2
4: String 'text-71.*'
5: Int 2
6: String 'text-71.*'
