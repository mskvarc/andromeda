---
source: crates/andromeda-postgresql-query/src/q_predicate/typed_column.rs
---
SELECT
  (
    (("ca"."value_string") COLLATE "und-x-icu") <= $1
    OR (("ca"."value_long_text") COLLATE "und-x-icu") <= $2
  )
  AND nullif("ca"."value_kind" = (2), FALSE)
1: String 'urn:ngsi-ld:Person:1'
2: String 'urn:ngsi-ld:Person:1'
