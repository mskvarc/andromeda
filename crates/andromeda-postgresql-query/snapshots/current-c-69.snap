---
source: crates/andromeda-postgresql-query/src/q_predicate/corpus_statement_tests.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca_ln1"
      JOIN jsonb_array_elements_text(
        COALESCE(
          "ca_ln1"."value_object",
          jsonb_build_array(
            COALESCE("ca_ln1"."value_uri", "ca_ln1"."value_long_uri")
          )
        )
      ) AS "lo1" ON TRUE
      JOIN "entities" AS "le1" ON "le1"."id" = "lo1"
      JOIN "entity_search" AS "ls1" ON "ls1"."entity_key" = "le1"."entity_key"
    WHERE
      "ca_ln1"."entity_key" = "entities"."entity_key"
      AND "ca_ln1"."attribute_name_key" = $1
      AND "ca_ln1"."attribute_kind" IN (2, 8)
      AND (
        "ca_ln1"."expires_at" IS NULL
        OR "ca_ln1"."expires_at" > NOW()
      )
      AND (
        "le1"."created_at" IS NOT NULL
        AND (
          "le1"."expires_at" IS NULL
          OR "le1"."expires_at" > NOW()
        )
      )
      AND (FALSE)
      AND EXISTS (
        SELECT
          1
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $2
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            "ca"."value_number" = $3
            OR (
              "ca"."attribute_kind" <> (6)
              AND (
                (
                  (
                    "ca"."value_object" @> jsonb_build_array($4::numeric)
                  )
                  OR (
                    "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $5::numeric))
                  )
                  OR (
                    "ca"."value_object" @> jsonb_build_array($6::text)
                  )
                  OR (
                    "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $7::text))
                  )
                )
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    jsonb_array_elements(
                      (
                        CASE
                          WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                        END
                      )
                    ) AS "dm"
                    LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                      CASE
                        WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                      END
                    )
                  WHERE
                    (
                      CASE
                        WHEN (
                          jsonb_typeof(
                            COALESCE("dm"."value" -> ('@value'), "dm"."value")
                          ) = ('number')
                        ) THEN (
                          COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}')) <> ('NaN') AND pg_input_is_valid(COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'), 'numeric')) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric END) = $8)))) AND "ca"."entity_key" = "le1"."entity_key"))
1: Int 22
2: Int 1
3: BigDecimal 10
4: BigDecimal 10
5: BigDecimal 10
6: String '10'
7: String '10'
8: BigDecimal 10
