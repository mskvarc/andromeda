---
source: crates/andromeda-postgresql-query/src/q_predicate/language_term.rs
---
SELECT
  EXISTS (
    SELECT
      1
    FROM
      jsonb_array_elements("map") AS "ls"
  )
  AND (
    NOT COALESCE(
      EXISTS (
        SELECT
          1
        FROM
          jsonb_array_elements("map") AS "ls"
        WHERE
          (
            ("ls"."value" ->> ('@value')) COLLATE "und-x-icu"
          ) >= $1
          AND (
            ("ls"."value" ->> ('@value')) COLLATE "und-x-icu"
          ) <= $2
      ),
      FALSE
    )
  )
1: String 'a'
2: String 'm'
