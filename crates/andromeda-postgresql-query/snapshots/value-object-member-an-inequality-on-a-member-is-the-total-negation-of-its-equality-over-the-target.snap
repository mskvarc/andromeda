SELECT
WHERE
  (
    "ca"."attribute_kind" IN (1, 2, 4, 5, 6, 7, 8)
    AND (
      EXISTS (
        SELECT
          1
        FROM
          (
            SELECT
              jsonb_path_query_array(
                "member"."member",
                'lax $[*] ? (exists(@."@value"))'
              ) AS "member"
            FROM
              jsonb_path_query(
                "ca"."value_object",
                'strict $."city"',
                '{}',
                TRUE
              ) AS "member"
          ) AS "member"
        WHERE
          jsonb_array_length("member"."member") >= (1)
          AND (
            NOT COALESCE(
              (
                jsonb_array_length("member"."member") = (1)
                AND (
                  CASE
                    WHEN (
                      jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('number')
                    ) THEN (
                      (("member"."member" -> (0)) -> ('@value')) #>> ('{}'))::numeric WHEN (jsonb_typeof(("member"."member" -> (0)) -> ('@value')) = ('string') AND (("member"."member" -> (0)) ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND ((("member"."member" -> (0)) -> ('@value')) #>> ('{}')) <> ('NaN') AND pg_input_is_valid((("member"."member" -> (0)) -> ('@value')) #>> ('{}'), 'numeric')) THEN ((("member"."member" -> (0)) -> ('@value')) #>> ('{}'))::numeric END) = $1) OR (jsonb_array_length("member"."member") >= (2) AND EXISTS(SELECT 1 FROM jsonb_path_query("member"."member", 'strict $[*]') AS "element" WHERE (CASE WHEN (jsonb_typeof("element"."element" -> ('@value')) = ('number')) THEN (("element"."element" -> ('@value')) #>> ('{}'))::numeric WHEN (jsonb_typeof("element"."element" -> ('@value')) = ('string') AND ("element"."element" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND (("element"."element" -> ('@value')) #>> ('{}')) <> ('NaN') AND pg_input_is_valid(("element"."element" -> ('@value')) #>> ('{}'), 'numeric')) THEN (("element"."element" -> ('@value')) #>> ('{}'))::numeric END) = $2)), FALSE))) OR EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query((CASE WHEN (("ca"."value_object" ->> ('@type')) = ('@json')) THEN "ca"."value_object" -> ('@value') END), 'strict $."city"', '{}', TRUE) AS "member") AS "member" WHERE (TRUE) AND (NOT COALESCE(((NOT jsonb_typeof("member"."member") = ('array')) AND (CASE WHEN (jsonb_typeof("member"."member") = ('number')) THEN ("member"."member" #>> ('{}'))::numeric WHEN (jsonb_typeof("member"."member") = ('string') AND (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND ("member"."member" #>> ('{}')) <> ('NaN') AND pg_input_is_valid("member"."member" #>> ('{}'), 'numeric')) THEN ("member"."member" #>> ('{}'))::numeric END) = $3) OR (jsonb_typeof("member"."member") = ('array') AND EXISTS(SELECT 1 FROM jsonb_path_query("member"."member", 'strict $[*]') AS "element" WHERE (CASE WHEN (jsonb_typeof("element"."element") = ('number')) THEN ("element"."element" #>> ('{}'))::numeric WHEN (jsonb_typeof("element"."element") = ('string') AND (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND ("element"."element" #>> ('{}')) <> ('NaN') AND pg_input_is_valid("element"."element" #>> ('{}'), 'numeric')) THEN ("element"."element" #>> ('{}'))::numeric END) = $4)), FALSE))))) OR ("ca"."attribute_kind" = (6) AND EXISTS(SELECT 1 FROM (SELECT "member"."member" AS "member" FROM jsonb_path_query("ca"."value_object", 'strict $."city"', '{}', TRUE) AS "member") AS "member" WHERE (TRUE) AND (NOT COALESCE(((NOT jsonb_typeof("member"."member") = ('array')) AND (CASE WHEN (jsonb_typeof("member"."member") = ('number')) THEN ("member"."member" #>> ('{}'))::numeric WHEN (jsonb_typeof("member"."member") = ('string') AND (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInt