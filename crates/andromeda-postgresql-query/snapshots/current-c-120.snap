---
source: crates/andromeda-postgresql-query/src/q_predicate/corpus_statement_tests.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  EXISTS (
    SELECT
      1
    FROM
      "current_attributes" AS "ca"
    WHERE
      (
        "ca"."expires_at" IS NULL
        OR "ca"."expires_at" > NOW()
      )
      AND (
        (
          "ca"."attribute_name_key" = $1
          AND (
            "ca"."value_number" > $2
            AND "ca"."value_number" <> ('NaN'::numeric)
          )
        )
        OR (
          "ca"."attribute_name_key" = $3
          AND (
            (
              ("ca"."value_string" ~ $4)
              AND nullif("ca"."value_kind" = (2), FALSE)
            )
            OR (
              (
                (("ca"."value_long_text") COLLATE "default") ~ $5
              )
              AND nullif("ca"."value_kind" = (2), FALSE)
            )
            OR EXISTS (
              SELECT
                1
              FROM
                jsonb_array_elements(
                  (
                    CASE
                      WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                    END
                  )
                ) AS "ls"
              WHERE
                ("ls"."value" ->> ('@value')) ~ $6
            )
          )
        )
      )
      AND "ca"."entity_key" = "entities"."entity_key"
  )
1: Int 1
2: BigDecimal 15
3: Int 2
4: String '^abc$'
5: String '^abc$'
6: String '^abc$'
