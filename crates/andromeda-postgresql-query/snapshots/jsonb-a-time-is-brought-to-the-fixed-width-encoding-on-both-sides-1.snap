---
source: crates/andromeda-postgresql-query/src/jsonb.rs
---
SELECT
  (
    CASE
      WHEN (
        "datatype" = ('https://uri.etsi.org/ngsi-ld/Time')
        AND pg_input_is_valid(
          ('1970-01-01T') || (
            "stored" #>> ('{}')), 'timestamptz')) THEN to_char(((('1970-01-01T') || ("stored" #>> ('{}')))::timestamptz) AT TIME ZONE ('UTC'), 'HH24:MI:SS.US') || ('Z') END)
