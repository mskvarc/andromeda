---
source: crates/andromeda-postgresql-context-store/src/notification_delivery/delivery_insert.rs
---
INSERT INTO
  "snap_5"."notification_deliveries" (
    "event_key",
    "subscription_key",
    "next_attempt_at",
    "held_at",
    "committed_at",
    "event_ordinal"
  )
SELECT
  "p"."event_key",
  "s"."subscription_key",
  NOW(),
  (
    CASE
      WHEN (
        EXISTS (
          SELECT
            "h"."subscription_key"
          FROM
            "snap_5"."notification_delivery_holds" AS "h"
          WHERE
            "h"."subscription_key" = "s"."subscription_key"
          FOR KEY SHARE
        )
      ) THEN CURRENT_TIMESTAMP
      ELSE NULL
    END
  ),
  NOW(),
  "p"."event_ordinal"
FROM
  UNNEST($1::bigint[], $2::integer[], $3::bigint[]) AS p(event_key, event_ordinal, subscription_key)
  INNER JOIN "snap_5"."subscriptions" AS "s" ON "s"."subscription_key" = "p"."subscription_key"
FOR KEY SHARE
  OF "s"
ON CONFLICT
  ("event_key", "subscription_key")
DO NOTHING
1: Array ARRAY [42,42,43]
2: Array ARRAY [0,0,1]
3: Array ARRAY [1,2,1]
