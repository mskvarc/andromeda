---
source: crates/andromeda-postgresql-context-store/src/notification_delivery/delivery_insert.rs
---
INSERT INTO
  "notification_deliveries" (
    "event_key",
    "subscription_key",
    "next_attempt_at",
    "held_at",
    "committed_at",
    "event_ordinal"
  )
SELECT
  "p"."event_key",
  "s"."subscription_key",
  $1,
  (
    CASE
      WHEN (
        EXISTS (
          SELECT
            "h"."subscription_key"
          FROM
            "notification_delivery_holds" AS "h"
          WHERE
            "h"."subscription_key" = "s"."subscription_key"
          FOR KEY SHARE
        )
        AND EXISTS (
          SELECT
            $2
          FROM
            "notification_deliveries" AS "earlier"
          WHERE
            "earlier"."subscription_key" = "s"."subscription_key"
            AND "earlier"."delivered_at" IS NULL
            AND "earlier"."exhausted_at" IS NULL
            AND (
              "earlier"."committed_at",
              "earlier"."event_ordinal"
            ) < ($3, "p"."event_ordinal")
        )
      ) THEN CURRENT_TIMESTAMP
      ELSE NULL
    END
  ),
  $4,
  "p"."event_ordinal"
FROM
  UNNEST($5::bigint[], $6::integer[], $7::bigint[]) AS p(event_key, event_ordinal, subscription_key)
  INNER JOIN "subscriptions" AS "s" ON "s"."subscription_key" = "p"."subscription_key"
FOR KEY SHARE
  OF "s"
ON CONFLICT
  ("event_key", "subscription_key")
DO NOTHING
1: ChronoDateTimeUtc '2025-01-27 21:00:00.000000 +00:00'
2: Int 1
3: ChronoDateTimeUtc '2025-01-27 21:00:00.000000 +00:00'
4: ChronoDateTimeUtc '2025-01-27 21:00:00.000000 +00:00'
5: Array ARRAY [42,42,43]
6: Array ARRAY [0,0,1]
7: Array ARRAY [1,2,1]
