---
source: crates/andromeda-postgresql-context-store/src/notification_delivery/claim.rs
---
SELECT
  "delivery_key"
FROM
  "notification_deliveries"
WHERE
  "delivered_at" IS NULL
  AND "exhausted_at" IS NULL
  AND "held_at" IS NULL
  AND GREATEST(
    "next_attempt_at",
    COALESCE("lease_until", '-infinity'::timestamptz)
  ) <= CURRENT_TIMESTAMP
  AND (
    "subscription_key" <> ALL (
      ARRAY (
        SELECT
          "subscription_key"
        FROM
          "notification_delivery_holds"
      )
    )
    OR (
      NOT EXISTS (
        SELECT
          $1
        FROM
          "notification_deliveries" AS "earlier"
        WHERE
          "earlier"."subscription_key" = "notification_deliveries"."subscription_key"
          AND "earlier"."delivered_at" IS NULL
          AND "earlier"."exhausted_at" IS NULL
          AND (
            "earlier"."committed_at",
            "earlier"."event_ordinal",
            "earlier"."delivery_key"
          ) < (
            "notification_deliveries"."committed_at",
            "notification_deliveries"."event_ordinal",
            "notification_deliveries"."delivery_key"
          )
      )
    )
  )
ORDER BY
  GREATEST(
    "next_attempt_at",
    COALESCE("lease_until", '-infinity'::timestamptz)
  ) ASC,
  "delivery_key" ASC
LIMIT
  10
FOR UPDATE
  SKIP LOCKED
1: Int 1
