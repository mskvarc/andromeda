---
source: crates/andromeda-postgresql-context-store/src/notification_delivery/hold.rs
---
WITH
"successor" AS (
  SELECT
    "delivery_key"
  FROM
    "notification_deliveries"
  WHERE
    "subscription_key" = $1
    AND "held_at" IS NOT NULL
  ORDER BY
    "committed_at" ASC,
    "event_ordinal" ASC,
    "delivery_key" ASC
  LIMIT
    1
),
"handed_over" AS (
  UPDATE
    "notification_delivery_holds"
  SET
    "delivery_key" = "successor"."delivery_key"
  FROM
    "successor"
  WHERE
    "notification_delivery_holds"."subscription_key" = $2
),
"dropped" AS (
  DELETE FROM
    "notification_delivery_holds"
  WHERE
    "subscription_key" = $3
    AND (
      NOT EXISTS (
        SELECT
          $4
        FROM
          "successor"
      )
    )
),
"revived" AS (
  UPDATE
    "notification_deliveries"
  SET
    "held_at" = NULL,
    "next_attempt_at" = CURRENT_TIMESTAMP + (make_interval(secs => $5))
  FROM
    "successor"
  WHERE
    "notification_deliveries"."delivery_key" = "successor"."delivery_key"
)
SELECT
  "delivery_key"
FROM
  "successor"
1: BigInt 7
2: BigInt 7
3: BigInt 7
4: Int 1
5: Double 5
