---
source: crates/andromeda-postgresql-context-query/src/census_total.rs
---
SELECT
  (
    SELECT
      COALESCE(SUM("entity_delta")::bigint, $1)
    FROM
      "snap_5"."entity_type_census"
    WHERE
      "entity_type_name_key" = (3)
  ) - (
    SELECT
      COUNT(*)
    FROM
      "snap_5"."entities"
      INNER JOIN "snap_5"."entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
    WHERE
      "entities"."expires_at" <= NOW()
      AND (
        "entity_search"."entity_type_name_keys" @> (ARRAY[3])
      )
  )
1: BigInt 0
