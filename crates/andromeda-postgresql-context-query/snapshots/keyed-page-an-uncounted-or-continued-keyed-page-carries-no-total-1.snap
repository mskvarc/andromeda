4: String 'text-71.*'
5: Int 12
6: String 'text-71.*'
7: Int 12
8: String 'text-71.*'
9: Int 12
10: String 'text-71.*'
11: BigUnsigned 100
12: BigUnsigned 100
13: BigUnsigned 10000
14: Int 12
15: String 'text-71.*'
16: String 'text-71.*'
17: String 'text-71.*'
18: BigUnsigned 100
19: BigUnsigned 10000
