---
source: crates/andromeda-postgresql-context-query/src/id_pattern_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths",
  "page"."total_count" AS "total_count",
  "page"."gated_step" AS "gated_step"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "selected"."entity_key",
            "selected"."id" AS "sort_0"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (18)
                AND "is_current_member"
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            5000 OFFSET 0
        ) AS "walked"
      WHERE
        "walked"."sort_0" ~ $1
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entities"."entity_key"
      FROM
        "entities"
      WHERE
        ((("entities"."id") COLLATE "default") ~ $2)
        AND (
          "entities"."created_at" IS NOT NULL
          AND (
            "entities"."expires_at" IS NULL
            OR "entities"."expires_at" > NOW()
          )
        )
      LIMIT
        1001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *,
          $3 AS "total_count",
          $4 AS "gated_step"
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $5
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "selected"."entity_key",
            "selected"."id" AS "sort_0",
            COUNT(*) OVER () AS "total_count",
            $6 AS "gated_step"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (18)
                AND "is_current_member"
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
            AND "selected"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $7
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $8
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *,
        $9 AS "total_count",
        $10 AS "gated_step"
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "selected"."entity_key",
                "selected"."id" AS "sort_0"
              FROM
                (
                  SELECT
                    "entity_key",
                    "id"
                  FROM
                    "entity_type_members"
                  WHERE
                    "entity_type_name_key" = (18)
                    AND "is_current_member"
                ) AS "selected"
              WHERE
                "selected"."entity_key" NOT IN (
                  SELECT
                    "entity_key"
                  FROM
                    "entities"
                  WHERE
                    "expires_at" <= NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
          WHERE
            ("walked"."sort_0" ~ $11)
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $12
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $13
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: String '.*_1196287$'
2: String '.*_1196287$'
3: BigInt NULL
4: SmallInt 1
5: BigUnsigned 100
6: SmallInt 2
7: BigUnsigned 100
8: BigUnsigned 1000
9: BigInt NULL
10: SmallInt 3
11: String '.*_1196287$'
12: BigUnsigned 100
13: BigUnsigned 1000
