---
source: crates/andromeda-postgresql-context-query/src/page_shape.rs
---
SELECT
  COUNT(*)
FROM
  "entities"
  JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
WHERE
  "entities"."created_at" IS NOT NULL
  AND (
    "entities"."expires_at" IS NULL
    OR "entities"."expires_at" > NOW()
  )
  AND (
    "entity_search"."entity_type_name_keys" @> (ARRAY[3])
  )
  AND "entities"."entity_key" IN (
    SELECT DISTINCT
      "geo_matched"."entity_key"
    FROM
      (
        SELECT
          "geo_default"."entity_key"
        FROM
          "entity_search" AS "geo_default"
        WHERE
          (
            "geo_default"."location_expires_at" IS NULL
            OR "geo_default"."location_expires_at" > NOW()
          )
          AND (
            COALESCE(
              "geo_default"."location_reach",
              "geo_default"."location"
            ) && ST_MakeValid(ST_GeomFromEWKB($1))
          )
          AND _ST_Within(
            "geo_default"."location",
            ST_MakeValid(ST_GeomFromEWKB($2))
          )
        UNION ALL
        (
          SELECT
            "geo_location_instance"."entity_key"
          FROM
            "current_attributes" AS "geo_location_instance"
          WHERE
            "geo_location_instance"."attribute_name_key" = $3
            AND "geo_location_instance"."dataset_key" <> ('')
            AND (
              "geo_location_instance"."expires_at" IS NULL
              OR "geo_location_instance"."expires_at" > NOW()
            )
            AND "geo_location_instance"."value_geometry" IS NOT NULL
            AND (
              COALESCE(
                "geo_location_instance"."value_geometry_reach",
                "geo_location_instance"."value_geometry_valid",
                "geo_location_instance"."value_geometry"
              ) && ST_MakeValid(ST_GeomFromEWKB($4))
            )
            AND _ST_Within(
              COALESCE(
                "geo_location_instance"."value_geometry_valid",
                "geo_location_instance"."value_geometry"
              ),
              ST_MakeValid(ST_GeomFromEWKB($5))
            )
        )
      ) AS "geo_matched"
    ORDER BY
      "geo_matched"."entity_key" ASC
  )
1: Bytes '\x0103000020E610000001000000050000000000000000000000000000000000444000000000000024400000000000004440000000000000244000000000000049400000000000000000000000000000494000000000000000000000000000004440'
2: Bytes '\x0103000020E610000001000000050000000000000000000000000000000000444000000000000024400000000000004440000000000000244000000000000049400000000000000000000000000000494000000000000000000000000000004440'
3: Int 9
