---
source: crates/andromeda-postgresql-context-query/src/keyed_count.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "entity_key"
  FROM
    (
      SELECT
        "ca"."entity_key"
      FROM
        "current_attributes" AS "ca"
      WHERE
        "ca"."attribute_name_key" = $1
        AND (
          "ca"."expires_at" IS NULL
          OR "ca"."expires_at" > NOW()
        )
        AND ((("ca"."value_string") COLLATE "default") ~ $2)
      UNION ALL
      (
        SELECT
          "ca"."entity_key"
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $3
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            (("ca"."value_long_text") COLLATE "default") ~ $4
          )
      )
      UNION ALL
      (
        SELECT
          "ca"."entity_key"
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $5
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            "ca"."attribute_kind" = (5)
            AND "ca"."value_object" IS NOT NULL
          )
          AND EXISTS (
            SELECT
              1
            FROM
              jsonb_array_elements(
                (
                  CASE
                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                  END
                )
              ) AS "ls"
            WHERE
              ("ls"."value" ->> ('@value')) ~ $6
          )
      )
    ) AS "matches"
  LIMIT
    10001
)
SELECT
  (
    CASE
      WHEN (
        (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $7
      ) THEN (
        SELECT
          COUNT(*)
        FROM
          "entities"
        WHERE
          "entities"."created_at" IS NOT NULL
          AND (
            "entities"."expires_at" IS NULL
            OR "entities"."expires_at" > NOW()
          )
          AND (
            TRUE
            AND EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca"
              WHERE
                "ca"."attribute_name_key" = $8
                AND (
                  "ca"."expires_at" IS NULL
                  OR "ca"."expires_at" > NOW()
                )
                AND (
                  NOT COALESCE(
                    (
                      "ca"."value_string" = $9
                      AND nullif("ca"."value_kind" = (2), FALSE)
                    )
                    OR "ca"."value_uri" = $10
                    OR (
                      "ca"."attribute_kind" <> (6)
                      AND (
                        (
                          (
                            "ca"."value_object" @> jsonb_build_array($11::text)
                          )
                          OR (
                            "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $12::text))
                          )
                        )
                        AND EXISTS (
                          SELECT
                            1
                          FROM
                            jsonb_array_elements(
                              (
                                CASE
                                  WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                                END
                              )
                            ) AS "dm"
                            LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                              CASE
                                WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                              END
                            )
                          WHERE
                            (
                              CASE
                                WHEN (
                                  jsonb_typeof(
                                    COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                  ) = ('string')
                                  AND (
                                    NOT COALESCE(
                                      COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                        'https://uri.etsi.org/ngsi-ld/DateTime',
                                        'https://uri.etsi.org/ngsi-ld/Date',
                                        'https://uri.etsi.org/ngsi-ld/Time'
                                      )
                                      OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                        'http://www.w3.org/2001/XMLSchema#decimal',
                                        'http://www.w3.org/2001/XMLSchema#integer',
                                        'http://www.w3.org/2001/XMLSchema#long',
                                        'http://www.w3.org/2001/XMLSchema#int',
                                        'http://www.w3.org/2001/XMLSchema#short',
                                        'http://www.w3.org/2001/XMLSchema#byte',
                                        'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                        'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                        'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                        'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                        'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                        'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                        'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                        'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                        'http://www.w3.org/2001/XMLSchema#float',
                                        'http://www.w3.org/2001/XMLSchema#double'
                                      )
                                      OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                      FALSE
                                    )
                                  )
                                ) THEN (
                                  COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $13))), FALSE)) AND "ca"."entity_key" = "entities"."entity_key")) AND "entities"."entity_key" IN (SELECT "entity_key" FROM "candidates")) ELSE (SELECT COUNT(*) FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) AND (EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $14 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (((("ca"."value_string") COLLATE "default") ~ $15) OR ((("ca"."value_long_text") COLLATE "default") ~ $16) OR EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object" END)) AS "ls" WHERE ("ls"."value" ->> ('@value')) ~ $17)) AND "ca"."entity_key" = "entities"."entity_key") AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $18 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (NOT COALESCE(("ca"."value_string" = $19 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $20 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($21::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $22::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $23))), FALSE)) AND "ca"."entity_key" = "entities"."entity_key"))) END)
