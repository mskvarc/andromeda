---
source: crates/andromeda-postgresql-context-query/src/csr/entity_specification.rs
---
SELECT
  1
WHERE
  (COALESCE("ri"."entity_types", '{*}') && $1)
  AND (
    "ri"."entity_types" IS NULL
    OR (
      ("ri"."entity_types" && $2)
      AND ("ri"."entity_types" @> $3)
    )
  )
1: Array ARRAY ['https://example.com/Home','https://example.com/Vehicle','https://example.com/Boat','*']
2: Array ARRAY ['https://example.com/Vehicle','https://example.com/Boat']
3: Array ARRAY ['https://example.com/Home']
