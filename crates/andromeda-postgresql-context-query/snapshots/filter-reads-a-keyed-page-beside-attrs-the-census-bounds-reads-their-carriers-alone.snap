ies") > $37 AND (SELECT COUNT(*) FROM "short_walk") < $38 AND (SELECT COUNT(*) FROM "continued_walk") >= $39 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "continued") UNION ALL (SELECT * FROM (SELECT "selected"."entity_key", "selected"."id" AS "sort_0" FROM (SELECT "entity_key", "id" FROM "entity_type_members" WHERE "entity_type_name_key" = (3) AND "is_current_member") AS "selected" JOIN "entity_search" ON "entity_search"."entity_key" = "selected"."entity_key" WHERE "selected"."entity_key" NOT IN (SELECT "entity_key" FROM "entities" WHERE "expires_at" <= NOW()) AND (("entity_search"."attribute_name_keys" @> (ARRAY[16])) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $40 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND "ca"."entity_key" = "selected"."entity_key")) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $41 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $42 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $43 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($44::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $45::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://w