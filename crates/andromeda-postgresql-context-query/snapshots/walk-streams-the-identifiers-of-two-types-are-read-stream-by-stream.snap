---
source: crates/andromeda-postgresql-context-query/src/walk_streams.rs
---
SELECT
  *
FROM
  (
    SELECT
      *
    FROM
      (
        SELECT
          "selected"."id" AS "id",
          "selected"."entity_key",
          "selected"."id" AS "sort_0"
        FROM
          (
            SELECT
              "entity_key",
              "id"
            FROM
              "entity_type_members"
            WHERE
              "entity_type_name_key" = (3)
              AND "is_current_member"
          ) AS "selected"
        WHERE
          "selected"."entity_key" NOT IN (
            SELECT
              "entity_key"
            FROM
              "entities"
            WHERE
              "expires_at" <= NOW()
          )
        ORDER BY
          "sort_0" ASC
        LIMIT
          60
      ) AS "stream"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "selected"."id" AS "id",
            "selected"."entity_key",
            "selected"."id" AS "sort_0"
          FROM
            (
              SELECT
                "unseen"."entity_key",
                "unseen"."id"
              FROM
                (
                  SELECT
                    "entity_key",
                    "id"
                  FROM
                    "entity_type_members"
                  WHERE
                    "entity_type_name_key" = (4)
                    AND "is_current_member"
                ) AS "unseen"
              WHERE
                NOT EXISTS (
                  SELECT
                    1
                  FROM
                    "entity_type_members" AS "type_member"
                  WHERE
                    "type_member"."entity_type_name_key" = (3)
                    AND "type_member"."id" = "unseen"."id"
                    AND "type_member"."is_current_member"
                )
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            60
        ) AS "stream"
    )
  ) AS "streams"
ORDER BY
  "sort_0" ASC
LIMIT
  20 OFFSET 40
