---
source: crates/andromeda-postgresql-context-query/src/carrier_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND "entities"."id" > $1
          ORDER BY
            "sort_0" ASC
          LIMIT
            5000
        ) AS "walked"
      WHERE
        EXISTS (
          SELECT
            $2
          FROM
            "entity_search" AS "probed"
          WHERE
            ("probed"."attribute_name_keys" @> (ARRAY[28]))
            AND "probed"."entity_key" = "walked"."entity_key"
        )
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        20
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entity_search"."entity_key"
      FROM
        "entity_search"
      WHERE
        "entity_search"."attribute_name_keys" @> (ARRAY[28])
      LIMIT
        50001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $3
        ORDER BY
          "sort_0" ASC
        LIMIT
          20
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              "entity_search"."attribute_name_keys" @> (ARRAY[28])
            )
            AND "entities"."entity_key" IN (
              SELECT
                "entity_key"
              FROM
                "candidates"
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $4
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $5
            AND "entities"."id" > $6
          ORDER BY
            "sort_0" ASC
          LIMIT
            20
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              "entity_search"."attribute_name_keys" @> (ARRAY[28])
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $7
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $8
            AND "entities"."id" > $9
          ORDER BY
            "sort_0" ASC
          LIMIT
            20
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: String 'urn:ngsi-ld:Trip:042'
2: Int 1
3: BigUnsigned 20
4: BigUnsigned 20
5: BigUnsigned 50000
6: String 'urn:ngsi-ld:Trip:042'
7: BigUnsigned 20
8: BigUnsigned 50000
9: String 'urn:ngsi-ld:Trip:042'
