---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  COUNT(*)
FROM
  (
    SELECT
      "entity_key",
      "id"
    FROM
      "entity_type_members"
    WHERE
      FALSE
  ) AS "selected"
WHERE
  "selected"."entity_key" NOT IN (
    SELECT
      "entity_key"
    FROM
      "entities"
    WHERE
      "expires_at" <= NOW()
  )
