---
source: crates/andromeda-postgresql-context-query/src/selector_predicate.rs
---
SELECT
  $1
WHERE
  (
    ((("selected"."id") COLLATE "default") ~ $2)
    AND EXISTS (
      SELECT
        1
      FROM
        "entity_type_members" AS "type_member"
      WHERE
        "type_member"."entity_type_name_key" = (1)
        AND "type_member"."id" = "selected"."id"
        AND "type_member"."is_current_member"
    )
  )
  OR EXISTS (
    SELECT
      1
    FROM
      "entity_type_members" AS "type_member"
    WHERE
      "type_member"."entity_type_name_key" = (2)
      AND "type_member"."id" = "selected"."id"
      AND "type_member"."is_current_member"
  )
1: Int 1
2: String 'urn:a.*'
