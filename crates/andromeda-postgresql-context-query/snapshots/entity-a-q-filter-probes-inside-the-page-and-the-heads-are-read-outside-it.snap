---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    SELECT
      "entities"."entity_key",
      "entities"."id" AS "sort_0"
    FROM
      "entities"
    WHERE
      "entities"."created_at" IS NOT NULL
      AND (
        "entities"."expires_at" IS NULL
        OR "entities"."expires_at" > NOW()
      )
      AND EXISTS (
        SELECT
          1
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $1
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            NOT COALESCE(
              "ca"."value_number" = $2
              OR (
                "ca"."attribute_kind" <> (6)
                AND (
                  (
                    (
                      "ca"."value_object" @> jsonb_build_array($3::numeric)
                    )
                    OR (
                      "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $4::numeric))
                    )
                    OR (
                      "ca"."value_object" @> jsonb_build_array($5::text)
                    )
                    OR (
                      "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $6::text))
                    )
                  )
                  AND EXISTS (
                    SELECT
                      1
                    FROM
                      jsonb_array_elements(
                        (
                          CASE
                            WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                          END
                        )
                      ) AS "dm"
                      LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                        CASE
                          WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                        END
                      )
                    WHERE
                      (
                        CASE
                          WHEN (
                            jsonb_typeof(
                              COALESCE("dm"."value" -> ('@value'), "dm"."value")
                            ) = ('number')
                          ) THEN (
                            COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}')) <> ('NaN') AND pg_input_is_valid(COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'), 'numeric')) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric END) = $7))), FALSE)) AND "ca"."entity_key" = "entities"."entity_key") ORDER BY "sort_0" ASC LIMIT 20 OFFSET 0) AS "page" INNER JOIN LATERAL (SELECT "e"."entity_key" AS "entity_key", "e"."id" AS "id", "e"."created_at" AS "entity_created_at", "e"."modified_at" AS "entity_modified_at", "e"."write_count" AS "entity_write_count", "e"."expires_at" AS "entity_expires_at", "s"."entity_type_name_keys" AS "entity_type_name_keys", "s"."verbatim_scope_paths" AS "verbatim_scope_paths" FROM "entities" AS "e" INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key" WHERE "e"."entity_key" = "page"."entity_key" LIMIT 1) AS "stored" ON TRUE ORDER BY "page"."sort_0" ASC
1: Int 12
2: BigDecimal 1
3: BigDecimal 1
4: BigDecimal 1
5: String '1'
6: String '1'
7: BigDecimal 1
