---
source: crates/andromeda-postgresql-context-query/src/entity_relations.rs
---
SELECT
  "entities"."id"
FROM
  "entities"
  INNER JOIN LATERAL (
    SELECT
      *
    FROM
      "entity_search"
    WHERE
      "entity_search"."entity_key" = "entities"."entity_key" OFFSET 0
  ) AS "entity_search" ON TRUE
WHERE
  "entities"."created_at" IS NOT NULL
  AND (
    "entities"."expires_at" IS NULL
    OR "entities"."expires_at" > NOW()
  )
