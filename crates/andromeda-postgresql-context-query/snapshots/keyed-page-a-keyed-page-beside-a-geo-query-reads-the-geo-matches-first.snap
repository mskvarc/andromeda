SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "selected"."entity_key",
            "selected"."id" AS "sort_0"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (3)
                AND "is_current_member"
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca"
              WHERE
                "ca"."attribute_name_key" = $1
                AND (
                  "ca"."expires_at" IS NULL
                  OR "ca"."expires_at" > NOW()
                )
                AND (
                  (
                    "ca"."value_string" = $2
                    AND nullif("ca"."value_kind" = (2), FALSE)
                  )
                  OR "ca"."value_uri" = $3
                  OR (
                    "ca"."attribute_kind" <> (6)
                    AND (
                      (
                        (
                          "ca"."value_object" @> jsonb_build_array($4::text)
                        )
                        OR (
                          "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $5::text))
                        )
                      )
                      AND EXISTS (
                        SELECT
                          1
                        FROM
                          jsonb_array_elements(
                            (
                              CASE
                                WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                              END
                            )
                          ) AS "dm"
                          LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                            CASE
                              WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                            END
                          )
                        WHERE
                          (
                            CASE
                              WHEN (
                                jsonb_typeof(
                                  COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                ) = ('string')
                                AND (
                                  NOT COALESCE(
                                    COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                      'https://uri.etsi.org/ngsi-ld/DateTime',
                                      'https://uri.etsi.org/ngsi-ld/Date',
                                      'https://uri.etsi.org/ngsi-ld/Time'
                                    )
                                    OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                      'http://www.w3.org/2001/XMLSchema#decimal',
                                      'http://www.w3.org/2001/XMLSchema#integer',
                                      'http://www.w3.org/2001/XMLSchema#long',
                                      'http://www.w3.org/2001/XMLSchema#int',
                                      'http://www.w3.org/2001/XMLSchema#short',
                                      'http://www.w3.org/2001/XMLSchema#byte',
                                      'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                      'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                      'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                      'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                      'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                      'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                      'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                      'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                      'http://www.w3.org/2001/XMLSchema#float',
                                      'http://www.w3.org/2001/XMLSchema#double'
                                    )
                                    OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                    FALSE
                                  )
                                )
                              ) THEN (
                                COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $6)))) AND "ca"."entity_key" = "walked"."entity_key") AND (EXISTS(SELECT 1 FROM "entity_search" AS "geo_default" WHERE "geo_default"."entity_key" = "walked"."entity_key" AND ("geo_default"."location_expires_at" IS NULL OR "geo_default"."location_expires_at" > NOW()) AND (COALESCE("geo_default"."location_reach", "geo_default"."location")::box2d && ST_MakeValid(ST_GeomFromEWKB($7))::box2d) AND _ST_Within("geo_default"."location", ST_MakeValid(ST_GeomFromEWKB($8)))) OR EXISTS(SELECT 1 FROM "current_attributes" AS "geo_location_instance" WHERE "geo_location_instance"."entity_key" = "walked"."entity_key" AND "geo_location_instance"."attribute_name_key" = $9 AND "geo_location_instance"."dataset_key" <> ('') AND ("geo_location_instance"."expires_at" IS NULL OR "geo_location_instance"."expires_at" > NOW()) AND "geo_location_instance"."value_geometry" IS NOT NULL AND (COALESCE("geo_location_instance"."value_geometry_reach", "geo_location_instance"."value_geometry_valid", "geo_location_instance"."value_geometry")::box2d && ST_MakeValid(ST_GeomFromEWKB($10))::box2d) AND _ST_Within(COALESCE("geo_location_instance"."value_geometry_valid", "geo_location_instance"."value_geometry"), ST_MakeValid(ST_GeomFromEWKB($11))))) OFFSET 0) AS "kept" ON TRUE ORDER BY "walked"."sort_0" ASC LIMIT 100) , "candidates" AS  MATERIALIZED (SELECT "geo_default"."entity_key" FROM "entity_search" AS "geo_default" WHERE ("geo_default"."location_expires_at" IS NULL OR "geo_default"."location_expires_at" > NOW()) AND (COALESCE("geo_default"."location_reach", "geo_default"."location") && ST_MakeValid(ST_GeomFromEWKB($12))) AND _ST_Within("geo_default"."location", ST_MakeValid(ST_GeomFromEWKB($13))) UNION ALL (SELECT "geo_location_instance"."entity_key" FROM "current_attributes" AS "geo_location_instance" WHERE "geo_location_instance"."attribute_name_key" = $14 AND "geo_location_instance"."dataset_key