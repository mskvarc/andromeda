---
source: crates/andromeda-postgresql-context-query/src/carrier_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            5000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                $1
              FROM
                "entity_search" AS "probed"
              WHERE
                ("probed"."attribute_name_keys" @> (ARRAY[28]))
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    "ca"."attribute_name_key" = $2
                    AND (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND "ca"."entity_key" = "walked"."entity_key"
                )
                AND "probed"."entity_key" = "walked"."entity_key"
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entity_search"."entity_key"
      FROM
        "entity_search"
      WHERE
        "entity_search"."attribute_name_keys" @> (ARRAY[28])
      LIMIT
        50001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $3
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              (
                "entity_search"."attribute_name_keys" @> (ARRAY[28])
              )
              AND EXISTS (
                SELECT
                  1
                FROM
                  "current_attributes" AS "ca"
                WHERE
                  "ca"."attribute_name_key" = $4
                  AND (
                    "ca"."expires_at" IS NULL
                    OR "ca"."expires_at" > NOW()
                  )
                  AND "ca"."entity_key" = "entities"."entity_key"
              )
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $5
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $6
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                EXISTS (
                  SELECT
                    $7
                  FROM
                    "entity_search" AS "probed"
                  WHERE
                    ("probed"."attribute_name_keys" @> (ARRAY[28]))
                    AND EXISTS (
                      SELECT
                        1
                      FROM
                        "current_attributes" AS "ca"
                      WHERE
                        "ca"."attribute_name_key" = $8
                        AND (
                          "ca"."expires_at" IS NULL
                          OR "ca"."expires_at" > NOW()
                        )
                        AND "ca"."entity_key" = "walked"."entity_key"
                    )
                    AND "probed"."entity_key" = "walked"."entity_key"
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $9
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $10
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: Int 1
2: Int 28
3: BigUnsigned 100
4: Int 28
5: BigUnsigned 100
6: BigUnsigned 50000
7: Int 1
8: Int 28
9: BigUnsigned 100
10: BigUnsigned 50000
