---
source: crates/andromeda-postgresql-context-query/src/attribute_value_order.rs
---
SELECT
  (
    CASE
      WHEN (
        jsonb_typeof(
          COALESCE(
            jsonb_path_query_first(
              "ordered"."value_object",
              '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'
            )
          )
        ) = ('number')
      ) THEN (
        COALESCE(
          jsonb_path_query_first(
            "ordered"."value_object",
            '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'
          )
        ) #>> ('{}'))::numeric END) AS "value_number", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('boolean')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) #>> ('{}'))::boolean END) AS "value_boolean", NULL::timestamptz AS "value_date_time", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('string')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) #>> ('{}'))::text END) AS "value_text", NULL::text AS "value_declared_datatype", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) END) AS "value_object", (CASE WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('number')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) #>> ('{}'))::numeric END) IS NOT NULL) THEN 'number' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('boolean')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) #>> ('{}'))::boolean END) IS NOT NULL) THEN 'boolean' WHEN ((NULL::timestamptz) IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((NULL::text) = ('https://uri.etsi.org/ngsi-ld/DateTime')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((NULL::text) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((NULL::text) = ('https://uri.etsi.org/ngsi-ld/Time')) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('string')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) #>> ('{}'))::text END) IS NOT NULL) THEN 'string' WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) = ('null')) THEN 'null' WHEN (jsonb_typeof((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) END)) = ('array') OR ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) END) ? ('@list'))) THEN 'array' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Ee][Nn]-[Gg][Bb]$")."@value"')) END) IS NOT NULL) THEN 'object' END) AS "value_datatype" FROM (SELECT "ca".* FROM "current_attributes" AS "ca" WHERE "ca"."entity_key" = "entities"."entity_key" AND (FALSE) ORDER BY "ca"."ordinal" ASC LIMIT 1) AS "ordered"
