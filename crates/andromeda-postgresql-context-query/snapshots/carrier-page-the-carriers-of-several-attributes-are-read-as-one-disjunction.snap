---
source: crates/andromeda-postgresql-context-query/src/carrier_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            5000 OFFSET 0
        ) AS "walked"
      WHERE
        EXISTS (
          SELECT
            $1
          FROM
            "entity_search" AS "probed"
          WHERE
            (
              ("probed"."attribute_name_keys" @> (ARRAY[28]))
              OR ("probed"."attribute_name_keys" @> (ARRAY[12]))
              OR (FALSE)
            )
            AND EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca"
              WHERE
                (
                  "ca"."expires_at" IS NULL
                  OR "ca"."expires_at" > NOW()
                )
                AND (
                  "ca"."attribute_name_key" = $2
                  OR "ca"."attribute_name_key" = $3
                )
                AND "ca"."entity_key" = "walked"."entity_key"
            )
            AND "probed"."entity_key" = "walked"."entity_key"
        )
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entity_search"."entity_key"
      FROM
        "entity_search"
      WHERE
        (
          "entity_search"."attribute_name_keys" @> (ARRAY[28])
        )
        OR (
          "entity_search"."attribute_name_keys" @> (ARRAY[12])
        )
        OR (FALSE)
      LIMIT
        50001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $4
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              (
                (
                  "entity_search"."attribute_name_keys" @> (ARRAY[28])
                )
                OR (
                  "entity_search"."attribute_name_keys" @> (ARRAY[12])
                )
                OR (FALSE)
              )
              AND EXISTS (
                SELECT
                  1
                FROM
                  "current_attributes" AS "ca"
                WHERE
                  (
                    "ca"."expires_at" IS NULL
                    OR "ca"."expires_at" > NOW()
                  )
                  AND (
                    "ca"."attribute_name_key" = $5
                    OR "ca"."attribute_name_key" = $6
                  )
                  AND "ca"."entity_key" = "entities"."entity_key"
              )
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $7
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $8
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
          WHERE
            EXISTS (
              SELECT
                $9
              FROM
                "entity_search" AS "probed"
              WHERE
                (
                  ("probed"."attribute_name_keys" @> (ARRAY[28]))
                  OR ("probed"."attribute_name_keys" @> (ARRAY[12]))
                  OR (FALSE)
                )
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND (
                      "ca"."attribute_name_key" = $10
                      OR "ca"."attribute_name_key" = $11
                    )
                    AND "ca"."entity_key" = "walked"."entity_key"
                )
                AND "probed"."entity_key" = "walked"."entity_key"
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $12
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $13
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: Int 1
2: Int 28
3: Int 12
4: BigUnsigned 100
5: Int 28
6: Int 12
7: BigUnsigned 100
8: BigUnsigned 50000
9: Int 1
10: Int 28
11: Int 12
12: BigUnsigned 100
13: BigUnsigned 50000
