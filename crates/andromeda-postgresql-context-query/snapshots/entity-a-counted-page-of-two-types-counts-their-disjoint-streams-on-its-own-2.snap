---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  COUNT(*)
FROM
  (
    SELECT
      "entity_key",
      "id"
    FROM
      "entity_type_members"
    WHERE
      "entity_type_name_key" = (1)
      AND "is_current_member"
    UNION ALL
    (
      SELECT
        "unseen"."entity_key",
        "unseen"."id"
      FROM
        (
          SELECT
            "entity_key",
            "id"
          FROM
            "entity_type_members"
          WHERE
            "entity_type_name_key" = (2)
            AND "is_current_member"
        ) AS "unseen"
      WHERE
        NOT EXISTS (
          SELECT
            1
          FROM
            "entity_type_members" AS "type_member"
          WHERE
            "type_member"."entity_type_name_key" = (1)
            AND "type_member"."id" = "unseen"."id"
            AND "type_member"."is_current_member"
        )
    )
  ) AS "selected"
WHERE
  "selected"."entity_key" NOT IN (
    SELECT
      "entity_key"
    FROM
      "entities"
    WHERE
      "expires_at" <= NOW()
  )
