---
source: crates/andromeda-postgresql-context-query/src/value_walk_page.rs
---
SELECT
  (
    SELECT
      COALESCE(SUM("entity_delta")::bigint, $1)
    FROM
      "entity_type_census"
    WHERE
      "entity_type_name_key" = (1)
  ) - (
    SELECT
      COUNT(*)
    FROM
      "entities"
      INNER JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
    WHERE
      "entities"."expires_at" <= NOW()
      AND (
        "entity_search"."entity_type_name_keys" @> (ARRAY[1])
      )
  )
1: BigInt 0
