---
source: crates/andromeda-postgresql-context-query/src/keyed_count.rs
---
WITH
"candidates" AS MATERIALIZED (
  SELECT
    "entity_key"
  FROM
    (
      SELECT
        "ca"."entity_key"
      FROM
        "current_attributes" AS "ca"
      WHERE
        "ca"."attribute_name_key" = $1
        AND (
          "ca"."expires_at" IS NULL
          OR "ca"."expires_at" > NOW()
        )
        AND ((("ca"."value_string") COLLATE "default") ~ $2)
      UNION ALL
      (
        SELECT
          "ca"."entity_key"
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $3
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            (("ca"."value_long_text") COLLATE "default") ~ $4
          )
      )
      UNION ALL
      (
        SELECT
          "ca"."entity_key"
        FROM
          "current_attributes" AS "ca"
        WHERE
          "ca"."attribute_name_key" = $5
          AND (
            "ca"."expires_at" IS NULL
            OR "ca"."expires_at" > NOW()
          )
          AND (
            "ca"."attribute_kind" = (5)
            AND "ca"."value_object" IS NOT NULL
          )
          AND EXISTS (
            SELECT
              1
            FROM
              jsonb_array_elements(
                (
                  CASE
                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                  END
                )
              ) AS "ls"
            WHERE
              ("ls"."value" ->> ('@value')) ~ $6
          )
      )
    ) AS "matches"
  LIMIT
    10001
)
SELECT
  (
    CASE
      WHEN (
        (
          SELECT
            COUNT(*)
          FROM
            "candidates"
        ) <= $7
      ) THEN (
        SELECT
          COUNT(*)
        FROM
          "entities"
        WHERE
          "entities"."created_at" IS NOT NULL
          AND (
            "entities"."expires_at" IS NULL
            OR "entities"."expires_at" > NOW()
          )
          AND TRUE
          AND "entities"."entity_key" IN (
            SELECT
              "entity_key"
            FROM
              "candidates"
          )
      )
      ELSE (
        SELECT
          COUNT(*)
        FROM
          "entities"
        WHERE
          "entities"."created_at" IS NOT NULL
          AND (
            "entities"."expires_at" IS NULL
            OR "entities"."expires_at" > NOW()
          )
          AND EXISTS (
            SELECT
              1
            FROM
              "current_attributes" AS "ca"
            WHERE
              "ca"."attribute_name_key" = $8
              AND (
                "ca"."expires_at" IS NULL
                OR "ca"."expires_at" > NOW()
              )
              AND (
                ((("ca"."value_string") COLLATE "default") ~ $9)
                OR (
                  (("ca"."value_long_text") COLLATE "default") ~ $10
                )
                OR EXISTS (
                  SELECT
                    1
                  FROM
                    jsonb_array_elements(
                      (
                        CASE
                          WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                        END
                      )
                    ) AS "ls"
                  WHERE
                    ("ls"."value" ->> ('@value')) ~ $11
                )
              )
              AND "ca"."entity_key" = "entities"."entity_key"
          )
      )
    END
  )
1: Int 12
2: String 'text-71.*'
3: Int 12
4: String 'text-71.*'
5: Int 12
6: String 'text-71.*'
7: BigUnsigned 10000
8: Int 12
9: String 'text-71.*'
10: String 'text-71.*'
11: String 'text-71.*'
