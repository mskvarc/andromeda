SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "entries" AS MATERIALIZED (
      SELECT
        *
      FROM
        (
          SELECT
            1
          FROM
            "current_attributes" AS "ca"
          WHERE
            "ca"."attribute_name_key" = $1
            AND "ca"."value_string" = $2
          UNION ALL
          (
            SELECT
              1
            FROM
              "current_attributes" AS "ca"
            WHERE
              "ca"."attribute_name_key" = $3
              AND "ca"."value_uri" = $4
          )
          UNION ALL
          (
            SELECT
              1
            FROM
              "current_attributes" AS "ca"
            WHERE
              "ca"."attribute_name_key" = $5
              AND "ca"."attribute_kind" <> (6)
              AND (
                (
                  (
                    "ca"."value_object" @> jsonb_build_array($6::text)
                  )
                  OR (
                    "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $7::text))
                  )
                )
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    jsonb_array_elements(
                      (
                        CASE
                          WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                        END
                      )
                    ) AS "dm"
                    LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                      CASE
                        WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                      END
                    )
                  WHERE
                    (
                      CASE
                        WHEN (
                          jsonb_typeof(
                            COALESCE("dm"."value" -> ('@value'), "dm"."value")
                          ) = ('string')
                          AND (
                            NOT COALESCE(
                              COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                'https://uri.etsi.org/ngsi-ld/DateTime',
                                'https://uri.etsi.org/ngsi-ld/Date',
                                'https://uri.etsi.org/ngsi-ld/Time'
                              )
                              OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                'http://www.w3.org/2001/XMLSchema#decimal',
                                'http://www.w3.org/2001/XMLSchema#integer',
                                'http://www.w3.org/2001/XMLSchema#long',
                                'http://www.w3.org/2001/XMLSchema#int',
                                'http://www.w3.org/2001/XMLSchema#short',
                                'http://www.w3.org/2001/XMLSchema#byte',
                                'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                'http://www.w3.org/2001/XMLSchema#float',
                                'http://www.w3.org/2001/XMLSchema#double'
                              )
                              OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                              FALSE
                            )
                          )
                        ) THEN (
                          COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $8)))) AS "matches" LIMIT 1001) , "short_walk" AS  MATERIALIZED (SELECT "walked".* FROM (SELECT "selected"."entity_key", "selected"."id" AS "sort_0" FROM (SELECT "entity_key", "id" FROM "entity_type_members" WHERE "entity_type_name_key" = (3) AND "is_current_member") AS "selected" WHERE "selected"."entity_key" NOT IN (SELECT "entity_key" FROM "entities" WHERE "expires_at" <= NOW()) ORDER BY "sort_0" ASC LIMIT 1000 OFFSET 0) AS "walked" INNER JOIN LATERAL (SELECT 1 FROM "entity_search" WHERE "entity_search"."entity_key" = "walked"."entity_key" AND ("entity_search"."scope_paths" ~ ($9::lquery)) OFFSET 0) AS "filtered" ON TRUE INNER JOIN LATERAL (SELECT 1 WHERE EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $10 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ((("ca"."value_string" = $11 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $12 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($13::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $14::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema