---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    SELECT
      "entities"."entity_key",
      (
        CASE
          WHEN (
            "entity_search"."location_expires_at" IS NULL
            OR "entity_search"."location_expires_at" > NOW()
          ) THEN ST_DistanceSphere(
            "entity_search"."location",
            ST_MakeValid(ST_GeomFromEWKB($1))
          )
          ELSE NULL
        END
      ) AS "sort_0",
      array_position($2::text[], "order_value_0"."value_datatype") AS "sort_1",
      (
        CASE
          WHEN ("order_value_0"."value_datatype" = ('number')) THEN "order_value_0"."value_number"
        END
      ) AS "sort_2",
      (
        CASE
          WHEN (
            "order_value_0"."value_datatype" = ('https://uri.etsi.org/ngsi-ld/DateTime')
          ) THEN COALESCE(
            "order_value_0"."value_date_time",
            (
              CASE
                WHEN (
                  "order_value_0"."value_declared_datatype" = ('https://uri.etsi.org/ngsi-ld/DateTime')
                  AND pg_input_is_valid("order_value_0"."value_text", 'timestamptz')
                ) THEN ("order_value_0"."value_text")::timestamptz
              END
            )
          )
        END
      ) AS "sort_3",
      (
        (
          CASE
            WHEN (
              "order_value_0"."value_datatype" = ('https://uri.etsi.org/ngsi-ld/Time')
            ) THEN (
              CASE
                WHEN (
                  "order_value_0"."value_declared_datatype" = ('https://uri.etsi.org/ngsi-ld/Time')
                  AND pg_input_is_valid(
                    ('1970-01-01T') || "order_value_0"."value_text",
                    'timestamptz'
                  )
                ) THEN to_char(
                  (
                    (('1970-01-01T') || "order_value_0"."value_text")::timestamptz
                  ) AT TIME ZONE ('UTC'),
                  'HH24:MI:SS.US'
                ) || ('Z')
              END
            )
            ELSE COALESCE(
              "order_value_0"."value_text",
              ("order_value_0"."value_object" -> (0)) ->> ('@value'),
              "order_value_0"."value_object" ->> (0)
            )
          END
        )
      ) COLLATE "und-x-icu" AS "sort_4",
      "entities"."id" AS "sort_5"
    FROM
      "entities"
      JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
      LEFT JOIN LATERAL (
        SELECT
          COALESCE(
            "ordered"."value_number",
            (
              CASE
                WHEN (
                  jsonb_typeof("ordered"."value_object") = ('number')
                ) THEN (
                  "ordered"."value_object" #>> ('{}'))::numeric END)) AS "value_number", COALESCE("ordered"."value_boolean", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('boolean')) THEN ("ordered"."value_object" #>> ('{}'))::boolean END)) AS "value_boolean", "ordered"."value_date_time" AS "value_date_time", COALESCE("ordered"."value_string", "ordered"."value_long_text", "ordered"."value_uri", "ordered"."value_long_uri", (CASE WHEN ("ordered"."attribute_kind" = (5)) THEN ("ordered"."value_object" -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('string')) THEN ("ordered"."value_object" #>> ('{}'))::text END)) AS "value_text", (CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) AS "value_declared_datatype", COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) AS "value_object", COALESCE((CASE WHEN ("ordered"."value_kind" = (1)) THEN 'number' WHEN ("ordered"."value_kind" = (2)) THEN 'string' WHEN ("ordered"."value_kind" = (3)) THEN 'boolean' WHEN ("ordered"."value_kind" = (6)) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ("ordered"."value_kind" = (7)) THEN 'string' WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN ("ordered"."value_kind" = (10)) THEN 'number' WHEN ("ordered"."value_kind" = (11)) THEN 'boolean' END), (CASE WHEN (COALESCE("ordered"."value_number", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('number')) THEN ("ordered"."value_object" #>> ('{}'))::numeric END)) IS NOT NULL) THEN 'number' WHEN (COALESCE("ordered"."value_boolean", (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('boolean')) THEN ("ordered"."value_object" #>> ('{}'))::boolean END)) IS NOT NULL) THEN 'boolean' WHEN ("ordered"."value_date_time" IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/DateTime')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((CASE WHEN ("ordered"."value_kind" = (8)) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ("ordered"."value_kind" = (9)) THEN 'https://uri.etsi.org/ngsi-ld/Time' END) = ('https://uri.etsi.org/ngsi-ld/Time')) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN (COALESCE("ordered"."value_string", "ordered"."value_long_text", "ordered"."value_uri", "ordered"."value_long_uri", (CASE WHEN ("ordered"."attribute_kind" = (5)) THEN ("ordered"."value_object" -> (0)) ->> ('@value') END), (CASE WHEN (jsonb_typeof("ordered"."value_object") = ('string')) THEN ("ordered"."value_object" #>> ('{}'))::text END)) IS NOT NULL) THEN 'string' WHEN ("ordered"."value_object" IN (jsonb_build_object('@value', NULL::jsonb, '@type', '@json'), 'null'::jsonb)) THEN 'null' WHEN (jsonb_typeof(COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END))) = ('array') OR (COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) ? ('@list'))) THEN 'array' WHEN (COALESCE((CASE WHEN (jsonb_typeof("ordered"."value_object") IN ('object', 'array')) THEN "ordered"."value_object" END), (CASE WHEN ("ordered"."value_geometry" IS NOT NULL) THEN jsonb_build_object() END)) IS NOT NULL) THEN 'object' END)) AS "value_datatype" FROM (SELECT "ca".* FROM "current_attributes" AS "ca" WHERE "ca"."entity_key" = "entities"."entity_key" AND (FALSE) ORDER BY "ca"."ordinal" ASC LIMIT 1) AS "ordered") AS "order_value_0" ON TRUE WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) AND "entities"."entity_key" IN (SELECT DISTINCT "geo_matched"."entity_key" FROM (SELECT "geo_default"."entity_key" FROM "entity_search" AS "geo_default" WHERE ("geo_default"."location_expires_at" IS NULL OR "geo_default"."location_expires_at" > NOW()) AND (COALESCE("geo_default"."location_reach", "geo_default"."location") && ST_MakeEnvelope($3, $4, $5, $6, $7)) AND _ST_DWithin("geo_default"."location"::geography, ST_MakeValid(ST_GeomFromEWKB($8))::geography, $9)) AS "geo_matched" ORDER BY "geo_matched"."entity_key" ASC) ORDER BY "sort_0" ASC NULLS LAST, "sort_1" ASC NULLS LAST, "sort_2" ASC, "sort_3" ASC, "sort_4" ASC, "sort_5" ASC LIMIT 20 OFFSET 0) AS "page" INNER JOIN LATERAL (SELECT "e"."entity_key" AS "entity_key", "e"."id" AS "id", "e"."created_at" AS "entity_created_at", "e"."modified_at" AS "entity_modified_at", "e"."write_count" AS "entity_write_count", "e"."expires_at" AS "entity_expires_at", "s"."entity_type_name_keys" AS "entity_type_name_keys", "s"."verbatim_scope_paths" AS "verbatim_scope_paths" FROM "entities" AS "e" INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key" WHERE "e"."entity_key" = "page"."entity_key" LIMIT 1) AS "stored" ON TRUE ORDER BY "page"."sort_0" ASC NULLS LAST, "page"."sort_1" ASC NULLS LAST, "page"."sort_2" ASC, "page"."sort_3" ASC, "page"."sort_4" ASC, "page"."sort_5" ASC
1: Bytes '\x0101000020E6100000075F984C15CC2A40AC8BDB6800474A40'
2: Array ARRAY ['number','string','object','array','boolean','https://uri.etsi.org/ngsi-ld/Time','https://uri.etsi.org/ngsi-ld/Date','https://uri.etsi.org/ngsi-ld/DateTime','null']
