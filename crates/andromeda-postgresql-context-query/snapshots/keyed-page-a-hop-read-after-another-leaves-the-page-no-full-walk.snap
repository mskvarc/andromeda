SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "entries" AS MATERIALIZED (
      SELECT
        *
      FROM
        (
          SELECT
            1
          FROM
            "current_attributes" AS "ca"
          WHERE
            "ca"."attribute_name_key" = $1
            AND (
              "ca"."value_number" > $2
              AND "ca"."value_number" <> ('NaN'::numeric)
            )
        ) AS "matches"
      LIMIT
        1001
    ),
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            (
              CASE
                WHEN (
                  EXISTS (
                    SELECT
                      1
                    FROM
                      "current_attributes" AS "ca"
                    WHERE
                      "ca"."attribute_name_key" = $3
                      AND (
                        "ca"."expires_at" IS NULL
                        OR "ca"."expires_at" > NOW()
                      )
                      AND (
                        (
                          "ca"."value_number" > $4
                          AND "ca"."value_number" <> ('NaN'::numeric)
                        ) IS TRUE
                      )
                      AND "ca"."entity_key" = "walked"."entity_key"
                  )
                ) THEN TRUE
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca_ln1"
                    JOIN jsonb_array_elements_text(
                      COALESCE(
                        "ca_ln1"."value_object",
                        jsonb_build_array(
                          COALESCE("ca_ln1"."value_uri", "ca_ln1"."value_long_uri")
                        )
                      )
                    ) AS "lo1" ON TRUE
                    JOIN "entities" AS "le1" ON "le1"."id" = "lo1"
                  WHERE
                    "ca_ln1"."entity_key" = "walked"."entity_key"
                    AND "ca_ln1"."attribute_name_key" = $5
                    AND "ca_ln1"."attribute_kind" IN (2, 8)
                    AND (
                      "ca_ln1"."expires_at" IS NULL
                      OR "ca_ln1"."expires_at" > NOW()
                    )
                    AND (
                      "le1"."created_at" IS NOT NULL
                      AND (
                        "le1"."expires_at" IS NULL
                        OR "le1"."expires_at" > NOW()
                      )
                    )
                    AND EXISTS (
                      SELECT
                        1
                      FROM
                        "current_attributes" AS "ca"
                      WHERE
                        "ca"."attribute_name_key" = $6
                        AND (
                          "ca"."expires_at" IS NULL
                          OR "ca"."expires_at" > NOW()
                        )
                        AND (
                          (
                            "ca"."value_string" = $7
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR "ca"."value_uri" = $8
                          OR (
                            "ca"."attribute_kind" <> (6)
                            AND (
                              (
                                (
                                  "ca"."value_object" @> jsonb_build_array($9::text)
                                )
                                OR (
                                  "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $10::text))
                                )
                              )
                              AND EXISTS (
                                SELECT
                                  1
                                FROM
                                  jsonb_array_elements(
                                    (
                                      CASE
                                        WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                                      END
                                    )
                                  ) AS "dm"
                                  LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                                    CASE
                                      WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                                    END
                                  )
                                WHERE
                                  (
                                    CASE
                                      WHEN (
                                        jsonb_typeof(
                                          COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                        ) = ('string')
                                        AND (
                                          NOT COALESCE(
                                            COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                              'https://uri.etsi.org/ngsi-ld/DateTime',
                                              'https://uri.etsi.org/ngsi-ld/Date',
                                              'https://uri.etsi.org/ngsi-ld/Time'
                                            )
                                            OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                              'http://www.w3.org/2001/XMLSchema#decimal',
                                              'http://www.w3.org/2001/XMLSchema#integer',
                                              'http://www.w3.org/2001/XMLSchema#long',
                                              'http://www.w3.org/2001/XMLSchema#int',
                                              'http://www.w3.org/2001/XMLSchema#short',
                                              'http://www.w3.org/2001/XMLSchema#byte',
                                              'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                              'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                              'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                              'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                              'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                              'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                              'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                              'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                              'http://www.w3.org/2001/XMLSchema#float',
                                              'http://www.w3.org/2001/XMLSchema#double'
                                            )
                                            OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                            FALSE
                                          )
                                        )
                                      ) THEN (
                                        COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $11)))) AND "ca"."entity_key" = "le1"."entity_key")) ELSE FALSE END) OFFSET 0) AS "kept" ON TRUE ORDER BY "walked"."sort_0" ASC LIMIT 100) , "continued_walk" AS  MATERIALIZED (SELECT * FROM (SELECT * FROM "short_walk" UNION ALL (SELECT * FROM (SELECT "walked".* FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) ORDER BY "sort_0" ASC LIMIT 4000 OFFSET 1000) AS "walked" INNER JOIN LATERAL (SELECT 1 WHERE (CASE WHEN (EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $12 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_number" > $13 AND "ca"."value_number" <> ('NaN'::numeric)) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key")) THEN TRUE AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca_ln1" JOIN jsonb_array_elements_text(COALESCE("ca_ln1"."value_object", jsonb_build_array(COALESCE("ca_ln1"."value_uri", "ca_ln1"."value_long_uri")))) AS "lo1" ON TRUE JOIN "entities" AS "le1" ON "le1"."id" = "lo1" WHERE "ca_ln1"."entity_key" = "walked"."entity_key" AND "ca_ln1"."attribute_name_key" = $14 AND "ca_ln1"."attribute_kind" IN (2, 8) AND ("ca_ln1"."expires_at" IS NULL OR "ca_ln1"."expires_at" > NOW()) AND ("le1"."created_at" IS NOT NULL AND ("le1"."expires_at" IS NULL OR "le1"."expires_at" > NOW())) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $15 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $16 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $17 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($18::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $19::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $20)))) AND "ca"."entity_key" = "le1"."entity_key")) ELSE FALSE END) OFFSET 0) AS "kept" ON TRUE WHERE (SELECT COUNT(*) FROM "short_walk") < $21 AND (SELECT COUNT(*) FROM "short_walk") >= $22 ORDER BY "walked"."sort_0" ASC LIMIT 80) AS "walked_on")) AS "walks" ORDER BY "sort_0" ASC LIMIT 100) , "candidates" AS  MATERIALIZED (SELECT "entity_key" FROM (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $23 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ("ca"."value_number" > $24 AND "ca"."value_number" <> ('NaN'::numeric))) AS "matches" LIMIT 10001) , "candidates_2" AS  MATERIALIZED (SELECT "entity_key" FROM (SELECT "ca_ln1"."entity_key" FROM "entities" AS "le1" JOIN "current_attributes" AS "ca_ln1" ON "ca_ln1"."attribute_name_key" = $25 AND "ca_ln1"."value_uri" = "le1"."id" WHERE "ca_ln1"."attribute_kind" IN (2, 8) AND ("ca_ln1"."expires_at" IS NULL OR "ca_ln1"."expires_at" > NOW()) AND ("le1"."created_at" IS NOT NULL AND ("le1"."expires_at" IS NULL OR "le1"."expires_at" > NOW())) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $26 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $27 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $28 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($29::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $30::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3