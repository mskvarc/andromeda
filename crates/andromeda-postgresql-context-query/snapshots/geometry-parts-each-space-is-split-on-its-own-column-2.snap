---
source: crates/andromeda-postgresql-context-query/src/csr/geometry_parts.rs
---
SELECT
  "id"
FROM
  "context_source_registrations"
WHERE
  "observation_space" IS NOT NULL
  AND (
    (
      COALESCE(
        "observation_space_reach",
        "observation_space_valid",
        "observation_space"
      ) && ST_MakeValid(ST_GeomFromEWKB($1))
    )
    AND _ST_Intersects(
      COALESCE("observation_space_valid", "observation_space"),
      ST_MakeValid(ST_GeomFromEWKB($2))
    )
  )
1: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
2: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
