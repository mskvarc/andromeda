---
source: crates/andromeda-postgresql-context-query/src/keyed_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            (
              CASE
                WHEN (
                  EXISTS (
                    SELECT
                      1
                    FROM
                      "current_attributes" AS "ca"
                    WHERE
                      "ca"."attribute_name_key" = $1
                      AND (
                        "ca"."expires_at" IS NULL
                        OR "ca"."expires_at" > NOW()
                      )
                      AND (
                        (
                          (
                            ((("ca"."value_string") COLLATE "default") ~ $2)
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR (
                            (
                              (("ca"."value_long_text") COLLATE "default") ~ $3
                            )
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR EXISTS (
                            SELECT
                              1
                            FROM
                              jsonb_array_elements(
                                (
                                  CASE
                                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                                  END
                                )
                              ) AS "ls"
                            WHERE
                              ("ls"."value" ->> ('@value')) ~ $4
                          )
                        ) IS TRUE
                      )
                      AND "ca"."entity_key" = "walked"."entity_key"
                  )
                ) THEN EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    "ca"."attribute_name_key" = $5
                    AND (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND "ca"."entity_key" = "walked"."entity_key"
                )
                AND TRUE
                ELSE FALSE
              END
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "continued_walk" AS MATERIALIZED (
      SELECT
        *
      FROM
        (
          SELECT
            *
          FROM
            "short_walk"
          UNION ALL
          (
            SELECT
              *
            FROM
              (
                SELECT
                  "walked".*
                FROM
                  (
                    SELECT
                      "entities"."entity_key",
                      "entities"."id" AS "sort_0"
                    FROM
                      "entities"
                    WHERE
                      "entities"."created_at" IS NOT NULL
                      AND (
                        "entities"."expires_at" IS NULL
                        OR "entities"."expires_at" > NOW()
                      )
                    ORDER BY
                      "sort_0" ASC
                    LIMIT
                      4000 OFFSET 1000
                  ) AS "walked"
                  INNER JOIN LATERAL (
                    SELECT
                      1
                    WHERE
                      (
                        CASE
                          WHEN (
                            EXISTS (
                              SELECT
                                1
                              FROM
                                "current_attributes" AS "ca"
                              WHERE
                                "ca"."attribute_name_key" = $6
                                AND (
                                  "ca"."expires_at" IS NULL
                                  OR "ca"."expires_at" > NOW()
                                )
                                AND (
                                  (
                                    (
                                      ((("ca"."value_string") COLLATE "default") ~ $7)
                                      AND nullif("ca"."value_kind" = (2), FALSE)
                                    )
                                    OR (
                                      (
                                        (("ca"."value_long_text") COLLATE "default") ~ $8
                                      )
                                      AND nullif("ca"."value_kind" = (2), FALSE)
                                    )
                                    OR EXISTS (
                                      SELECT
                                        1
                                      FROM
                                        jsonb_array_elements(
                                          (
                                            CASE
                                              WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                                            END
                                          )
                                        ) AS "ls"
                                      WHERE
                                        ("ls"."value" ->> ('@value')) ~ $9
                                    )
                                  ) IS TRUE
                                )
                                AND "ca"."entity_key" = "walked"."entity_key"
                            )
                          ) THEN EXISTS (
                            SELECT
                              1
                            FROM
                              "current_attributes" AS "ca"
                            WHERE
                              "ca"."attribute_name_key" = $10
                              AND (
                                "ca"."expires_at" IS NULL
                                OR "ca"."expires_at" > NOW()
                              )
                              AND "ca"."entity_key" = "walked"."entity_key"
                          )
                          AND TRUE
                          ELSE FALSE
                        END
                      ) OFFSET 0
                  ) AS "kept" ON TRUE
                WHERE
                  (
                    SELECT
                      COUNT(*)
                    FROM
                      "short_walk"
                  ) < $11
                  AND (
                    SELECT
                      COUNT(*)
                    FROM
                      "short_walk"
                  ) >= $12
                ORDER BY
                  "walked"."sort_0" ASC
                LIMIT
                  80
              ) AS "walked_on"
          )
        ) AS "walks"
      ORDER BY
        "sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entity_key"
      FROM
        (
          SELECT
            "ca"."entity_key"
          FROM
            "current_attributes" AS "ca"
          WHERE
            "ca"."attribute_name_key" = $13
            AND (
              "ca"."expires_at" IS NULL
              OR "ca"."expires_at" > NOW()
            )
            AND (
              ((("ca"."value_string") COLLATE "default") ~ $14)
              AND nullif("ca"."value_kind" = (2), FALSE)
            )
          UNION ALL
          (
            SELECT
              "ca"."entity_key"
            FROM
              "current_attributes" AS "ca"
            WHERE
              "ca"."attribute_name_key" = $15
              AND (
                "ca"."expires_at" IS NULL
                OR "ca"."expires_at" > NOW()
              )
              AND (
                (
                  (("ca"."value_long_text") COLLATE "default") ~ $16
                )
                AND nullif("ca"."value_kind" = (2), FALSE)
              )
          )
          UNION ALL
          (
            SELECT
              "ca"."entity_key"
            FROM
              "current_attributes" AS "ca"
            WHERE
              "ca"."attribute_name_key" = $17
              AND (
                "ca"."expires_at" IS NULL
                OR "ca"."expires_at" > NOW()
              )
              AND (
                "ca"."attribute_kind" = (5)
                AND "ca"."value_object" IS NOT NULL
              )
              AND EXISTS (
                SELECT
                  1
                FROM
                  jsonb_array_elements(
                    (
                      CASE
                        WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                      END
                    )
                  ) AS "ls"
                WHERE
                  ("ls"."value" ->> ('@value')) ~ $18
              )
          )
        ) AS "matches"
      LIMIT
        10001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $19
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            *
          FROM
            "continued_walk"
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $20
            AND (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) >= $21
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "continued"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              EXISTS (
                SELECT
                  1
                FROM
                  "current_attributes" AS "ca"
                WHERE
                  "ca"."attribute_name_key" = $22
                  AND (
                    "ca"."expires_at" IS NULL
                    OR "ca"."expires_at" > NOW()
                  )
                  AND "ca"."entity_key" = "entities"."entity_key"
              )
              AND TRUE
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) < $23
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $24
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                (
                  CASE
                    WHEN (
                      EXISTS (
                        SELECT
                          1
                        FROM
                          "current_attributes" AS "ca"
                        WHERE
                          "ca"."attribute_name_key" = $25
                          AND (
                            "ca"."expires_at" IS NULL
                            OR "ca"."expires_at" > NOW()
                          )
                          AND (
                            (
                              (
                                ((("ca"."value_string") COLLATE "default") ~ $26)
                                AND nullif("ca"."value_kind" = (2), FALSE)
                              )
                              OR (
                                (
                                  (("ca"."value_long_text") COLLATE "default") ~ $27
                                )
                                AND nullif("ca"."value_kind" = (2), FALSE)
                              )
                              OR EXISTS (
                                SELECT
                                  1
                                FROM
                                  jsonb_array_elements(
                                    (
                                      CASE
                                        WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                                      END
                                    )
                                  ) AS "ls"
                                WHERE
                                  ("ls"."value" ->> ('@value')) ~ $28
                              )
                            ) IS TRUE
                          )
                          AND "ca"."entity_key" = "walked"."entity_key"
                      )
                    ) THEN EXISTS (
                      SELECT
                        1
                      FROM
                        "current_attributes" AS "ca"
                      WHERE
                        "ca"."attribute_name_key" = $29
                        AND (
                          "ca"."expires_at" IS NULL
                          OR "ca"."expires_at" > NOW()
                        )
                        AND "ca"."entity_key" = "walked"."entity_key"
                    )
                    AND TRUE
                    ELSE FALSE
                  END
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) < $30
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $31
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
