---
source: crates/andromeda-postgresql-context-query/src/csr/statement.rs
---
SELECT
  (
    SELECT
      COUNT(*)
    FROM
      "context_source_registrations"
    WHERE
      (
        "expires_at" IS NULL
        OR "expires_at" > NOW()
      )
      AND EXISTS (
        SELECT
          1
        FROM
          "registration_information" AS "ri"
        WHERE
          "ri"."registration_id" = "context_source_registrations"."id"
          AND (
            (
              COALESCE("ri"."entity_id", '') = ANY($1)
              OR "ri"."entity_id_pattern" IS NOT NULL
            )
            AND (
              "ri"."entity_id" = $2
              OR (
                "ri"."entity_id" IS NULL
                AND (
                  "ri"."entity_id_pattern_form" IS NULL
                  OR EXISTS (
                    SELECT
                      1
                    FROM
                      UNNEST($3) AS "queried"
                    WHERE
                      "queried"."queried" ~ "ri"."entity_id_pattern_form"
                  )
                )
              )
            )
          )
      )
      AND (
        "observation_interval_start" IS NULL
        AND "management_interval_start" IS NULL
      )
      AND "location" IS NULL
  ) + (
    SELECT
      COUNT(*)
    FROM
      "context_source_registrations"
    WHERE
      (
        "expires_at" IS NULL
        OR "expires_at" > NOW()
      )
      AND EXISTS (
        SELECT
          1
        FROM
          "registration_information" AS "ri"
        WHERE
          "ri"."registration_id" = "context_source_registrations"."id"
          AND (
            (
              COALESCE("ri"."entity_id", '') = ANY($4)
              OR "ri"."entity_id_pattern" IS NOT NULL
            )
            AND (
              "ri"."entity_id" = $5
              OR (
                "ri"."entity_id" IS NULL
                AND (
                  "ri"."entity_id_pattern_form" IS NULL
                  OR EXISTS (
                    SELECT
                      1
                    FROM
                      UNNEST($6) AS "queried"
                    WHERE
                      "queried"."queried" ~ "ri"."entity_id_pattern_form"
                  )
                )
              )
            )
          )
      )
      AND (
        "observation_interval_start" IS NULL
        AND "management_interval_start" IS NULL
      )
      AND (
        "location" IS NOT NULL
        AND (
          (
            COALESCE("location_reach", "location_valid", "location") && ST_MakeValid(ST_GeomFromEWKB($7))
          )
          AND _ST_Intersects(
            COALESCE("location_valid", "location"),
            ST_MakeValid(ST_GeomFromEWKB($8))
          )
        )
      )
  )
