                                                    'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                                    'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                                    'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                                    'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                                    'http://www.w3.org/2001/XMLSchema#float',
                                                    'http://www.w3.org/2001/XMLSchema#double'
                                                  )
                                                  OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                                  FALSE
                                                )
                                              )
                                            ) THEN (
                                              COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $8))))))) AND "ca"."entity_key" = "walked"."entity_key" OFFSET 0)) THEN EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $9 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ((NOT COALESCE("ca"."value_number" = $10 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($11::numeric)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $12::numeric))) OR ("ca"."value_object" @> jsonb_build_array($13::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $14::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('number')) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::numeric WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://