                                )
                                OR "l0"."value_uri" = $5
                                OR (
                                  "l0"."attribute_kind" <> (6)
                                  AND (
                                    (
                                      (
                                        sub_attribute_value_object(
                                          "l0"."value_kind",
                                          "l0"."value_object",
                                          "l0"."value_proof"
                                        ) @> jsonb_build_array($6::text)
                                      )
                                      OR (
                                        sub_attribute_value_object(
                                          "l0"."value_kind",
                                          "l0"."value_object",
                                          "l0"."value_proof"
                                        ) @> jsonb_build_array(jsonb_build_object('@value', $7::text))
                                      )
                                    )
                                    AND EXISTS (
                                      SELECT
                                        1
                                      FROM
                                        jsonb_array_elements(
                                          (
                                            CASE
                                              WHEN (
                                                jsonb_typeof(
                                                  sub_attribute_value_object(
                                                    "l0"."value_kind",
                                                    "l0"."value_object",
                                                    "l0"."value_proof"
                                                  )
                                                ) = ('array')
                                              ) THEN sub_attribute_value_object(
                                                "l0"."value_kind",
                                                "l0"."value_object",
                                                "l0"."value_proof"
                                              )
                                            END
