---
source: crates/andromeda-postgresql-context-query/src/geo_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            200 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "entity_search" AS "geo_default"
              WHERE
                "geo_default"."entity_key" = "walked"."entity_key"
                AND (
                  "geo_default"."location_expires_at" IS NULL
                  OR "geo_default"."location_expires_at" > NOW()
                )
                AND (
                  COALESCE(
                    "geo_default"."location_reach",
                    "geo_default"."location"
                  )::box2d && ST_MakeValid(ST_GeomFromEWKB($1))::box2d
                )
                AND _ST_Within(
                  "geo_default"."location",
                  ST_MakeValid(ST_GeomFromEWKB($2))
                )
            )
            OR EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "geo_location_instance"
              WHERE
                "geo_location_instance"."entity_key" = "walked"."entity_key"
                AND "geo_location_instance"."attribute_name_key" = $3
                AND "geo_location_instance"."dataset_key" <> ('')
                AND (
                  "geo_location_instance"."expires_at" IS NULL
                  OR "geo_location_instance"."expires_at" > NOW()
                )
                AND "geo_location_instance"."value_geometry" IS NOT NULL
                AND (
                  COALESCE(
                    "geo_location_instance"."value_geometry_reach",
                    "geo_location_instance"."value_geometry_valid",
                    "geo_location_instance"."value_geometry"
                  )::box2d && ST_MakeValid(ST_GeomFromEWKB($4))::box2d
                )
                AND _ST_Within(
                  COALESCE(
                    "geo_location_instance"."value_geometry_valid",
                    "geo_location_instance"."value_geometry"
                  ),
                  ST_MakeValid(ST_GeomFromEWKB($5))
                )
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "geo_default"."entity_key"
      FROM
        "entity_search" AS "geo_default"
      WHERE
        (
          "geo_default"."location_expires_at" IS NULL
          OR "geo_default"."location_expires_at" > NOW()
        )
        AND (
          COALESCE(
            "geo_default"."location_reach",
            "geo_default"."location"
          ) && ST_MakeValid(ST_GeomFromEWKB($6))
        )
        AND _ST_Within(
          "geo_default"."location",
          ST_MakeValid(ST_GeomFromEWKB($7))
        )
      UNION ALL
      (
        SELECT
          "geo_location_instance"."entity_key"
        FROM
          "current_attributes" AS "geo_location_instance"
        WHERE
          "geo_location_instance"."attribute_name_key" = $8
          AND "geo_location_instance"."dataset_key" <> ('')
          AND (
            "geo_location_instance"."expires_at" IS NULL
            OR "geo_location_instance"."expires_at" > NOW()
          )
          AND "geo_location_instance"."value_geometry" IS NOT NULL
          AND (
            COALESCE(
              "geo_location_instance"."value_geometry_reach",
              "geo_location_instance"."value_geometry_valid",
              "geo_location_instance"."value_geometry"
            ) && ST_MakeValid(ST_GeomFromEWKB($9))
          )
          AND _ST_Within(
            COALESCE(
              "geo_location_instance"."value_geometry_valid",
              "geo_location_instance"."value_geometry"
            ),
            ST_MakeValid(ST_GeomFromEWKB($10))
          )
      )
      LIMIT
        10001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $11
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $12
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $13
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                EXISTS (
                  SELECT
                    1
                  FROM
                    "entity_search" AS "geo_default"
                  WHERE
                    "geo_default"."entity_key" = "walked"."entity_key"
                    AND (
                      "geo_default"."location_expires_at" IS NULL
                      OR "geo_default"."location_expires_at" > NOW()
                    )
                    AND (
                      COALESCE(
                        "geo_default"."location_reach",
                        "geo_default"."location"
                      )::box2d && ST_MakeValid(ST_GeomFromEWKB($14))::box2d
                    )
                    AND _ST_Within(
                      "geo_default"."location",
                      ST_MakeValid(ST_GeomFromEWKB($15))
                    )
                )
                OR EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "geo_location_instance"
                  WHERE
                    "geo_location_instance"."entity_key" = "walked"."entity_key"
                    AND "geo_location_instance"."attribute_name_key" = $16
                    AND "geo_location_instance"."dataset_key" <> ('')
                    AND (
                      "geo_location_instance"."expires_at" IS NULL
                      OR "geo_location_instance"."expires_at" > NOW()
                    )
                    AND "geo_location_instance"."value_geometry" IS NOT NULL
                    AND (
                      COALESCE(
                        "geo_location_instance"."value_geometry_reach",
                        "geo_location_instance"."value_geometry_valid",
                        "geo_location_instance"."value_geometry"
                      )::box2d && ST_MakeValid(ST_GeomFromEWKB($17))::box2d
                    )
                    AND _ST_Within(
                      COALESCE(
                        "geo_location_instance"."value_geometry_valid",
                        "geo_location_instance"."value_geometry"
                      ),
                      ST_MakeValid(ST_GeomFromEWKB($18))
                    )
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $19
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $20
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
