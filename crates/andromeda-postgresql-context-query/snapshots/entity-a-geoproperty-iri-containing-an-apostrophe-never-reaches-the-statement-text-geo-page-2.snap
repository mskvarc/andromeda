---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            200 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "geo_instance"
              WHERE
                "geo_instance"."entity_key" = "walked"."entity_key"
                AND "geo_instance"."attribute_name_key" = $1
                AND "geo_instance"."value_geometry" IS NOT NULL
                AND (
                  "geo_instance"."expires_at" IS NULL
                  OR "geo_instance"."expires_at" > NOW()
                )
                AND (
                  COALESCE(
                    "geo_instance"."value_geometry_reach",
                    "geo_instance"."value_geometry_valid",
                    "geo_instance"."value_geometry"
                  )::box2d && ST_MakeEnvelope($2, $3, $4, $5, $6)::box2d
                )
                AND _ST_DWithin(
                  COALESCE(
                    "geo_instance"."value_geometry_valid",
                    "geo_instance"."value_geometry"
                  )::geography,
                  ST_MakeValid(ST_GeomFromEWKB($7))::geography,
                  $8
                )
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        20
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "geo_instance"."entity_key"
      FROM
        "current_attributes" AS "geo_instance"
      WHERE
        "geo_instance"."attribute_name_key" = $9
        AND "geo_instance"."value_geometry" IS NOT NULL
        AND (
          "geo_instance"."expires_at" IS NULL
          OR "geo_instance"."expires_at" > NOW()
        )
        AND (
          COALESCE(
            "geo_instance"."value_geometry_reach",
            "geo_instance"."value_geometry_valid",
            "geo_instance"."value_geometry"
          ) && ST_MakeEnvelope($10, $11, $12, $13, $14)
        )
        AND _ST_DWithin(
          COALESCE(
            "geo_instance"."value_geometry_valid",
            "geo_instance"."value_geometry"
          )::geography,
          ST_MakeValid(ST_GeomFromEWKB($15))::geography,
          $16
        )
      LIMIT
        10001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $17
        ORDER BY
          "sort_0" ASC
        LIMIT
          20 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $18
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $19
          ORDER BY
            "sort_0" ASC
          LIMIT
            20 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "geo_instance"
                  WHERE
                    "geo_instance"."entity_key" = "walked"."entity_key"
                    AND "geo_instance"."attribute_name_key" = $20
                    AND "geo_instance"."value_geometry" IS NOT NULL
                    AND (
                      "geo_instance"."expires_at" IS NULL
                      OR "geo_instance"."expires_at" > NOW()
                    )
                    AND (
                      COALESCE(
                        "geo_instance"."value_geometry_reach",
                        "geo_instance"."value_geometry_valid",
                        "geo_instance"."value_geometry"
                      )::box2d && ST_MakeEnvelope($21, $22, $23, $24, $25)::box2d
                    )
                    AND _ST_DWithin(
                      COALESCE(
                        "geo_instance"."value_geometry_valid",
                        "geo_instance"."value_geometry"
                      )::geography,
                      ST_MakeValid(ST_GeomFromEWKB($26))::geography,
                      $27
                    )
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $28
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $29
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            20 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
