---
source: crates/andromeda-postgresql-context-query/src/csr/entity_specification.rs
---
SELECT
  1
WHERE
  (COALESCE("ri"."entity_types", '{*}') && $1)
  AND (
    (
      COALESCE("ri"."entity_id", '') = ANY($2)
      OR "ri"."entity_id_pattern" IS NOT NULL
    )
    AND (
      "ri"."entity_id" = $3
      OR (
        "ri"."entity_id" IS NULL
        AND (
          "ri"."entity_id_pattern_form" IS NULL
          OR EXISTS (
            SELECT
              1
            FROM
              UNNEST($4) AS "queried"
            WHERE
              "queried"."queried" ~ "ri"."entity_id_pattern_form"
          )
        )
      )
    )
  )
1: Array ARRAY ['https://example.com/Vehicle','*']
2: Array ARRAY ['urn:ngsi-ld:Vehicle:1','']
3: String 'urn:ngsi-ld:Vehicle:1'
4: Array ARRAY ['urn:ngsi-ld:Vehicle:1']
