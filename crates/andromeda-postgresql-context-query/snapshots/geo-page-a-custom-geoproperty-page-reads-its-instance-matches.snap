---
source: crates/andromeda-postgresql-context-query/src/geo_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "selected"."entity_key",
            "selected"."id" AS "sort_0"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (3)
                AND "is_current_member"
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            200 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "geo_instance"
              WHERE
                "geo_instance"."entity_key" = "walked"."entity_key"
                AND "geo_instance"."attribute_name_key" = $1
                AND "geo_instance"."value_geometry" IS NOT NULL
                AND (
                  "geo_instance"."expires_at" IS NULL
                  OR "geo_instance"."expires_at" > NOW()
                )
                AND (
                  COALESCE(
                    "geo_instance"."value_geometry_reach",
                    "geo_instance"."value_geometry_valid",
                    "geo_instance"."value_geometry"
                  )::box2d && ST_MakeValid(ST_GeomFromEWKB($2))::box2d
                )
                AND _ST_Within(
                  COALESCE(
                    "geo_instance"."value_geometry_valid",
                    "geo_instance"."value_geometry"
                  ),
                  ST_MakeValid(ST_GeomFromEWKB($3))
                )
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        100
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "geo_instance"."entity_key"
      FROM
        "current_attributes" AS "geo_instance"
      WHERE
        "geo_instance"."attribute_name_key" = $4
        AND "geo_instance"."value_geometry" IS NOT NULL
        AND (
          "geo_instance"."expires_at" IS NULL
          OR "geo_instance"."expires_at" > NOW()
        )
        AND (
          COALESCE(
            "geo_instance"."value_geometry_reach",
            "geo_instance"."value_geometry_valid",
            "geo_instance"."value_geometry"
          ) && ST_MakeValid(ST_GeomFromEWKB($5))
        )
        AND _ST_Within(
          COALESCE(
            "geo_instance"."value_geometry_valid",
            "geo_instance"."value_geometry"
          ),
          ST_MakeValid(ST_GeomFromEWKB($6))
        )
      LIMIT
        10001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $7
        ORDER BY
          "sort_0" ASC
        LIMIT
          100 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
            JOIN "entity_search" ON "entity_search"."entity_key" = "entities"."entity_key"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND (
              "entity_search"."entity_type_name_keys" @> (ARRAY[3])
            )
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $8
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $9
          ORDER BY
            "sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "selected"."entity_key",
                "selected"."id" AS "sort_0"
              FROM
                (
                  SELECT
                    "entity_key",
                    "id"
                  FROM
                    "entity_type_members"
                  WHERE
                    "entity_type_name_key" = (3)
                    AND "is_current_member"
                ) AS "selected"
              WHERE
                "selected"."entity_key" NOT IN (
                  SELECT
                    "entity_key"
                  FROM
                    "entities"
                  WHERE
                    "expires_at" <= NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "geo_instance"
                  WHERE
                    "geo_instance"."entity_key" = "walked"."entity_key"
                    AND "geo_instance"."attribute_name_key" = $10
                    AND "geo_instance"."value_geometry" IS NOT NULL
                    AND (
                      "geo_instance"."expires_at" IS NULL
                      OR "geo_instance"."expires_at" > NOW()
                    )
                    AND (
                      COALESCE(
                        "geo_instance"."value_geometry_reach",
                        "geo_instance"."value_geometry_valid",
                        "geo_instance"."value_geometry"
                      )::box2d && ST_MakeValid(ST_GeomFromEWKB($11))::box2d
                    )
                    AND _ST_Within(
                      COALESCE(
                        "geo_instance"."value_geometry_valid",
                        "geo_instance"."value_geometry"
                      ),
                      ST_MakeValid(ST_GeomFromEWKB($12))
                    )
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $13
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $14
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            100 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: Int 42
