---
source: crates/andromeda-postgresql-context-query/src/entity.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca"
              WHERE
                "ca"."attribute_name_key" = $1
                AND (
                  "ca"."expires_at" IS NULL
                  OR "ca"."expires_at" > NOW()
                )
                AND "ca"."entity_key" = "walked"."entity_key"
            ) OFFSET 0
        ) AS "kept" ON TRUE
      ORDER BY
        "walked"."sort_0" ASC
      LIMIT
        20
    ),
    "continued_walk" AS MATERIALIZED (
      SELECT
        *
      FROM
        (
          SELECT
            *
          FROM
            "short_walk"
          UNION ALL
          (
            SELECT
              *
            FROM
              (
                SELECT
                  "walked".*
                FROM
                  (
                    SELECT
                      "entities"."entity_key",
                      "entities"."id" AS "sort_0"
                    FROM
                      "entities"
                    WHERE
                      "entities"."created_at" IS NOT NULL
                      AND (
                        "entities"."expires_at" IS NULL
                        OR "entities"."expires_at" > NOW()
                      )
                    ORDER BY
                      "sort_0" ASC
                    LIMIT
                      4000 OFFSET 1000
                  ) AS "walked"
                  INNER JOIN LATERAL (
                    SELECT
                      1
                    WHERE
                      EXISTS (
                        SELECT
                          1
                        FROM
                          "current_attributes" AS "ca"
                        WHERE
                          "ca"."attribute_name_key" = $2
                          AND (
                            "ca"."expires_at" IS NULL
                            OR "ca"."expires_at" > NOW()
                          )
                          AND "ca"."entity_key" = "walked"."entity_key"
                      ) OFFSET 0
                  ) AS "kept" ON TRUE
                WHERE
                  (
                    SELECT
                      COUNT(*)
                    FROM
                      "short_walk"
                  ) < $3
                  AND (
                    SELECT
                      COUNT(*)
                    FROM
                      "short_walk"
                  ) >= $4
                ORDER BY
                  "walked"."sort_0" ASC
                LIMIT
                  16
              ) AS "walked_on"
          )
        ) AS "walks"
      ORDER BY
        "sort_0" ASC
      LIMIT
        20
    ),
    "candidates" AS MATERIALIZED (
      SELECT
        "entity_search"."entity_key"
      FROM
        "entity_search"
      WHERE
        (
          "entity_search"."attribute_name_keys" @> (ARRAY[12])
        )
        AND EXISTS (
          SELECT
            1
          FROM
            "current_attributes" AS "ca"
          WHERE
            "ca"."attribute_name_key" = $5
            AND (
              "ca"."expires_at" IS NULL
              OR "ca"."expires_at" > NOW()
            )
            AND "ca"."entity_key" = "entity_search"."entity_key"
        )
      LIMIT
        10001
    )
    SELECT
      *
    FROM
      (
        SELECT
          *
        FROM
          "short_walk"
        WHERE
          (
            SELECT
              COUNT(*)
            FROM
              "short_walk"
          ) >= $6
        ORDER BY
          "sort_0" ASC
        LIMIT
          20 OFFSET 0
      ) AS "answered"
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            *
          FROM
            "continued_walk"
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "short_walk"
            ) < $7
            AND (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) >= $8
          ORDER BY
            "sort_0" ASC
          LIMIT
            20 OFFSET 0
        ) AS "continued"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND TRUE
            AND "entities"."entity_key" = ANY(
              ARRAY (
                SELECT
                  "entity_key"
                FROM
                  "candidates"
              )
            )
            AND (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) < $9
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) <= $10
          ORDER BY
            "sort_0" ASC
          LIMIT
            20 OFFSET 0
        ) AS "indexed"
    )
    UNION ALL
    (
      SELECT
        *
      FROM
        (
          SELECT
            "walked".*
          FROM
            (
              SELECT
                "entities"."entity_key",
                "entities"."id" AS "sort_0"
              FROM
                "entities"
              WHERE
                "entities"."created_at" IS NOT NULL
                AND (
                  "entities"."expires_at" IS NULL
                  OR "entities"."expires_at" > NOW()
                )
              ORDER BY
                "sort_0" ASC OFFSET 0
            ) AS "walked"
            INNER JOIN LATERAL (
              SELECT
                1
              WHERE
                EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    "ca"."attribute_name_key" = $11
                    AND (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND "ca"."entity_key" = "walked"."entity_key"
                ) OFFSET 0
            ) AS "kept" ON TRUE
          WHERE
            (
              SELECT
                COUNT(*)
              FROM
                "continued_walk"
            ) < $12
            AND (
              SELECT
                COUNT(*)
              FROM
                "candidates"
            ) > $13
          ORDER BY
            "walked"."sort_0" ASC
          LIMIT
            20 OFFSET 0
        ) AS "walk"
    )
  ) AS "page"
  INNER JOIN LATERAL (
    SELECT
      "e"."entity_key" AS "entity_key",
      "e"."id" AS "id",
      "e"."created_at" AS "entity_created_at",
      "e"."modified_at" AS "entity_modified_at",
      "e"."write_count" AS "entity_write_count",
      "e"."expires_at" AS "entity_expires_at",
      "s"."entity_type_name_keys" AS "entity_type_name_keys",
      "s"."verbatim_scope_paths" AS "verbatim_scope_paths"
    FROM
      "entities" AS "e"
      INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key"
    WHERE
      "e"."entity_key" = "page"."entity_key"
    LIMIT
      1
  ) AS "stored" ON TRUE
ORDER BY
  "page"."sort_0" ASC
1: Int 12
2: Int 12
3: BigUnsigned 20
4: BigUnsigned 4
5: Int 12
6: BigUnsigned 20
7: BigUnsigned 20
8: BigUnsigned 20
9: BigUnsigned 20
10: BigUnsigned 10000
11: Int 12
12: BigUnsigned 20
13: BigUnsigned 10000
