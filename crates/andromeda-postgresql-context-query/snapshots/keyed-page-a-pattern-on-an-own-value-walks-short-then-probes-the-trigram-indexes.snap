SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            (
              CASE
                WHEN (
                  EXISTS (
                    SELECT
                      1
                    FROM
                      "current_attributes" AS "ca"
                    WHERE
                      "ca"."attribute_name_key" = $1
                      AND (
                        "ca"."expires_at" IS NULL
                        OR "ca"."expires_at" > NOW()
                      )
                      AND (
                        (
                          (
                            ((("ca"."value_string") COLLATE "default") ~ $2)
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR (
                            (
                              (("ca"."value_long_text") COLLATE "default") ~ $3
                            )
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR EXISTS (
                            SELECT
                              1
                            FROM
                              jsonb_array_elements(
                                (
                                  CASE
                                    WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object"
                                  END
                                )
                              ) AS "ls"
                            WHERE
                              ("ls"."value" ->> ('@value')) ~ $4
                          )
                        ) IS TRUE
                      )
                      AND "ca"."entity_key" = "walked"."entity_key"
                  )
                ) THEN EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    "ca"."attribute_name_key" = $5
                    AND (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND (
                      (
                        NOT COALESCE(
                          (
                            "ca"."value_string" = $6
                            AND nullif("ca"."value_kind" = (2), FALSE)
                          )
                          OR "ca"."value_uri" = $7
                          OR (
                            "ca"."attribute_kind" <> (6)
                            AND (
                              (
                                (
                                  "ca"."value_object" @> jsonb_build_array($8::text)
                                )
                                OR (
                                  "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $9::text))
                                )
                              )
                              AND EXISTS (
                                SELECT
                                  1
                                FROM
                                  jsonb_array_elements(
                                    (
                                      CASE
                                        WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                                      END
                                    )
                                  ) AS "dm"
                                  LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                                    CASE
                                      WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                                    END
                                  )
                                WHERE
                                  (
                                    CASE
                                      WHEN (
                                        jsonb_typeof(
                                          COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                        ) = ('string')
                                        AND (
                                          NOT COALESCE(
                                            COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                              'https://uri.etsi.org/ngsi-ld/DateTime',
                                              'https://uri.etsi.org/ngsi-ld/Date',
                                              'https://uri.etsi.org/ngsi-ld/Time'
                                            )
                                            OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                              'http://www.w3.org/2001/XMLSchema#decimal',
                                              'http://www.w3.org/2001/XMLSchema#integer',
                                              'http://www.w3.org/2001/XMLSchema#long',
                                              'http://www.w3.org/2001/XMLSchema#int',
                                              'http://www.w3.org/2001/XMLSchema#short',
                                              'http://www.w3.org/2001/XMLSchema#byte',
                                              'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                              'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                              'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                              'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                              'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                              'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                              'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                              'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                              'http://www.w3.org/2001/XMLSchema#float',
                                              'http://www.w3.org/2001/XMLSchema#double'
                                            )
                                            OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                            FALSE
                                          )
                                        )
                                      ) THEN (
                                        COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $10))), FALSE)) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key") AND TRUE ELSE FALSE END) OFFSET 0) AS "kept" ON TRUE ORDER BY "walked"."sort_0" ASC LIMIT 100) , "continued_walk" AS  MATERIALIZED (SELECT * FROM (SELECT * FROM "short_walk" UNION ALL (SELECT * FROM (SELECT "walked".* FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) ORDER BY "sort_0" ASC LIMIT 4000 OFFSET 1000) AS "walked" INNER JOIN LATERAL (SELECT 1 WHERE (CASE WHEN (EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $11 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (((((("ca"."value_string") COLLATE "default") ~ $12) AND nullif("ca"."value_kind" = (2), FALSE)) OR (((("ca"."value_long_text") COLLATE "default") ~ $13) AND nullif("ca"."value_kind" = (2), FALSE)) OR EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object" END)) AS "ls" WHERE ("ls"."value" ->> ('@value')) ~ $14)) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key")) THEN EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $15 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ((NOT COALESCE(("ca"."value_string" = $16 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $17 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($18::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $19::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $20))), FALSE)) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key") AND TRUE ELSE FALSE END) OFFSET 0) AS "kept" ON TRUE WHERE (SELECT COUNT(*) FROM "short_walk") < $21 AND (SELECT COUNT(*) FROM "short_walk") >= $22 ORDER BY "walked"."sort_0" ASC LIMIT 80) AS "walked_on")) AS "walks" ORDER BY "sort_0" ASC LIMIT 100) , "candidates" AS  MATERIALIZED (SELECT "entity_key" FROM (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $23 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (((("ca"."value_string") COLLATE "default") ~ $24) AND nullif("ca"."value_kind" = (2), FALSE)) UNION ALL (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $25 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (((("ca"."value_long_text") COLLATE "default") ~ $26) AND nullif("ca"."value_kind" = (2), FALSE))) UNION ALL (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $27 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ("ca"."attribute_kind" = (5) AND "ca"."value_object" IS NOT NULL) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN ("ca"."attribute_kind" = (5)) THEN "ca"."value_object" END)) AS "ls" WHERE ("ls"."value" ->> ('@value')) ~ $28))) AS "matches" LIMIT 10001) SELECT * FROM (SELECT * FROM "short_walk" WHERE (SELECT COUNT(*) FROM "short_walk") >= $29 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "answered" UNION ALL (SELECT * FROM (SELECT * FROM "continued_walk" WHERE (SELECT COUNT(*) FROM "short_walk") < $30 AND (SELECT COUNT(*) FROM "continued_walk") >= $31 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "continued") UNION ALL (SELECT * FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) AND (EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $32 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (NOT COALESCE(("ca"."value_string" = $33 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $34 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($35::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $36::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $37))), FALSE)) AND "ca"."entity_key" = "entities"."entity_key") AND TRUE) AND "entities"."entity_key" = ANY(ARRAY (SELECT "entity_key" FROM "candidates")) AND (SELECT COUNT(*) FROM "continued_walk") < $38 AND (SELECT COUNT(*) FROM "candidates") <= $39 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "indexed") UNION ALL (SELECT * FROM (SELECT "walked".* FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) ORDER BY "sort_0" ASC OFFSET 0) AS "walked" INNER JOIN LATERAL (SELECT 1 WHERE (CASE WHEN (EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $40 AND ("ca"