source: crates/andromeda-postgresql-context-query/src/attribute_value_order.rs
---
SELECT
  (
    CASE
      WHEN (
        jsonb_typeof(
          COALESCE(
            jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'),
            (
              CASE
                WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"')
              END
            ),
            jsonb_path_query_first(
              "ordered"."value_object",
              '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'
            )
          )
        ) = ('number')
      ) THEN (
        COALESCE(
          jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'),
          (
            CASE
              WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"')
            END
          ),
          jsonb_path_query_first(
            "ordered"."value_object",
            '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'
          )
        ) #>> ('{}'))::numeric END) AS "value_number", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('boolean')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) #>> ('{}'))::boolean END) AS "value_boolean", NULL::timestamptz AS "value_date_time", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('string')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) #>> ('{}'))::text END) AS "value_text", jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@type"') #>> ('{}') AS "value_declared_datatype", (CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) END) AS "value_object", (CASE WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('number')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) #>> ('{}'))::numeric END) IS NOT NULL) THEN 'number' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('boolean')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) #>> ('{}'))::boolean END) IS NOT NULL) THEN 'boolean' WHEN ((NULL::timestamptz) IS NOT NULL) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@type"') #>> ('{}')) = ('https://uri.etsi.org/ngsi-ld/DateTime')) THEN 'https://uri.etsi.org/ngsi-ld/DateTime' WHEN ((jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@type"') #>> ('{}')) = ('https://uri.etsi.org/ngsi-ld/Date')) THEN 'https://uri.etsi.org/ngsi-ld/Date' WHEN ((jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@type"') #>> ('{}')) = ('https://uri.etsi.org/ngsi-ld/Time')) THEN 'https://uri.etsi.org/ngsi-ld/Time' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('string')) THEN (COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) #>> ('{}'))::text END) IS NOT NULL) THEN 'string' WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) = ('null')) THEN 'null' WHEN (jsonb_typeof((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) END)) = ('array') OR ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) END) ? ('@list'))) THEN 'array' WHEN ((CASE WHEN (jsonb_typeof(COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"'))) IN ('object', 'array')) THEN COALESCE(jsonb_path_query_first("ordered"."value_object", '$."city"[*]."@value"'), (CASE WHEN ("ordered"."attribute_kind" = (6)) THEN jsonb_path_query_first("ordered"."value_object", '$."city"') END), jsonb_path_query_first("ordered"."value_object", '$[*] ? (@."@language" like_regex "^[Cc][Ii][Tt][Yy]$")."@value"')) END) IS NOT NULL) THEN 'object' END) AS "value_datatype" FROM (SELECT "ca".* FROM "current_attributes" AS "ca" WHERE "ca"."entity_key" = "entities"."entity_key" AND "ca"."attribute_name_key" = $1 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) ORDER BY "ca"."ordinal" ASC LIMIT 1) AS "ordered"
1: Int 15
