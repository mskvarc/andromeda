---
source: crates/andromeda-postgresql-context-query/src/filter_reads.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "selected"."entity_key",
            "selected"."id" AS "sort_0"
          FROM
            (
              SELECT
                "entity_key",
                "id"
              FROM
                "entity_type_members"
              WHERE
                "entity_type_name_key" = (3)
                AND "is_current_member"
            ) AS "selected"
          WHERE
            "selected"."entity_key" NOT IN (
              SELECT
                "entity_key"
              FROM
                "entities"
              WHERE
                "expires_at" <= NOW()
            )
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000 OFFSET 0
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          FROM
            "entity_search"
          WHERE
            "entity_search"."entity_key" = "walked"."entity_key"
            AND ("entity_search"."scope_paths" ~ ($1::lquery)) OFFSET 0
        ) AS "filtered" ON TRUE
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca_ln1"
                JOIN jsonb_array_elements_text(
                  COALESCE(
                    "ca_ln1"."value_object",
                    jsonb_build_array(
                      COALESCE("ca_ln1"."value_uri", "ca_ln1"."value_long_uri")
                    )
                  )
                ) AS "lo1" ON TRUE
                JOIN "entities" AS "le1" ON "le1"."id" = "lo1"
              WHERE
                "ca_ln1"."entity_key" = "walked"."entity_key"
                AND "ca_ln1"."attribute_name_key" = $2
                AND "ca_ln1"."attribute_kind" IN (2, 8)
                AND (
                  "ca_ln1"."expires_at" IS NULL
                  OR "ca_ln1"."expires_at" > NOW()
                )
                AND (
                  "le1"."created_at" IS NOT NULL
                  AND (
                    "le1"."expires_at" IS NULL
                    OR "le1"."expires_at" > NOW()
                  )
                )
                AND EXISTS (
                  SELECT
                    1
                  FROM
                    "current_attributes" AS "ca"
                  WHERE
                    "ca"."attribute_name_key" = $3
                    AND (
                      "ca"."expires_at" IS NULL
                      OR "ca"."expires_at" > NOW()
                    )
                    AND (
                      (
                        "ca"."value_string" = $4
                        AND nullif("ca"."value_kind" = (2), FALSE)
                      )
                      OR "ca"."value_uri" = $5
                      OR (
                        "ca"."attribute_kind" <> (6)
                        AND (
                          (
                            (
                              "ca"."value_object" @> jsonb_build_array($6::text)
                            )
                            OR (
                              "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $7::text))
                            )
                          )
                          AND EXISTS (
                            SELECT
                              1
                            FROM
                              jsonb_array_elements(
                                (
                                  CASE
                                    WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                                  END
                                )
                              ) AS "dm"
                              LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                                CASE
                                  WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                                END
                              )
                            WHERE
                              (
                                CASE
                                  WHEN (
                                    jsonb_typeof(
                                      COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                    ) = ('string')
                                    AND (
                                      NOT COALESCE(
                                        COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                          'https://uri.etsi.org/ngsi-ld/DateTime',
                                          'https://uri.etsi.org/ngsi-ld/Date',
                                          'https://uri.etsi.org/ngsi-ld/Time'
                                        )
                                        OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                          'http://www.w3.org/2001/XMLSchema#decimal',
                                          'http://www.w3.org/2001/XMLSchema#integer',
                                          'http://www.w3.org/2001/XMLSchema#long',
                                          'http://www.w3.org/2001/XMLSchema#int',
                                          'http://www.w3.org/2001/XMLSchema#short',
                                          'http://www.w3.org/2001/XMLSchema#byte',
                                          'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                          'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                          'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                          'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                          'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                          'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                          'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                          'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                          'http://www.w3.org/2001/XMLSchema#float',
                                          'http://www.w3.org/2001/XMLSchema#double'
                                        )
                                        OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                        FALSE
                                      )
                                    )
                                  ) THEN (
                                    COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $8)))) AND "ca"."entity_key" = "le1"."entity_key")) OFFSET 0) AS "kept" ON TRUE ORDER BY "walked"."sort_0" ASC LIMIT 100) , "candidates" AS  MATERIALIZED (SELECT "entity_search"."entity_key" FROM "entity_search" WHERE "entity_search"."scope_paths" ~ ($9::lquery) LIMIT 10001) , "candidates_2" AS  MATERIALIZED (SELECT "entity_key" FROM (SELECT "ca_ln1"."entity_key" FROM "entities" AS "le1" JOIN "current_attributes" AS "ca_ln1" ON "ca_ln1"."attribute_name_key" = $10 AND "ca_ln1"."value_uri" = "le1"."id" WHERE "ca_ln1"."attribute_kind" IN (2, 8) AND ("ca_ln1"."expires_at" IS NULL OR "ca_ln1"."expires_at" > NOW()) AND ("le1"."created_at" IS NOT NULL AND ("le1"."expires_at" IS NULL OR "le1"."expires_at" > NOW())) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $11 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $12 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $13 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($14::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $15::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $16)))) AND "ca"."entity_key" = "le1"."entity_key") UNION ALL (SELECT "ca_ln1"."entity_key" FROM "entities" AS "le1" JOIN "current_attributes" AS "ca_ln1" ON "ca_ln1"."attribute_name_key" = $17 AND ("ca_ln1"."value_object" @> jsonb_build_array("le1"."id")) WHERE "ca_ln1"."attribute_kind" IN (2, 8) AND ("ca_ln1"."expires_at" IS NULL OR "ca_ln1"."expires_at" > NOW()) AND ("le1"."created_at" IS NOT NULL AND ("le1"."expires_at" IS NULL OR "le1"."expires_at" > NOW())) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $18 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $19 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $20 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($21::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $22::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $23)))) AND "ca"."entity_key" = "le1"."entity_key"))) AS "matches") SELECT * FROM (SELECT * FROM "short_walk" WHERE (SELECT COUNT(*) FROM "short_walk") >= $24 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "answered" UNION ALL (SELECT * FROM (SELECT "selected"."entity_key", "selected"."id" AS "sort_0" FROM (SELECT "entity_key", "id" FROM "entity_type_members" WHERE "entity_type_name_key" = (3) AND "is_current_member") AS "selected" JOIN "entity_search" ON "entity_search"."entity_key" = "selected"."entity_key" WHERE "selected"."entity_key" NOT IN (SELECT "entity_key" FROM "entities" WHERE "expires_at" <= NOW()) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca_ln1" JOIN jsonb_array_elements_text(COALESCE("ca_ln1"."value_object", jsonb_build_array(COALESCE("ca_ln1"."value_uri", "ca_ln1"."value_long_uri")))) AS "lo1" ON TRUE JOIN "entities" AS "le1" ON "le1"."id" = "lo1" WHERE "ca_ln1"."entity_key" = "selected"."entity_key" AND "ca_ln1"."attribute_name_key" = $25 AND "ca_ln1"."attribute_kind" IN (2, 8) AND ("ca_ln1"."expires_at" IS NULL OR "ca_ln1"."expires_at" > NOW()) AND ("le1"."created_at" IS NOT NULL AND ("le1"."expires_at" IS NULL OR "le1"."expires_at" > NOW())) AND EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $26 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND (("ca"."value_string" = $27 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $28 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($29::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $30::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $31)))) AND "ca"."entity_key" = "le1"."entity_key")) AND ("entity_search"."scope_paths" ~ ($32::lquery)) AND "selected"."entity_key" = ANY(ARRAY (SELECT "entity_key" FROM "candidates")) AND (SELECT COUNT(*) FROM "short_walk") < $33 AND (SELECT COUNT(*) FROM "candidates") <= $34 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "indexed") UNION ALL (SELECT * FROM (SELECT "selected"."entity_key", "selected"."id" AS "sort_0" FROM (SELECT "entity_key", "id" FROM "entity_type_members" WHERE "entity_type_name_key" = (3) AND "is_current_member") AS "selected" JOIN "entity_search" ON "entity_search"."entity_key" = "selected"."entity_key" WHERE "selected"."entity_key" NOT IN (SELECT "entity_key" FROM "entities" WHERE "expires_at" <= NOW()) AND TRUE AND ("entity_search"."scope_paths" ~ ($35::lquery)) AND "selected"."entity_key" = ANY(ARRAY (SELECT "entity_key" FROM "candidates_2")) AND (SELECT COUNT(*) FROM "short_walk") < $36 AND (SELECT COUNT(*) FROM "candidates") > $37 ORDER BY "sort_0" ASC LIMIT 100 OFFSET 0) AS "indexed")) AS "page" INNER JOIN LATERAL (SELECT "e"."entity_key" AS "entity_key", "e"."id" AS "id", "e"."created_at" AS "entity_created_at", "e"."modified_at" AS "entity_modified_at", "e"."write_count" AS "entity_write_count", "e"."expires_at" AS "entity_expires_at", "s"."entity_type_name_keys" AS "entity_type_name_keys", "s"."verbatim_scope_paths" AS "verbatim_scope_paths" FROM "entities" AS "e" INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key" WHERE "e"."entity_key" = "page"."entity_key" LIMIT 1) AS "stored" ON TRUE ORDER BY "page"."sort_0" ASC
