---
source: crates/andromeda-postgresql-context-query/src/csr/geometry_parts.rs
---
SELECT
  "id"
FROM
  "context_source_registrations"
WHERE
  "location" IS NOT NULL
  AND (
    (
      COALESCE("location_reach", "location_valid", "location") && ST_MakeEnvelope($1, $2, $3, $4, $5)
    )
    AND _ST_DWithin(
      COALESCE("location_valid", "location")::geography,
      ST_MakeValid(ST_GeomFromEWKB($6))::geography,
      $7
    )
  )
1: Double 0.9954743838616097
2: Double 1.9954771526145392
3: Double 1.0045256161383902
4: Double 2.004522847385461
5: Int 4326
6: Bytes '\x0101000020E6100000000000000000F03F0000000000000040'
7: Double 500
