---
source: crates/andromeda-postgresql-context-query/src/csr/filter.rs
---
SELECT
  "id"
FROM
  "entities"
WHERE
  (
    SELECT
      (
        CASE
          WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
          ELSE "j"
        END
      )
    FROM
      (
        SELECT
          "context_source_properties" -> ('https://example.com/speed') AS "j"
      ) AS "s"
  ) IS NOT NULL
  AND (
    (
      CASE
        WHEN (
          jsonb_typeof(
            (
              SELECT
                (
                  CASE
                    WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
                    ELSE "j"
                  END
                )
              FROM
                (
                  SELECT
                    "context_source_properties" -> ('https://example.com/speed') AS "j"
                ) AS "s"
            )
          ) = ('number')
        ) THEN (
          (
            SELECT
              (
                CASE
                  WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value')
                  ELSE "j"
                END
              )
            FROM
              (
                SELECT
                  "context_source_properties" -> ('https://example.com/speed') AS "j"
              ) AS "s"
          ) #>> ('{}'))::numeric WHEN (jsonb_typeof((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s")) = ('string') AND (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND ((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}')) <> ('NaN') AND pg_input_is_valid((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}'), 'numeric')) THEN ((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}'))::numeric END) >= $1 AND (CASE WHEN (jsonb_typeof((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s")) = ('number')) THEN ((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}'))::numeric WHEN (jsonb_typeof((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s")) = ('string') AND (NULL::text) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') AND ((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}')) <> ('NaN') AND pg_input_is_valid((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}'), 'numeric')) THEN ((SELECT (CASE WHEN (("j" ->> ('type')) = ('Property')) THEN "j" -> ('value') ELSE "j" END) FROM (SELECT "context_source_properties" -> ('https://example.com/speed') AS "j") AS "s") #>> ('{}'))::numeric END) <= $2)
1: BigDecimal 10
2: BigDecimal 20
