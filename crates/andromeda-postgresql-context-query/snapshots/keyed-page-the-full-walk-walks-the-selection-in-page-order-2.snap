---
source: crates/andromeda-postgresql-context-query/src/keyed_page.rs
---
SELECT
  "stored"."entity_key",
  "stored"."id",
  "stored"."entity_created_at",
  "stored"."entity_modified_at",
  "stored"."entity_write_count",
  "stored"."entity_expires_at",
  "stored"."entity_type_name_keys",
  "stored"."verbatim_scope_paths"
FROM
  (
    WITH
    "short_walk" AS MATERIALIZED (
      SELECT
        "walked".*
      FROM
        (
          SELECT
            "entities"."entity_key",
            "entities"."id" AS "sort_0"
          FROM
            "entities"
          WHERE
            "entities"."created_at" IS NOT NULL
            AND (
              "entities"."expires_at" IS NULL
              OR "entities"."expires_at" > NOW()
            )
            AND "entities"."id" > $1
          ORDER BY
            "sort_0" ASC
          LIMIT
            1000
        ) AS "walked"
        INNER JOIN LATERAL (
          SELECT
            1
          WHERE
            EXISTS (
              SELECT
                1
              FROM
                "current_attributes" AS "ca"
              WHERE
                "ca"."attribute_name_key" = $2
                AND (
                  "ca"."expires_at" IS NULL
                  OR "ca"."expires_at" > NOW()
                )
                AND (
                  (
                    (
                      "ca"."value_string" = $3
                      AND nullif("ca"."value_kind" = (2), FALSE)
                    )
                    OR "ca"."value_uri" = $4
                    OR (
                      "ca"."attribute_kind" <> (6)
                      AND (
                        (
                          (
                            "ca"."value_object" @> jsonb_build_array($5::text)
                          )
                          OR (
                            "ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $6::text))
                          )
                        )
                        AND EXISTS (
                          SELECT
                            1
                          FROM
                            jsonb_array_elements(
                              (
                                CASE
                                  WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object"
                                END
                              )
                            ) AS "dm"
                            LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (
                              CASE
                                WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key"
                              END
                            )
                          WHERE
                            (
                              CASE
                                WHEN (
                                  jsonb_typeof(
                                    COALESCE("dm"."value" -> ('@value'), "dm"."value")
                                  ) = ('string')
                                  AND (
                                    NOT COALESCE(
                                      COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                        'https://uri.etsi.org/ngsi-ld/DateTime',
                                        'https://uri.etsi.org/ngsi-ld/Date',
                                        'https://uri.etsi.org/ngsi-ld/Time'
                                      )
                                      OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN (
                                        'http://www.w3.org/2001/XMLSchema#decimal',
                                        'http://www.w3.org/2001/XMLSchema#integer',
                                        'http://www.w3.org/2001/XMLSchema#long',
                                        'http://www.w3.org/2001/XMLSchema#int',
                                        'http://www.w3.org/2001/XMLSchema#short',
                                        'http://www.w3.org/2001/XMLSchema#byte',
                                        'http://www.w3.org/2001/XMLSchema#nonNegativeInteger',
                                        'http://www.w3.org/2001/XMLSchema#positiveInteger',
                                        'http://www.w3.org/2001/XMLSchema#nonPositiveInteger',
                                        'http://www.w3.org/2001/XMLSchema#negativeInteger',
                                        'http://www.w3.org/2001/XMLSchema#unsignedLong',
                                        'http://www.w3.org/2001/XMLSchema#unsignedInt',
                                        'http://www.w3.org/2001/XMLSchema#unsignedShort',
                                        'http://www.w3.org/2001/XMLSchema#unsignedByte',
                                        'http://www.w3.org/2001/XMLSchema#float',
                                        'http://www.w3.org/2001/XMLSchema#double'
                                      )
                                      OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'),
                                      FALSE
                                    )
                                  )
                                ) THEN (
                                  COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $7)))) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key") OFFSET 0) AS "kept" ON TRUE ORDER BY "walked"."sort_0" ASC LIMIT 20) , "candidates" AS  MATERIALIZED (SELECT "entity_key" FROM (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $8 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ("ca"."value_string" = $9 AND nullif("ca"."value_kind" = (2), FALSE)) UNION ALL (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $10 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND "ca"."value_uri" = $11) UNION ALL (SELECT "ca"."entity_key" FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $12 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND "ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($13::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $14::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $15)))) AS "matches" LIMIT 10001) SELECT * FROM (SELECT * FROM "short_walk" WHERE (SELECT COUNT(*) FROM "short_walk") >= $16 ORDER BY "sort_0" ASC LIMIT 20) AS "answered" UNION ALL (SELECT * FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) AND TRUE AND "entities"."entity_key" = ANY(ARRAY (SELECT "entity_key" FROM "candidates")) AND (SELECT COUNT(*) FROM "short_walk") < $17 AND (SELECT COUNT(*) FROM "candidates") <= $18 AND "entities"."id" > $19 ORDER BY "sort_0" ASC LIMIT 20) AS "indexed") UNION ALL (SELECT * FROM (SELECT "walked".* FROM (SELECT "entities"."entity_key", "entities"."id" AS "sort_0" FROM "entities" WHERE "entities"."created_at" IS NOT NULL AND ("entities"."expires_at" IS NULL OR "entities"."expires_at" > NOW()) AND "entities"."id" > $20 ORDER BY "sort_0" ASC OFFSET 0) AS "walked" INNER JOIN LATERAL (SELECT 1 WHERE EXISTS(SELECT 1 FROM "current_attributes" AS "ca" WHERE "ca"."attribute_name_key" = $21 AND ("ca"."expires_at" IS NULL OR "ca"."expires_at" > NOW()) AND ((("ca"."value_string" = $22 AND nullif("ca"."value_kind" = (2), FALSE)) OR "ca"."value_uri" = $23 OR ("ca"."attribute_kind" <> (6) AND ((("ca"."value_object" @> jsonb_build_array($24::text)) OR ("ca"."value_object" @> jsonb_build_array(jsonb_build_object('@value', $25::text)))) AND EXISTS(SELECT 1 FROM jsonb_array_elements((CASE WHEN (jsonb_typeof("ca"."value_object") = ('array')) THEN "ca"."value_object" END)) AS "dm" LEFT JOIN "entity_type_names" AS "dmt" ON "dmt"."entity_type_name_key" = (CASE WHEN ("ca"."attribute_kind" IN (1, 7)) THEN "ca"."value_type_key" END) WHERE (CASE WHEN (jsonb_typeof(COALESCE("dm"."value" -> ('@value'), "dm"."value")) = ('string') AND (NOT COALESCE(COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('https://uri.etsi.org/ngsi-ld/DateTime', 'https://uri.etsi.org/ngsi-ld/Date', 'https://uri.etsi.org/ngsi-ld/Time') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) IN ('http://www.w3.org/2001/XMLSchema#decimal', 'http://www.w3.org/2001/XMLSchema#integer', 'http://www.w3.org/2001/XMLSchema#long', 'http://www.w3.org/2001/XMLSchema#int', 'http://www.w3.org/2001/XMLSchema#short', 'http://www.w3.org/2001/XMLSchema#byte', 'http://www.w3.org/2001/XMLSchema#nonNegativeInteger', 'http://www.w3.org/2001/XMLSchema#positiveInteger', 'http://www.w3.org/2001/XMLSchema#nonPositiveInteger', 'http://www.w3.org/2001/XMLSchema#negativeInteger', 'http://www.w3.org/2001/XMLSchema#unsignedLong', 'http://www.w3.org/2001/XMLSchema#unsignedInt', 'http://www.w3.org/2001/XMLSchema#unsignedShort', 'http://www.w3.org/2001/XMLSchema#unsignedByte', 'http://www.w3.org/2001/XMLSchema#float', 'http://www.w3.org/2001/XMLSchema#double') OR COALESCE("dmt"."name", "dm"."value" ->> ('@type')) = ('http://www.w3.org/2001/XMLSchema#boolean'), FALSE))) THEN (COALESCE("dm"."value" -> ('@value'), "dm"."value") #>> ('{}'))::text END) = $26)))) IS TRUE) AND "ca"."entity_key" = "walked"."entity_key") OFFSET 0) AS "kept" ON TRUE WHERE (SELECT COUNT(*) FROM "short_walk") < $27 AND (SELECT COUNT(*) FROM "candidates") > $28 ORDER BY "walked"."sort_0" ASC LIMIT 20) AS "walk")) AS "page" INNER JOIN LATERAL (SELECT "e"."entity_key" AS "entity_key", "e"."id" AS "id", "e"."created_at" AS "entity_created_at", "e"."modified_at" AS "entity_modified_at", "e"."write_count" AS "entity_write_count", "e"."expires_at" AS "entity_expires_at", "s"."entity_type_name_keys" AS "entity_type_name_keys", "s"."verbatim_scope_paths" AS "verbatim_scope_paths" FROM "entities" AS "e" INNER JOIN "entity_search" AS "s" ON "s"."entity_key" = "e"."entity_key" WHERE "e"."entity_key" = "page"."entity_key" LIMIT 1) AS "stored" ON TRUE ORDER BY "page"."sort_0" ASC
1: String 'urn:ngsi-ld:Building:001'
2: Int 12
3: String 'x'
