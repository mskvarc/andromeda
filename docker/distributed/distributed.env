# Environment for the distributed-operations conformance test harness.
# Copy to distributed.env (gitignored) or `export` before running the suite.
#
# Two URL families per broker:
#   *_URL       — how the TEST CLIENT (running on the host) reaches the broker.
#   *_PEER_URL  — how ANOTHER BROKER reaches it over the compose network; this is the
#                 value that goes into a Context Source Registration `endpoint`.

# --- Broker A (default "front"/distribution broker under test) ---
ANDROMEDA_DIST_A_URL=http://127.0.0.1:1061/ngsi-ld/v1/
ANDROMEDA_DIST_A_PEER_URL=http://broker-a:1056
ANDROMEDA_DIST_A_ALIAS=broker-a

# --- Broker B (peer / context source) ---
ANDROMEDA_DIST_B_URL=http://127.0.0.1:1062/ngsi-ld/v1/
ANDROMEDA_DIST_B_PEER_URL=http://broker-b:1056
ANDROMEDA_DIST_B_ALIAS=broker-b

# --- Broker C (peer / context source, for redirect fan-out and A->B->C chains) ---
ANDROMEDA_DIST_C_URL=http://127.0.0.1:1063/ngsi-ld/v1/
ANDROMEDA_DIST_C_PEER_URL=http://broker-c:1056
ANDROMEDA_DIST_C_ALIAS=broker-c

# Shared Postgres (per-broker databases created by initdb). The test harness
# reclaims each broker's prefix-owned rows on teardown, so it needs to reach the
# per-broker database directly. By default it derives the per-broker URL from
# ANDROMEDA_DIST_DATABASE_URL by swapping the path to broker_a / broker_b /
# broker_c. Set the explicit ANDROMEDA_DIST_<R>_DATABASE_URL overrides below only
# when a broker's database is not reachable by that derivation.
ANDROMEDA_DIST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5442/postgres
# ANDROMEDA_DIST_A_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/broker_a
# ANDROMEDA_DIST_B_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/broker_b
# ANDROMEDA_DIST_C_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/broker_c

# Host that the brokers use to call mock Context Sources / notification receivers
# started inside the test process. host.docker.internal on Docker Desktop; on Linux
# the compose file maps it via host-gateway.
ANDROMEDA_TEST_CALLBACK_HOST=host.docker.internal
