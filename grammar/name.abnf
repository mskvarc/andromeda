; NGSI-LD Name (ETSI GS CIM 009 v1.9.1, section 4.6.2).
;
; Spec:
;   name   = unicodeLetter *nameChar
;   name  =/ prefix ":" unicodeLetter *nameChar
;   prefix = unicodeLetter *nameChar
;
; Expressed as a regular language: a name body optionally followed by
; a colon-separated second body.

Name     = nameBody [":" nameBody]
nameBody = unicodeLetter *nameChar
nameChar = unicodeNumber / unicodeLetter / %x5F   ; _ (underscore)
