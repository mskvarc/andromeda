ANDROMEDA_TEST_SUITE__BROKERS__FRONT=http://broker:1056
ANDROMEDA_TEST_SUITE__CORE_CONTEXT=https://uri.etsi.org/ngsi-ld/v1/ngsi-ld-core-context-v1.9.jsonld
ANDROMEDA_TEST_SUITE__UNREACHABLE_ORIGIN=http://postgres:1
ANDROMEDA_TEST_SUITE__MQTT__HOST=mosquitto
ANDROMEDA_TEST_SUITE__MQTT__AUTH_HOST=mosquitto-auth
ANDROMEDA_TEST_SUITE__MQTT__NON_DEFAULT_PORT=8085
ANDROMEDA_TEST_SUITE__MQTT__OBSERVER_PORT=1880
ANDROMEDA_TEST_SUITE__BUDGETS__REQUEST_VALUE=4000000
ANDROMEDA_TEST_SUITE__BUDGETS__ENTITY_VALUE=1000000
ANDROMEDA_TEST_SUITE__BUDGETS__POSITION=100000
ANDROMEDA_TEST_SUITE__BUDGETS__MAX_REQUEST_BODY=67108864
# A test of several hundred requests polls one future whose frame holds every request temporaries in an unoptimised build; 32 MiB keeps the longest sequences off the end of the default 2 MiB test-thread stack.
RUST_MIN_STACK=33554432
