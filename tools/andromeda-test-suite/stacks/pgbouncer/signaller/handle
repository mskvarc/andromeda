#!/bin/sh
# Answers one request of the signaller: sends SIGTERM to the container of broker-dormant-live or starts it again.
read -r _ target _ || exit 0
while read -r header; do
  [ "$header" = "$(printf '\r')" ] && break
  [ -z "$header" ] && break
done
# The broker of this signaller's own Compose project, whatever the project is named.
project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$(hostname)")
container=$(docker ps -aq --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.service=broker-dormant-live)
# A container still draining after SIGTERM is running, and starting a running container does nothing.
wait_stopped() {
  for _ in $(seq 1 240); do
    [ "$(docker inspect --format '{{.State.Running}}' "$container")" = false ] && return 0
    sleep 0.5
  done
  echo "the container did not stop"
  return 1
}
status='200 OK'
case "$target" in
  /terminate-dormant-live) body=$(docker kill --signal TERM "$container" 2>&1) || status='500 Internal Server Error' ;;
  /start-dormant-live) body=$(wait_stopped && docker start "$container" 2>&1) || status='500 Internal Server Error' ;;
  *) printf 'HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n'; exit 0 ;;
esac
printf 'HTTP/1.1 %s\r\nContent-Type: text/plain\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "$status" "${#body}" "$body"
