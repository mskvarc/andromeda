ANDROMEDA_TEST_SUITE__UNREACHABLE_ORIGIN=http://postgres:1
# A test of several hundred requests polls one future whose frame holds every request's temporaries in an unoptimised build; 32 MiB keeps the longest sequences off the end of the default 2 MiB test-thread stack.
RUST_MIN_STACK=33554432
# A scale test provisions this many tenants, three times the runtime cache of 32 its broker keeps, and drives each load run for this many seconds.
ANDROMEDA_TEST_SUITE__POOLING__SCALE_TENANTS=96
ANDROMEDA_TEST_SUITE__POOLING__LOAD_SECONDS=60
